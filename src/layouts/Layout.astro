---
import '../styles/global.css';
import Toast from '../components/common/Toast.astro';
import CookieBanner from '../components/CookieBanner.astro';
import SEO from '../components/common/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "KazeChronik", 
  description = "Organiza tu colección de videojuegos, lleva el control de tu progreso, estadísticas y bitácora en tiempo real con KazeChronik.",
  image = "/og-image.jpg" 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" data-theme="legacy">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO Técnico, Open Graph y Twitter Meta Tags -->
    <SEO title={title} description={description} image={image} />

    <!-- Soporte PWA / Web App Instalable -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#4f46e5" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="KazeChronik" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Script Inline Inmediato (Previene Flash de Tema) -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme') || 'legacy';
      document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
  </head>
  <body class="min-h-screen bg-theme-bg text-theme-text transition-colors duration-200 flex flex-col font-sans antialiased">
    <slot />
    <Toast />
    <CookieBanner />

    <!-- Registro de Service Worker para PWA -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.error('Error al registrar ServiceWorker PWA:', err);
          });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* Variables de Color por Tema */
  :root[data-theme="legacy"] {
    --bg-main: #0a0f1d;
    --bg-card: #0f172a;
    --border-card: #1e293b;
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --bg-input: #020617;
    --border-input: #1e293b;
    --bg-button: #1e293b;
    --text-button: #cbd5e1;
  }

  :root[data-theme="dark"] {
    --bg-main: #030712;
    --bg-card: #111827;
    --border-card: #1f2937;
    --text-primary: #f9fafb;
    --text-secondary: #9ca3af;
    --bg-input: #000000;
    --border-input: #1f2937;
    --bg-button: #1f2937;
    --text-button: #e5e7eb;
  }

  :root[data-theme="light"] {
    --bg-main: #f8fafc;
    --bg-card: #ffffff;
    --border-card: #e2e8f0;
    --text-primary: #0f172a;
    --text-secondary: #64748b;
    --bg-input: #ffffff;
    --border-input: #cbd5e1;
    --bg-button: #e2e8f0;
    --text-button: #334155;
  }

  /* Aplicación de clases utilitarias de tema */
  body {
    background-color: var(--bg-main);
    color: var(--text-primary);
  }

  .theme-card {
    background-color: var(--bg-card) !important;
    border-color: var(--border-card) !important;
  }

  .theme-text-primary {
    color: var(--text-primary) !important;
  }

  .theme-text-secondary {
    color: var(--text-secondary) !important;
  }

  .theme-input {
    background-color: var(--bg-input) !important;
    border-color: var(--border-input) !important;
    color: var(--text-primary) !important;
  }

  .theme-button {
    background-color: var(--bg-button) !important;
    color: var(--text-button) !important;
  }
</style>
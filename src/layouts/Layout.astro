---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="legacy">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="GameTracker - Gestiona tu biblioteca personal de videojuegos" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | GameTracker</title>

    <!-- Script Inline Inmediato (Previene Flash de Tema) -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme') || 'legacy';
      document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
  </head>
  <body class="min-h-screen bg-theme-bg text-theme-text transition-colors duration-200 flex flex-col font-sans antialiased">
    <slot />
  </body>
</html>

<style is:global>
  /* Definición de Variables de Color según el Tema */
  :root[data-theme="legacy"] {
    --bg-main: #0a0f1d;
    --text-main: #f8fafc;
  }

  :root[data-theme="dark"] {
    --bg-main: #000000;
    --text-main: #f3f4f6;
  }

  :root[data-theme="light"] {
    --bg-main: #f8fafc;
    --text-main: #0f172a;
  }

  /* Estilos para soportar los colores de las variables */
  .bg-theme-bg {
    background-color: var(--bg-main);
  }
  
  .text-theme-text {
    color: var(--text-main);
  }
</style>
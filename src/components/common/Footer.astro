---
import { Heart, Sparkles, Bot } from 'lucide-astro';
---

<footer class="w-full border-t border-slate-500/10 py-6 px-4 mt-auto theme-text-secondary text-xs">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
    
    <!-- Texto de Autoría y Reconocimiento de IA -->
    <div class="flex items-center gap-1.5 flex-wrap justify-center sm:justify-start">
      <span>© 2026 <strong class="theme-text-primary">KazeChronik</strong>.</span>
      <span class="hidden sm:inline">•</span>
      <span class="flex items-center gap-1">
        Desarrollado por <strong class="theme-text-primary">AngelisTenji</strong>
      </span>
      <span class="hidden sm:inline">•</span>
      <span class="flex items-center gap-1 text-sky-400 font-semibold" title="Desarrollado con la asistencia técnica de Gemini AI">
        <Bot class="w-3.5 h-3.5" />
        <span>Asistido por Gemini AI</span>
      </span>
    </div>

    <!-- Enlaces Legales y Créditos -->
    <nav class="flex items-center gap-4 text-[11px] font-medium">
      <a href="/gracias" class="hover:text-indigo-400 transition-colors flex items-center gap-1">
        <Sparkles class="w-3 h-3 text-indigo-400" />
        <span>Créditos</span>
      </a>
      <a href="/terminos" class="hover:theme-text-primary transition-colors">Términos</a>
      <a href="/privacidad" class="hover:theme-text-primary transition-colors">Privacidad</a>
    </nav>

  </div>
</footer>
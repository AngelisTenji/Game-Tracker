---
import { CheckCircle2, AlertCircle, X } from 'lucide-astro';
---

<div
  id="toast-container"
  class="fixed bottom-5 right-5 z-[9999] flex flex-col gap-2.5 pointer-events-none"
></div>

<script>
  function createToast(message: string, type: 'success' | 'error' = 'success') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border shadow-2xl transition-all duration-300 transform translate-y-6 opacity-0 text-xs font-semibold ${
      type === 'success'
        ? 'bg-slate-900 border-emerald-500/40 text-emerald-400 shadow-emerald-500/10'
        : 'bg-slate-900 border-rose-500/40 text-rose-400 shadow-rose-500/10'
    }`;

    toast.innerHTML = `
      <span class="shrink-0 text-base leading-none">
        ${type === 'success' ? '✓' : '✕'}
      </span>
      <span class="text-slate-200 font-medium">${message}</span>
      <button type="button" class="toast-close ml-2 text-slate-500 hover:text-white transition-colors cursor-pointer text-sm">
        ✕
      </button>
    `;

    container.appendChild(toast);

    // Forzar reflow para asegurar animación de entrada
    requestAnimationFrame(() => {
      toast.classList.remove('translate-y-6', 'opacity-0');
    });

    const closeBtn = toast.querySelector('.toast-close');
    closeBtn?.addEventListener('click', () => dismissToast(toast));

    setTimeout(() => {
      dismissToast(toast);
    }, 3500);
  }

  function dismissToast(toast: HTMLElement) {
    toast.classList.add('translate-y-4', 'opacity-0');
    setTimeout(() => {
      toast.remove();
    }, 300);
  }

  // Registrar en window de forma inmediata
  (window as any).showToast = createToast;
</script>
---
import { Gamepad2, Search, Library, LogOut } from 'lucide-astro';
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-slate-900/80 border-b border-slate-800 px-4 lg:px-8 py-3">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 font-bold text-xl text-indigo-400 hover:text-indigo-300 transition-colors">
      <Gamepad2 class="w-7 h-7" />
      <span class="tracking-tight text-white">Game<span class="text-indigo-500">Tracker</span></span>
    </a>

    <!-- Menú de Navegación -->
    <nav class="flex items-center gap-6">
      <a href="/dashboard" class="flex items-center gap-2 text-sm font-medium text-slate-300 hover:text-white transition-colors">
        <Library class="w-4 h-4 text-indigo-400" />
        <span>Mi Biblioteca</span>
      </a>
      <a href="/search" class="flex items-center gap-2 text-sm font-medium text-slate-300 hover:text-white transition-colors">
        <Search class="w-4 h-4 text-indigo-400" />
        <span>Buscar</span>
      </a>
    </nav>

    <!-- Estado de Usuario -->
    <div class="flex items-center gap-3">
      <a href="/login" class="text-xs font-semibold px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white transition-all shadow-lg shadow-indigo-500/20">
        Iniciar Sesión
      </a>
      <button id="nav-logout-btn" class="hidden text-xs font-semibold px-3 py-2 rounded-lg bg-slate-800 hover:bg-red-600/20 hover:text-red-400 text-slate-300 transition-all flex items-center gap-1.5 cursor-pointer">
        <LogOut class="w-3.5 h-3.5" />
        <span>Salir</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { supabase } from '../../lib/supabase';

  async function checkUserSession() {
    const loginBtn = document.getElementById('nav-login-btn');
    const logoutBtn = document.getElementById('nav-logout-btn');

    const { data: { session } } = await supabase.auth.getSession();

    if (session) {
      loginBtn?.classList.add('hidden');
      logoutBtn?.classList.remove('hidden');
    } else {
      loginBtn?.classList.remove('hidden');
      logoutBtn?.classList.add('hidden');
    }

    logoutBtn?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/login';
    });
  }

  checkUserSession();
</script>
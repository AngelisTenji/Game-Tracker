---
import { Library, Search, Settings, BarChart2, BookOpen, User, LogOut, WifiOff, Target, FolderHeart, ChevronDown } from 'lucide-astro';
---

<header class="theme-card border-b sticky top-0 z-40 backdrop-blur-md bg-opacity-80">
  <!-- Se remueve 'overflow-hidden' de este div para evitar recortar el modal flotante -->
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-2">
    <!-- Logotipo e Isotipo KazeChronik -->
    <a href="/dashboard" class="flex items-center gap-2.5 group shrink-0">
      <div class="p-1.5 bg-sky-500/10 border border-sky-500/20 rounded-xl group-hover:border-sky-500/40 transition-all">
        <svg class="w-8 h-8 sm:w-10 sm:h-10 text-sky-400" viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M 120 220 C 110 260 120 310 145 330 C 165 345 185 330 200 300 C 210 280 220 260 230 250 L 230 180 C 180 175 130 190 120 220 Z" stroke="currentColor" stroke-width="24" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M 230 180 L 340 180 C 355 180 365 190 365 205 L 365 260 C 365 275 355 285 340 285 L 280 285" stroke="currentColor" stroke-width="24" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="80" y1="410" x2="425" y2="131" stroke="currentColor" stroke-width="26" stroke-linecap="round"/>
          <path d="M 120 425 Q 220 375 365 200" stroke="currentColor" stroke-width="20" stroke-linecap="round"/>
          <path d="M 170 435 Q 260 380 370 230" stroke="currentColor" stroke-width="16" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="text-base sm:text-lg font-black tracking-wider theme-text-primary">
        KAZE<span class="text-sky-400">CHRONIK</span>
      </span>
    </a>

    <!-- Badge Flotante de Estado Offline -->
    <div id="offline-badge" class="hidden items-center gap-1.5 px-3 py-1 bg-amber-500/10 border border-amber-500/30 text-amber-400 rounded-full text-xs font-semibold animate-pulse shrink-0">
      <WifiOff class="w-3.5 h-3.5" />
      <span class="hidden sm:inline">Sin conexión - Modo Lectura</span>
    </div>

    <!-- Menú de Navegación Esencial -->
    <div class="flex items-center gap-2">
      <nav class="flex items-center gap-1">
        <a
          href="/dashboard"
          class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-bold theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors"
          title="Biblioteca"
        >
          <Library class="w-4 h-4 text-sky-400" />
          <span class="hidden sm:inline">Biblioteca</span>
        </a>

        <a
          href="/search"
          class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-bold theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors"
          title="Buscar"
        >
          <Search class="w-4 h-4 text-indigo-400" />
          <span class="hidden sm:inline">Buscar</span>
        </a>
      </nav>

      <!-- Botón de Avatar con Menú Desplegable -->
      <div class="relative shrink-0 ml-1 z-50">
        <button
          id="profile-menu-trigger"
          type="button"
          class="flex items-center gap-1.5 p-1 pl-1.5 pr-2 rounded-full border border-slate-500/20 hover:border-sky-500/40 theme-card transition-all cursor-pointer group"
          title="Menú de perfil"
        >
          <div id="nav-avatar-box" class="w-7 h-7 rounded-full bg-sky-500/10 border border-sky-500/30 flex items-center justify-center overflow-hidden shrink-0">
            <User class="w-4 h-4 text-sky-400" />
          </div>
          <ChevronDown class="w-3.5 h-3.5 theme-text-secondary group-hover:theme-text-primary transition-transform duration-200" id="menu-arrow" />
        </button>

        <!-- POP-OVER / MENÚ DESPLEGABLE DE PERFIL -->
        <div
          id="profile-dropdown-menu"
          class="hidden absolute right-0 mt-2 w-60 theme-card border rounded-2xl shadow-2xl p-2 z-50 space-y-1 backdrop-blur-xl animate-in fade-in zoom-in-95 duration-150"
        >
          <!-- Encabezado de Usuario -->
          <div class="p-2.5 border-b border-slate-500/20 mb-1 space-y-0.5">
            <p id="nav-user-name" class="font-bold text-xs theme-text-primary truncate">Cargando...</p>
            <p id="nav-user-handle" class="text-[11px] theme-text-secondary truncate">@usuario</p>
          </div>

          <!-- Opciones Secundarias -->
          <div class="space-y-0.5 text-xs font-semibold">
            <a
              id="nav-profile-link"
              href="/settings"
              class="flex items-center gap-2.5 px-3 py-2 rounded-xl theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors"
            >
              <User class="w-4 h-4 text-amber-400" />
              <span>Mi Perfil Público</span>
            </a>

            <a
              href="/goals"
              class="flex items-center gap-2.5 px-3 py-2 rounded-xl theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors"
            >
              <Target class="w-4 h-4 text-amber-400" />
              <span>Metas Anuales</span>
            </a>

            <a
              href="/lists"
              class="flex items-center gap-2.5 px-3 py-2 rounded-xl theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors"
            >
              <FolderHeart class="w-4 h-4 text-emerald-400" />
              <span>Listas Personalizadas</span>
            </a>

            <a
              href="/analytics"
              class="flex items-center gap-2.5 px-3 py-2 rounded-xl theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors"
            >
              <BarChart2 class="w-4 h-4 text-indigo-400" />
              <span>Estadísticas</span>
            </a>

            <a
              href="/reviews"
              class="flex items-center gap-2.5 px-3 py-2 rounded-xl theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors"
            >
              <BookOpen class="w-4 h-4 text-purple-400" />
              <span>Reseñas de Comunidad</span>
            </a>
          </div>

          <!-- Pie de Menú (Ajustes y Logout) -->
          <div class="border-t border-slate-500/20 pt-1 mt-1 space-y-0.5 text-xs font-semibold">
            <a
              href="/settings"
              class="flex items-center gap-2.5 px-3 py-2 rounded-xl theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors"
            >
              <Settings class="w-4 h-4 text-emerald-400" />
              <span>Ajustes</span>
            </a>

            <button
              id="logout-btn"
              type="button"
              class="w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-rose-400 hover:bg-rose-500/10 transition-colors text-left cursor-pointer"
            >
              <LogOut class="w-4 h-4" />
              <span>Cerrar Sesión</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { supabase } from '../../lib/supabase';

  async function initNavbar() {
    const trigger = document.getElementById('profile-menu-trigger');
    const dropdown = document.getElementById('profile-dropdown-menu');
    const arrow = document.getElementById('menu-arrow');
    const logoutBtn = document.getElementById('logout-btn');
    const profileLink = document.getElementById('nav-profile-link') as HTMLAnchorElement;
    const offlineBadge = document.getElementById('offline-badge');

    // Manejo de apertura / cierre del desplegable
    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdown?.classList.toggle('hidden');
      arrow?.classList.toggle('rotate-180');
    });

    window.addEventListener('click', (e) => {
      if (!dropdown?.contains(e.target as Node) && !trigger?.contains(e.target as Node)) {
        dropdown?.classList.add('hidden');
        arrow?.classList.remove('rotate-180');
      }
    });

    // Detección de Estado de Red (Online / Offline)
    function updateNetworkStatus() {
      if (navigator.onLine) {
        offlineBadge?.classList.add('hidden');
        offlineBadge?.classList.remove('flex');
      } else {
        offlineBadge?.classList.remove('hidden');
        offlineBadge?.classList.add('flex');
      }
    }

    window.addEventListener('online', updateNetworkStatus);
    window.addEventListener('offline', updateNetworkStatus);
    updateNetworkStatus();

    // Obtención de datos del perfil e imagen de avatar
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session) {
        const { data: profile } = await supabase
          .from('profiles')
          .select('username, display_name, avatar_url')
          .eq('id', session.user.id)
          .maybeSingle();

        const nameEl = document.getElementById('nav-user-name');
        const handleEl = document.getElementById('nav-user-handle');
        const avatarBox = document.getElementById('nav-avatar-box');

        const displayName = profile?.display_name || profile?.username || session.user.email?.split('@')[0] || 'Jugador';
        const username = profile?.username ? `@${profile.username}` : session.user.email;

        if (nameEl) nameEl.textContent = displayName;
        if (handleEl) handleEl.textContent = username || '';

        if (profile?.username && profileLink) {
          profileLink.href = `/u/${profile.username}`;
        }

        if (profile?.avatar_url && avatarBox) {
          avatarBox.innerHTML = `<img src="${profile.avatar_url}" alt="${displayName}" class="w-full h-full object-cover" />`;
        }
      }
    } catch (err) {
      console.log('Modo offline activo: utilizando enlaces locales de respaldo.');
    }

    // Cierre de Sesión
    logoutBtn?.addEventListener('click', async () => {
      logoutBtn.setAttribute('disabled', 'true');
      
      const { error } = await supabase.auth.signOut();

      if (!error) {
        window.location.href = '/login';
      } else {
        alert('Error al cerrar sesión: ' + error.message);
        logoutBtn.removeAttribute('disabled');
      }
    });
  }

  initNavbar();
  document.addEventListener('astro:page-load', initNavbar);
</script>
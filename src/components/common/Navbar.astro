---
import { Library, Search, Settings, BarChart2, BookOpen, User, LogOut } from 'lucide-astro';
---

<header class="theme-card border-b sticky top-0 z-40 backdrop-blur-md bg-opacity-80">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-2 overflow-hidden">
    <!-- Logotipo e Isotipo KazeChronik -->
    <a href="/dashboard" class="flex items-center gap-2.5 group shrink-0">
      <div class="p-1.5 bg-sky-500/10 border border-sky-500/20 rounded-xl group-hover:border-sky-500/40 transition-all">
        <svg class="w-8 h-8 sm:w-10 sm:h-10 text-sky-400" viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M 120 220 C 110 260 120 310 145 330 C 165 345 185 330 200 300 C 210 280 220 260 230 250 L 230 180 C 180 175 130 190 120 220 Z" stroke="currentColor" stroke-width="24" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M 230 180 L 340 180 C 355 180 365 190 365 205 L 365 260 C 365 275 355 285 340 285 L 280 285" stroke="currentColor" stroke-width="24" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="80" y1="410" x2="425" y2="131" stroke="currentColor" stroke-width="26" stroke-linecap="round"/>
          <path d="M 120 425 Q 220 375 365 200" stroke="currentColor" stroke-width="20" stroke-linecap="round"/>
          <path d="M 170 435 Q 260 380 370 230" stroke="currentColor" stroke-width="16" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="text-base sm:text-lg font-black tracking-wider theme-text-primary">
        KAZE<span class="text-sky-400">CHRONIK</span>
      </span>
    </a>

    <!-- Menú de Navegación Adaptativo -->
    <nav class="flex items-center gap-1 sm:gap-1.5 overflow-x-auto no-scrollbar py-1">
      <a
        href="/dashboard"
        class="flex items-center gap-2 px-2.5 py-2 rounded-xl text-xs font-semibold theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors shrink-0"
        title="Biblioteca"
      >
        <Library class="w-4 h-4 text-sky-400" />
        <span class="hidden md:inline">Biblioteca</span>
      </a>

      <a
        href="/search"
        class="flex items-center gap-2 px-2.5 py-2 rounded-xl text-xs font-semibold theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors shrink-0"
        title="Buscar"
      >
        <Search class="w-4 h-4 text-indigo-400" />
        <span class="hidden md:inline">Buscar</span>
      </a>

      <a
        id="nav-profile-link"
        href="/settings"
        class="flex items-center gap-2 px-2.5 py-2 rounded-xl text-xs font-semibold theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors group shrink-0"
        title="Mi Perfil Público"
      >
        <User class="w-4 h-4 text-amber-400 group-hover:scale-110 transition-transform" />
        <span class="hidden md:inline">Perfil</span>
      </a>

      <a
        href="/analytics" 
        class="flex items-center gap-2 px-2.5 py-2 rounded-xl text-xs font-semibold theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors group shrink-0"
        title="Estadísticas"
      >
        <BarChart2 class="w-4 h-4 text-indigo-400 group-hover:scale-110 transition-transform" />
        <span class="hidden md:inline">Estadísticas</span>
      </a>

      <a
        href="/reviews"
        class="flex items-center gap-2 px-2.5 py-2 rounded-xl text-xs font-semibold theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors group shrink-0"
        title="Reseñas"
      >
        <BookOpen class="w-4 h-4 text-indigo-400 group-hover:scale-110 transition-transform" />
        <span class="hidden md:inline">Reseñas</span>
      </a>

      <a
        href="/settings"
        class="flex items-center gap-2 px-2.5 py-2 rounded-xl text-xs font-semibold theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors shrink-0"
        title="Ajustes"
      >
        <Settings class="w-4 h-4 text-emerald-400" />
        <span class="hidden md:inline">Ajustes</span>
      </a>

      <!-- Botón Cierre de Sesión -->
      <button
        id="logout-btn"
        type="button"
        class="flex items-center gap-2 px-2.5 py-2 rounded-xl text-xs font-semibold text-rose-400 hover:bg-rose-500/10 transition-colors cursor-pointer shrink-0 ml-1"
        title="Cerrar sesión"
      >
        <LogOut class="w-4 h-4" />
        <span class="hidden md:inline">Salir</span>
      </button>
    </nav>
  </div>
</header>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  async function initNavbar() {
    const logoutBtn = document.getElementById('logout-btn');
    const profileLink = document.getElementById('nav-profile-link') as HTMLAnchorElement;

    // Configurar enlace dinámico al perfil público del usuario en PWA
    const { data: { session } } = await supabase.auth.getSession();
    if (session && profileLink) {
      const { data: profile } = await supabase
        .from('profiles')
        .select('username')
        .eq('id', session.user.id)
        .maybeSingle();

      if (profile?.username) {
        profileLink.href = `/u/${profile.username}`;
      }
    }

    logoutBtn?.addEventListener('click', async () => {
      logoutBtn.setAttribute('disabled', 'true');
      
      const { error } = await supabase.auth.signOut();

      if (!error) {
        window.location.href = '/login';
      } else {
        alert('Error al cerrar sesión: ' + error.message);
        logoutBtn.removeAttribute('disabled');
      }
    });
  }

  initNavbar();
  document.addEventListener('astro:page-load', initNavbar);
</script>
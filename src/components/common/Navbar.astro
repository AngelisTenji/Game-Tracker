---
import { Library, Search, Settings, LogOut, User } from 'lucide-astro';
---

<header class="theme-card border-b sticky top-0 z-40 backdrop-blur-md bg-opacity-80">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logotipo e Isotipo KazeChronik -->
    <a href="/dashboard" class="flex items-center gap-2.5 group">
      <div class="p-1.5 bg-sky-500/10 border border-sky-500/20 rounded-xl group-hover:border-sky-500/40 transition-all">
        <svg class="w-10 h-10 text-sky-400" viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Contorno Mando -->
          <path d="M 120 220 C 110 260 120 310 145 330 C 165 345 185 330 200 300 C 210 280 220 260 230 250 L 230 180 C 180 175 130 190 120 220 Z" stroke="currentColor" stroke-width="24" stroke-linecap="round" stroke-linejoin="round"/>
          <!-- Contorno Teclado -->
          <path d="M 230 180 L 340 180 C 355 180 365 190 365 205 L 365 260 C 365 275 355 285 340 285 L 280 285" stroke="currentColor" stroke-width="24" stroke-linecap="round" stroke-linejoin="round"/>
          <!-- Katana Diagonal -->
          <line x1="80" y1="410" x2="425" y2="131" stroke="currentColor" stroke-width="26" stroke-linecap="round"/>
          <!-- Ráfagas de Viento (Kaze) -->
          <path d="M 120 425 Q 220 375 365 200" stroke="currentColor" stroke-width="20" stroke-linecap="round"/>
          <path d="M 170 435 Q 260 380 370 230" stroke="currentColor" stroke-width="16" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="text-lg font-black tracking-wider theme-text-primary">
        KAZE<span class="text-sky-400">CHRONIK</span>
      </span>
    </a>

    <!-- Menú de Navegación -->
    <nav class="flex items-center gap-1 sm:gap-2">
      <a
        href="/dashboard"
        class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors"
      >
        <Library class="w-4 h-4 text-sky-400" />
        <span class="hidden sm:inline">Biblioteca</span>
      </a>

      <a
        href="/search"
        class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors"
      >
        <Search class="w-4 h-4 text-indigo-400" />
        <span class="hidden sm:inline">Buscar</span>
      </a>

      <a
        href="/settings"
        class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold theme-text-secondary hover:theme-text-primary hover:bg-slate-500/10 transition-colors"
      >
        <Settings class="w-4 h-4 text-emerald-400" />
        <span class="hidden sm:inline">Ajustes</span>
      </a>

      <!-- Botón Cierre de Sesión -->
      <button
        id="logout-btn"
        class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold text-rose-400 hover:bg-rose-500/10 transition-colors cursor-pointer ml-2"
        title="Cerrar sesión"
      >
        <LogOut class="w-4 h-4" />
        <span class="hidden sm:inline">Salir</span>
      </button>
    </nav>
  </div>
</header>

<script>
  import { supabase } from '../../lib/supabase';

  async function checkUserSession() {
    const loginBtn = document.getElementById('nav-login-btn');
    const logoutBtn = document.getElementById('nav-logout-btn');

    const { data: { session } } = await supabase.auth.getSession();

    if (session) {
      loginBtn?.classList.add('hidden');
      logoutBtn?.classList.remove('hidden');
    } else {
      loginBtn?.classList.remove('hidden');
      logoutBtn?.classList.add('hidden');
    }

    logoutBtn?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/login';
    });
  }

  checkUserSession();
</script>
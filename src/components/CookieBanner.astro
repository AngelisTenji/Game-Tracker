<div id="cookie-banner" class="fixed bottom-4 right-4 max-w-sm bg-slate-900 border border-slate-800 p-5 rounded-xl shadow-2xl z-50 hidden">
  <p class="text-sm text-slate-300 mb-4">
    Utilizamos cookies mínimas para gestionar tu sesión de usuario y garantizar el correcto funcionamiento de KazeChronik.
  </p>
  <div class="flex justify-end gap-3">
    <button id="accept-cookies" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition-colors">
      Aceptar
    </button>
  </div>
</div>

<script>
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('accept-cookies');

  if (!localStorage.getItem('cookies-accepted')) {
    banner?.classList.remove('hidden');
  }

  acceptBtn?.addEventListener('click', () => {
    localStorage.setItem('cookies-accepted', 'true');
    banner?.classList.add('hidden');
  });
</script>
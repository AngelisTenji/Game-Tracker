---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import { Gamepad2, Clock, Trophy, Plus, Library } from 'lucide-astro';
---

<Layout title="Mi Biblioteca">
  <Navbar />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-8">
    <!-- Encabezado del Dashboard -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-bold text-white tracking-tight">Mi Biblioteca</h1>
        <p class="text-sm text-slate-400 mt-1">Gestiona tus títulos, progreso y estadísticas</p>
      </div>

      <a
        href="/search"
        class="flex items-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl transition-all shadow-lg shadow-indigo-500/20"
      >
        <Plus class="w-4 h-4" />
        <span>Agregar Juego</span>
      </a>
    </div>

    <!-- Tarjetas de Métricas Rápidas -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
      <div class="bg-slate-900/80 border border-slate-800 p-5 rounded-2xl flex items-center gap-4">
        <div class="p-3 bg-indigo-500/10 border border-indigo-500/20 rounded-xl text-indigo-400">
          <Library class="w-6 h-6" />
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Juegos</p>
          <p id="stat-total" class="text-2xl font-bold text-white mt-0.5">0</p>
        </div>
      </div>

      <div class="bg-slate-900/80 border border-slate-800 p-5 rounded-2xl flex items-center gap-4">
        <div class="p-3 bg-cyan-500/10 border border-cyan-500/20 rounded-xl text-cyan-400">
          <Clock class="w-6 h-6" />
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Horas Totales</p>
          <p id="stat-hours" class="text-2xl font-bold text-white mt-0.5">0.0h</p>
        </div>
      </div>

      <div class="bg-slate-900/80 border border-slate-800 p-5 rounded-2xl flex items-center gap-4">
        <div class="p-3 bg-emerald-500/10 border border-emerald-500/20 rounded-xl text-emerald-400">
          <Trophy class="w-6 h-6" />
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Completados</p>
          <p id="stat-completed" class="text-2xl font-bold text-white mt-0.5">0</p>
        </div>
      </div>
    </div>

    <!-- Contenedor Principal de la Galería / Estado Vacío -->
    <div id="library-container" class="bg-slate-900/50 border border-slate-800/80 rounded-2xl p-12 text-center flex flex-col items-center justify-center min-h-[300px]">
      <div class="p-4 bg-slate-800/50 rounded-2xl mb-4 text-slate-500">
        <Gamepad2 class="w-10 h-10" />
      </div>
      <h3 class="text-lg font-semibold text-white">Tu biblioteca está vacía</h3>
      <p class="text-sm text-slate-400 max-w-sm mt-1 mb-6">Aún no has agregado ningún juego a tu colección. Empieza buscando tus títulos favoritos.</p>
      <a href="/search" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm font-semibold rounded-xl transition-colors">
        Ir al buscador
      </a>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  // Proteger la ruta: Validar si existe sesión activa
  async function checkAuthAndLoad() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session) {
      window.location.href = '/login';
      return;
    }

    // Consultar biblioteca del usuario en Supabase
    const { data: games, error } = await supabase
      .from('user_library')
      .select('*')
      .eq('user_id', session.user.id);

    if (error) {
      console.error('Error al cargar la biblioteca:', error.message);
      return;
    }

    // Actualizar Estadísticas
    if (games && games.length > 0) {
      const totalHours = games.reduce((acc, curr) => acc + (Number(curr.hours_played) || 0), 0);
      const completedCount = games.filter(g => g.status === 'completed').length;

      document.getElementById('stat-total')!.textContent = games.length.toString();
      document.getElementById('stat-hours')!.textContent = `${totalHours.toFixed(1)}h`;
      document.getElementById('stat-completed')!.textContent = completedCount.toString();

      // Renderizar tarjetas de juegos
      const container = document.getElementById('library-container')!;
      container.className = "grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6";
      container.innerHTML = games.map(game => `
        <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden flex flex-col justify-between">
          <img src="${game.cover_url || '/placeholder.jpg'}" alt="${game.title}" class="w-full h-44 object-cover" />
          <div class="p-4">
            <span class="text-[10px] uppercase font-bold px-2 py-0.5 bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 rounded-md">
              ${game.platform}
            </span>
            <h3 class="font-bold text-white text-base mt-2 line-clamp-1">${game.title}</h3>
            <p class="text-xs text-slate-400 mt-1">Tienda: ${game.store}</p>
          </div>
        </div>
      `).join('');
    }
  }

  checkAuthAndLoad();
</script>
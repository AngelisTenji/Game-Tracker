---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import { Gamepad2, Plus, X, Filter, Search, AlertTriangle, Target, Sparkles, FolderHeart } from 'lucide-astro';
---

<Layout title="Mi Biblioteca | KazeChronik">
  <Navbar />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-8 space-y-6">
    
    <!-- ENCABEZADO CENTRADO -->
    <div class="text-center space-y-3 pb-2">
      <h1 class="text-3xl sm:text-4xl font-black theme-text-primary tracking-tight">Mi Biblioteca</h1>

      <!-- BUSCADOR INTERNO CENTRADO -->
      <div class="relative w-full max-w-md mx-auto">
        <Search class="w-4 h-4 theme-text-secondary absolute left-3.5 top-1/2 -translate-y-1/2" />
        <input
          type="text"
          id="search-internal"
          placeholder="Buscar en mi colección..."
          class="w-full pl-10 pr-4 py-2 theme-input border rounded-2xl text-xs focus:outline-none focus:border-indigo-500 transition-all shadow-sm text-center sm:text-left"
        />
      </div>

      <!-- BANNER DE METAS ADAPTABLE A CUALQUIER TEMA -->
      <div class="inline-flex flex-wrap items-center justify-center gap-3 theme-card border p-2 sm:px-5 sm:py-2 rounded-2xl shadow-sm mx-auto max-w-full">
        <div class="flex items-center gap-2">
          <span class="p-1.5 bg-amber-500/10 text-amber-500 rounded-lg text-xs">🎯</span>
          <div class="text-xs">
            <span class="font-bold theme-text-primary">Metas 2026:</span>
            <span id="dash-completed-val" class="text-amber-500 font-bold ml-1">0</span>/<span id="dash-target-completed-val" class="theme-text-primary">12</span> comp.
          </div>
        </div>

        <div class="w-24 bg-slate-500/20 rounded-full h-1.5 overflow-hidden hidden sm:block border border-slate-500/20">
          <div id="dash-completed-bar" class="bg-gradient-to-r from-amber-500 to-amber-300 h-full w-0 transition-all duration-500"></div>
        </div>

        <div class="h-4 w-[1px] bg-slate-500/20 hidden sm:block"></div>

        <div class="flex items-center gap-2 text-xs">
          <span class="theme-text-secondary">Horas:</span>
          <span id="dash-hours-val" class="text-indigo-500 font-bold">0h</span>
        </div>

        <div class="flex items-center gap-1.5 ml-2">
          <a href="/goals" class="p-1.5 hover:bg-slate-500/10 rounded-lg text-amber-500 text-xs transition-colors" title="Ver Metas Anuales">🎯</a>
          <a href="/lists" class="p-1.5 hover:bg-slate-500/10 rounded-lg text-emerald-500 text-xs transition-colors" title="Mis Listas Personalizadas">📁</a>
          <a href="/search" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl shadow-md shadow-indigo-600/20 transition-all flex items-center gap-1 ml-1">
            <Plus class="w-3.5 h-3.5" />
            <span>Añadir</span>
          </a>
        </div>
      </div>
    </div>

    <!-- PANEL DE FILTROS CENTRADOS -->
    <div class="space-y-3 pt-2 border-t border-slate-500/10">
      
      <!-- Pestañas de Filtro Rápido Centradas -->
      <div class="flex items-center justify-center gap-1.5 overflow-x-auto pb-1 no-scrollbar">
        <button data-filter="all" class="filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-bold bg-indigo-600 text-white transition-all cursor-pointer whitespace-nowrap shadow-sm">
          Todos (<span id="stat-total">0</span>)
        </button>
        <button data-filter="playing" class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold theme-button border border-transparent transition-all cursor-pointer whitespace-nowrap">
          Jugando (<span id="stat-playing-count">0</span>)
        </button>
        <button data-filter="completed" class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold theme-button border border-transparent transition-all cursor-pointer whitespace-nowrap">
          Completados
        </button>
        <button data-filter="backlog" class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold theme-button border border-transparent transition-all cursor-pointer whitespace-nowrap">
          Pendientes (<span id="stat-backlog">0</span>)
        </button>

        <!-- Desplegable para Estados Secundarios -->
        <select id="more-status-filter" class="px-3 py-1.5 theme-button border border-slate-500/20 rounded-xl text-xs font-semibold focus:outline-none cursor-pointer">
          <option value="">Más filtros...</option>
          <option value="on_hold">En Pausa</option>
          <option value="dropped">Abandonados</option>
          <option value="favorites">⭐ Favoritos</option>
        </select>
      </div>

      <!-- Filtros Secundarios Centrados (Plataformas, Tiendas y Etiquetas) -->
      <div class="flex flex-wrap items-center justify-center gap-3 text-xs">
        <div class="flex items-center gap-2">
          <select id="filter-platform" class="px-2.5 py-1 theme-input border rounded-lg text-xs cursor-pointer">
            <option value="all">Todas las plataformas</option>
            <option value="PC">PC</option>
            <option value="PS5">PS5</option>
            <option value="PS4">PS4</option>
            <option value="Xbox Series X/S">Xbox Series</option>
            <option value="Xbox One">Xbox One</option>
            <option value="Nintendo Switch">Switch</option>
            <option value="Android">Android</option>
            <option value="iOS">iOS</option>
          </select>

          <select id="filter-store" class="px-2.5 py-1 theme-input border rounded-lg text-xs cursor-pointer">
            <option value="all">Todas las tiendas</option>
            <option value="Steam">Steam</option>
            <option value="Epic Games">Epic Games</option>
            <option value="Microsoft Store">Microsoft Store</option>
            <option value="GOG">GOG</option>
            <option value="PlayStation Store">PS Store</option>
            <option value="Nintendo eShop">eShop</option>
            <option value="Xbox Store">Xbox Store</option>
            <option value="Otro">Otro / Físico</option>
          </select>
        </div>

        <!-- Filtro Dinámico de Etiquetas -->
        <div id="tags-filter-wrapper" class="hidden flex items-center gap-1.5 overflow-x-auto">
          <div id="tags-filter-container" class="flex items-center gap-1"></div>
        </div>
      </div>
    </div>

    <!-- GALERÍA DE JUEGOS CON TARJETAS ADAPTABLES -->
    <div id="library-container" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 pt-2">
      <!-- Skeleton de Carga inicial -->
      <div class="theme-card border rounded-2xl p-0 overflow-hidden animate-pulse flex flex-col justify-between h-[360px]">
        <div class="w-full h-8 bg-slate-500/10"></div>
        <div class="w-full h-44 bg-slate-500/20"></div>
        <div class="p-4 space-y-3 flex-1 flex flex-col justify-between items-center">
          <div class="h-3 bg-slate-500/20 rounded w-1/3"></div>
          <div class="h-4 bg-slate-500/20 rounded w-3/4"></div>
          <div class="h-3 bg-slate-500/20 rounded w-1/2"></div>
        </div>
      </div>
    </div>

    <!-- Controles de Paginación -->
    <div id="pagination-controls" class="flex items-center justify-between mt-8 pt-4 border-t border-slate-500/20 hidden">
      <p id="pagination-info" class="text-xs theme-text-secondary font-medium">
        Mostrando <span id="page-start">0</span> - <span id="page-end">0</span> de <span id="page-total">0</span> juegos
      </p>
      
      <div class="flex items-center gap-2">
        <button 
          id="prev-page-btn" 
          class="px-3.5 py-1.5 rounded-xl text-xs font-semibold theme-button border border-slate-500/20 hover:border-indigo-500 disabled:opacity-40 disabled:cursor-not-allowed transition-all cursor-pointer"
        >
          ← Anterior
        </button>
        <span id="current-page-badge" class="px-3 py-1 bg-indigo-600/20 text-indigo-500 border border-indigo-500/30 text-xs font-bold rounded-lg">
          1
        </span>
        <button 
          id="next-page-btn" 
          class="px-3.5 py-1.5 rounded-xl text-xs font-semibold theme-button border border-slate-500/20 hover:border-indigo-500 disabled:opacity-40 disabled:cursor-not-allowed transition-all cursor-pointer"
        >
          Siguiente →
        </button>
      </div>
    </div>
  </main>

  <!-- MODAL DE EDICIÓN DE JUEGO -->
  <div id="edit-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="theme-card border w-[92vw] max-w-md rounded-2xl p-6 shadow-2xl relative overflow-hidden">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-500/20">
        <h3 id="modal-game-title" class="text-lg font-bold theme-text-primary truncate">Editar Juego</h3>
        <button id="close-modal-btn" class="p-1 theme-text-secondary hover:theme-text-primary rounded-lg hover:bg-slate-500/10 transition-colors cursor-pointer">
          <X class="w-5 h-5" />
        </button>
      </div>

      <form id="edit-form" class="space-y-4">
        <input type="hidden" id="edit-game-id" />

        <div>
          <label class="block text-xs font-semibold theme-text-secondary uppercase tracking-wider mb-2">
            Estado de Juego
          </label>
          <select id="edit-status" class="w-full px-3 py-2.5 theme-input border rounded-xl theme-text-primary text-sm focus:outline-none focus:border-indigo-500 truncate cursor-pointer">
            <option value="playing">Jugando</option>
            <option value="completed">Completado</option>
            <option value="backlog">Pendiente (Backlog)</option>
            <option value="on_hold">En Pausa</option>
            <option value="dropped">Abandonado</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold theme-text-secondary uppercase tracking-wider mb-2">
            Horas Jugadas
          </label>
          <input type="number" step="0.5" min="0" id="edit-hours" class="w-full px-3 py-2.5 theme-input border rounded-xl text-sm focus:outline-none focus:border-indigo-500" />
        </div>

        <div class="flex gap-3 pt-2">
          <button type="button" id="cancel-modal-btn" class="flex-1 py-2.5 px-4 theme-button text-sm font-semibold rounded-xl transition-colors cursor-pointer">
            Cancelar
          </button>
          <button type="submit" id="save-edit-btn" class="flex-1 py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl transition-all shadow-lg shadow-indigo-500/20 cursor-pointer flex items-center justify-center gap-2">
            <span>Guardar Cambios</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL DE CONFIRMACIÓN DE ELIMINACIÓN -->
  <div id="delete-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="theme-card border w-[92vw] max-w-sm rounded-2xl p-6 shadow-2xl relative overflow-hidden text-center">
      <div class="mx-auto w-12 h-12 bg-rose-500/10 border border-rose-500/20 text-rose-500 rounded-2xl flex items-center justify-center mb-4">
        <AlertTriangle class="w-6 h-6" />
      </div>
      <h3 class="text-lg font-bold theme-text-primary mb-1">¿Eliminar Videojuego?</h3>
      <p id="delete-modal-msg" class="text-xs theme-text-secondary mb-6 line-clamp-2">
        Esta acción eliminará el juego y sus registros de tu biblioteca de forma permanente.
      </p>

      <div class="flex gap-3">
        <button id="cancel-delete-btn" type="button" class="flex-1 py-2.5 px-4 theme-button text-xs font-semibold rounded-xl transition-colors cursor-pointer">
          Cancelar
        </button>
        <button id="confirm-delete-btn" type="button" class="flex-1 py-2.5 px-4 bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold rounded-xl transition-all shadow-lg shadow-rose-600/20 cursor-pointer flex items-center justify-center gap-1.5">
          <span>Sí, Eliminar</span>
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { enqueueAction, processSyncQueue } from '../lib/syncQueue';

  let allGames: any[] = [];
  let activeStatusFilter = 'all';
  let activePlatformFilter = 'all';
  let activeStoreFilter = 'all';
  let activeTagFilter = 'all';
  let searchQuery = '';
  let currentPage = 1;
  let gameToDeleteId: string | null = null;

  const ITEMS_PER_PAGE = 12;
  const currentYear = new Date().getFullYear();

  const modal = document.getElementById('edit-modal') as HTMLDivElement;
  const closeModalBtn = document.getElementById('close-modal-btn') as HTMLButtonElement;
  const cancelModalBtn = document.getElementById('cancel-modal-btn') as HTMLButtonElement;
  const editForm = document.getElementById('edit-form') as HTMLFormElement;
  const editGameId = document.getElementById('edit-game-id') as HTMLInputElement;
  const editStatus = document.getElementById('edit-status') as HTMLSelectElement;
  const editHours = document.getElementById('edit-hours') as HTMLInputElement;
  const modalGameTitle = document.getElementById('modal-game-title') as HTMLHeadingElement;
  const saveEditBtn = document.getElementById('save-edit-btn') as HTMLButtonElement;

  const deleteModal = document.getElementById('delete-modal') as HTMLDivElement;
  const deleteModalMsg = document.getElementById('delete-modal-msg') as HTMLParagraphElement;
  const cancelDeleteBtn = document.getElementById('cancel-delete-btn') as HTMLButtonElement;
  const confirmDeleteBtn = document.getElementById('confirm-delete-btn') as HTMLButtonElement;

  const platformSelect = document.getElementById('filter-platform') as HTMLSelectElement;
  const storeSelect = document.getElementById('filter-store') as HTMLSelectElement;
  const moreStatusSelect = document.getElementById('more-status-filter') as HTMLSelectElement;
  const searchInput = document.getElementById('search-internal') as HTMLInputElement;

  const statusMap: Record<string, string> = {
    playing: 'Jugando',
    completed: 'Completado',
    backlog: 'Pendiente',
    on_hold: 'En Pausa',
    dropped: 'Abandonado'
  };

  const statusBadgeStyles: Record<string, string> = {
    playing: 'bg-cyan-500/10 text-cyan-500 border-cyan-500/20',
    completed: 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20',
    backlog: 'bg-amber-500/10 text-amber-500 border-amber-500/20',
    on_hold: 'bg-purple-500/10 text-purple-500 border-purple-500/20',
    dropped: 'bg-rose-500/10 text-rose-500 border-rose-500/20'
  };

  const statusPriority: Record<string, number> = {
    playing: 1,
    completed: 2,
    backlog: 3,
    on_hold: 4,
    dropped: 5
  };

  async function loadLibrary() {
    if (!navigator.onLine) {
      const cached = localStorage.getItem('kazechronik_library_cache');
      if (cached) {
        try {
          allGames = JSON.parse(cached);
          updateStatsAndRender();
          loadDashboardGoals();
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast('Cargado desde la caché local (Modo Offline)', 'info');
          }
          return;
        } catch (e) {
          console.error('Error al parsear la caché local:', e);
        }
      }
    } else {
      processSyncQueue();
    }

    try {
      const { data: { session } } = await supabase.auth.getSession();

      if (!session) {
        window.location.href = '/login';
        return;
      }

      const { data: profile } = await supabase
        .from('profiles')
        .select('username')
        .eq('id', session.user.id)
        .maybeSingle();

      if (!profile) {
        window.location.href = '/onboarding';
        return;
      }

      const { data: games, error } = await supabase
        .from('user_library')
        .select('*')
        .eq('user_id', session.user.id)
        .order('created_at', { ascending: false });

      if (error) throw error;

      allGames = games || [];

      localStorage.setItem('kazechronik_library_cache', JSON.stringify(allGames));
      updateStatsAndRender();
      loadDashboardGoals();

    } catch (err: any) {
      console.warn('Conexión no disponible. Utilizando copia local:', err?.message);
      const cached = localStorage.getItem('kazechronik_library_cache');
      if (cached) {
        allGames = JSON.parse(cached);
        updateStatsAndRender();
        loadDashboardGoals();
      }
    }
  }

  async function loadDashboardGoals() {
    let targetCompleted = 12;

    if (navigator.onLine) {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (session) {
          const { data: goals } = await supabase
            .from('user_goals')
            .select('target_completed_games')
            .eq('user_id', session.user.id)
            .eq('year', currentYear)
            .maybeSingle();

          if (goals) {
            targetCompleted = goals.target_completed_games || 12;
          }
        }
      } catch (e) {
        console.warn('Error cargando metas en widget:', e);
      }
    }

    const completedCount = allGames.filter(g => g.status === 'completed').length;
    const totalHours = allGames.reduce((acc, curr) => acc + (Number(curr.hours_played) || 0), 0);
    const completedPct = Math.min(100, Math.round((completedCount / targetCompleted) * 100));

    const compValEl = document.getElementById('dash-completed-val');
    const targetCompValEl = document.getElementById('dash-target-completed-val');
    const compBarEl = document.getElementById('dash-completed-bar');
    const hoursValEl = document.getElementById('dash-hours-val');

    if (compValEl) compValEl.textContent = completedCount.toString();
    if (targetCompValEl) targetCompValEl.textContent = targetCompleted.toString();
    if (compBarEl) compBarEl.style.width = `${completedPct}%`;
    if (hoursValEl) hoursValEl.textContent = `${totalHours.toFixed(1)}h`;
  }

  function updateStatsAndRender() {
    const totalCount = allGames.length;
    const playingCount = allGames.filter(g => g.status === 'playing').length;
    const backlogCount = allGames.filter(g => g.status === 'backlog').length;

    const totalEl = document.getElementById('stat-total');
    const playingEl = document.getElementById('stat-playing-count');
    const backlogEl = document.getElementById('stat-backlog');

    if (totalEl) totalEl.textContent = totalCount.toString();
    if (playingEl) playingEl.textContent = playingCount.toString();
    if (backlogEl) backlogEl.textContent = backlogCount.toString();

    renderTagFilters();
    renderGrid();
  }

  function renderTagFilters() {
    const wrapper = document.getElementById('tags-filter-wrapper');
    const container = document.getElementById('tags-filter-container');
    if (!wrapper || !container) return;

    const allTags = Array.from(
      new Set(allGames.flatMap(g => g.tags || []))
    ).filter(Boolean);

    if (allTags.length === 0) {
      wrapper.classList.add('hidden');
      return;
    }

    wrapper.classList.remove('hidden');

    container.innerHTML = `
      <span class="text-xs font-semibold theme-text-secondary mr-1">Etiquetas:</span>
      <button 
        data-tag="all" 
        class="tag-filter-btn px-2.5 py-1 rounded-lg text-xs font-semibold ${activeTagFilter === 'all' ? 'bg-indigo-600 text-white' : 'theme-button'} transition-all cursor-pointer whitespace-nowrap"
      >
        Todas
      </button>
      ${allTags.map(tag => `
        <button 
          data-tag="${tag}" 
          class="tag-filter-btn px-2.5 py-1 rounded-lg text-xs font-semibold ${activeTagFilter === tag ? 'bg-indigo-600 text-white' : 'theme-button'} transition-all cursor-pointer whitespace-nowrap"
        >
          #${tag}
        </button>
      `).join('')}
    `;

    container.querySelectorAll('.tag-filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        activeTagFilter = btn.getAttribute('data-tag') || 'all';
        currentPage = 1;
        renderTagFilters();
        renderGrid();
      });
    });
  }

  function renderGrid() {
    const container = document.getElementById('library-container');
    const paginationControls = document.getElementById('pagination-controls');
    if (!container) return;

    let filteredGames = allGames.filter(game => {
      const matchStatus = activeStatusFilter === 'all' 
        ? true 
        : activeStatusFilter === 'favorites' 
          ? game.is_favorite === true 
          : game.status === activeStatusFilter;

      const matchPlatform = activePlatformFilter === 'all' || game.platform === activePlatformFilter;
      const matchStore = activeStoreFilter === 'all' || game.store === activeStoreFilter;
      const matchSearch = searchQuery === '' || game.title.toLowerCase().includes(searchQuery.toLowerCase());
      const matchTag = activeTagFilter === 'all' || (game.tags && game.tags.includes(activeTagFilter));

      return matchStatus && matchPlatform && matchStore && matchSearch && matchTag;
    });

    filteredGames.sort((a, b) => {
      const priorityA = statusPriority[a.status] || 99;
      const priorityB = statusPriority[b.status] || 99;

      if (priorityA !== priorityB) {
        return priorityA - priorityB;
      }
      return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
    });

    if (filteredGames.length === 0) {
      if (paginationControls) paginationControls.classList.add('hidden');
      container.className = "theme-card border rounded-2xl p-12 text-center flex flex-col items-center justify-center min-h-[300px] transition-all";
      container.innerHTML = `
        <div class="p-4 theme-button rounded-2xl mb-4 theme-text-secondary">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 002 2h14a2 2 0 002-2V7a2 2 0 00-2-2H5z"></path></svg>
        </div>
        <h3 class="text-lg font-semibold theme-text-primary">No se encontraron juegos</h3>
        <p class="text-sm theme-text-secondary max-w-sm mt-1 mb-6">Prueba ajustando el texto o borrando los filtros aplicados.</p>
      `;
      return;
    }

    const totalPages = Math.ceil(filteredGames.length / ITEMS_PER_PAGE);
    if (currentPage > totalPages) currentPage = 1;

    const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
    const endIndex = Math.min(startIndex + ITEMS_PER_PAGE, filteredGames.length);
    const paginatedGames = filteredGames.slice(startIndex, endIndex);

    if (paginationControls) {
      if (filteredGames.length > ITEMS_PER_PAGE) {
        paginationControls.classList.remove('hidden');
        
        const startEl = document.getElementById('page-start');
        const endEl = document.getElementById('page-end');
        const totalEl = document.getElementById('page-total');
        const badgeEl = document.getElementById('current-page-badge');
        const prevBtn = document.getElementById('prev-page-btn') as HTMLButtonElement;
        const nextBtn = document.getElementById('next-page-btn') as HTMLButtonElement;

        if (startEl) startEl.textContent = (startIndex + 1).toString();
        if (endEl) endEl.textContent = endIndex.toString();
        if (totalEl) totalEl.textContent = filteredGames.length.toString();
        if (badgeEl) badgeEl.textContent = `${currentPage} / ${totalPages}`;

        if (prevBtn) prevBtn.disabled = currentPage === 1;
        if (nextBtn) nextBtn.disabled = currentPage === totalPages;
      } else {
        paginationControls.classList.add('hidden');
      }
    }

    container.className = "grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6";
    container.innerHTML = paginatedGames.map(game => {
      const badgeClass = statusBadgeStyles[game.status] || 'theme-button border-slate-500/20';
      const statusText = statusMap[game.status] || game.status;
      const safeTitle = game.title.replace(/'/g, "\\'");
      const isFav = game.is_favorite === true;

      return `
        <div class="theme-card border rounded-2xl overflow-hidden flex flex-col justify-between hover:border-indigo-500/50 transition-all duration-300 hover:-translate-y-1 shadow-md hover:shadow-xl group relative">
          
          <!-- CINTILLA SUPERIOR DINÁMICA (Sin bg-slate-900 hardcodeado) -->
          <div class="px-3.5 py-2 theme-card border-b border-slate-500/20 flex items-center justify-between text-[11px] font-bold theme-text-secondary">
            <span class="flex items-center gap-1.5 theme-text-primary truncate">
              <span class="text-xs shrink-0">🏪</span>
              <span class="truncate">${game.store || 'Biblioteca'}</span>
            </span>
            <span class="px-2 py-0.5 bg-indigo-500/10 text-indigo-500 border border-indigo-500/20 rounded-md uppercase text-[10px] shrink-0 ml-1">
              ${game.platform || 'PC'}
            </span>
          </div>

          <!-- PORTADA CON CONTRASTE DINÁMICO -->
          <div class="relative overflow-hidden h-44 bg-slate-500/10">
            <a href="/game/${game.id}" class="block w-full h-full">
              <img 
                src="${game.cover_url || '/placeholder.jpg'}" 
                alt="Portada de ${game.title}" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-center p-3">
                <span class="text-xs font-semibold text-white bg-indigo-600/90 px-3 py-1 rounded-lg backdrop-blur-sm">
                  Ver Bitácora →
                </span>
              </div>
            </a>

            <button 
              type="button"
              onclick="toggleFavorite('${game.id}', ${isFav})"
              class="absolute top-2 right-2 p-1.5 rounded-xl theme-card border border-slate-500/20 text-amber-500 hover:scale-110 active:scale-95 transition-all z-20 cursor-pointer shadow-lg"
              title="${isFav ? 'Quitar de favoritos' : 'Marcar como favorito'}"
            >
              ${isFav ? '★' : '☆'}
            </button>
          </div>

          <!-- CUERPO DE TARJETA -->
          <div class="p-4 flex-1 flex flex-col justify-between text-center space-y-3">
            <div class="space-y-2">
              <div class="flex justify-center">
                <span class="text-[10px] uppercase font-bold px-3 py-0.5 border rounded-full ${badgeClass}">
                  ${statusText}
                </span>
              </div>

              <a href="/game/${game.id}" class="block hover:text-indigo-500 transition-colors">
                <h3 class="font-bold theme-text-primary text-base line-clamp-1">${game.title}</h3>
              </a>

              <p class="text-xs theme-text-secondary font-medium">
                Tiempo: <strong class="text-indigo-500 font-bold">${game.hours_played || 0} hrs</strong>
              </p>
            </div>

            <!-- FRANJA INFERIOR -->
            <div class="flex gap-2 pt-3 border-t border-slate-500/20">
              <button
                onclick="openEditModal('${game.id}', '${safeTitle}', ${game.hours_played || 0}, '${game.status}')"
                class="flex-1 py-1.5 px-2 theme-button text-xs font-semibold rounded-xl transition-colors flex items-center justify-center gap-1 cursor-pointer"
              >
                ✏️ Editar
              </button>
              
              <button
                onclick="promptDeleteGame('${game.id}', '${safeTitle}')"
                class="py-1.5 px-3 bg-rose-500/10 hover:bg-rose-500/20 text-rose-500 text-xs font-semibold rounded-xl transition-colors cursor-pointer border border-rose-500/20"
              >
                🗑️
              </button>
            </div>
          </div>

        </div>
      `;
    }).join('');
  }

  // --- ACCIONES CON CACHÉ LOCAL Y RESILIENCIA OFFLINE ---
  (window as any).toggleFavorite = async (gameId: string, currentFav: boolean) => {
    const newFavStatus = !currentFav;
    
    const game = allGames.find(g => g.id === gameId);
    if (game) game.is_favorite = newFavStatus;
    
    localStorage.setItem('kazechronik_library_cache', JSON.stringify(allGames));
    renderGrid();

    if (!navigator.onLine) {
      enqueueAction('user_library', 'UPDATE', { id: gameId, is_favorite: newFavStatus });
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Cambio guardado offline (se sincronizará al conectar)', 'info');
      }
      return;
    }

    const { error } = await supabase
      .from('user_library')
      .update({ is_favorite: newFavStatus })
      .eq('id', gameId);

    if (error) {
      console.error('Error al actualizar favorito:', error);
      if (game) game.is_favorite = currentFav;
      localStorage.setItem('kazechronik_library_cache', JSON.stringify(allGames));
      renderGrid();
    }
  };

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim();
    currentPage = 1;
    renderGrid();
  });

  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-indigo-600', 'text-white');
        b.classList.add('theme-button');
      });

      btn.classList.remove('theme-button');
      btn.classList.add('bg-indigo-600', 'text-white');

      if (moreStatusSelect) moreStatusSelect.value = '';
      activeStatusFilter = btn.getAttribute('data-filter') || 'all';
      currentPage = 1;
      renderGrid();
    });
  });

  moreStatusSelect?.addEventListener('change', (e) => {
    const val = (e.target as HTMLSelectElement).value;
    if (val) {
      filterBtns.forEach(b => {
        b.classList.remove('bg-indigo-600', 'text-white');
        b.classList.add('theme-button');
      });
      activeStatusFilter = val;
      currentPage = 1;
      renderGrid();
    }
  });

  platformSelect?.addEventListener('change', (e) => {
    activePlatformFilter = (e.target as HTMLSelectElement).value;
    currentPage = 1;
    renderGrid();
  });

  storeSelect?.addEventListener('change', (e) => {
    activeStoreFilter = (e.target as HTMLSelectElement).value;
    currentPage = 1;
    renderGrid();
  });

  (window as any).openEditModal = (id: string, title: string, hours: number, status: string) => {
    editGameId.value = id;
    modalGameTitle.textContent = `Editar: ${title}`;
    editHours.value = hours.toString();
    editStatus.value = status;
    modal.classList.remove('hidden');
  };

  function closeModal() {
    modal.classList.add('hidden');
  }

  closeModalBtn?.addEventListener('click', closeModal);
  cancelModalBtn?.addEventListener('click', closeModal);

  editForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = editGameId.value;
    const hours = parseFloat(editHours.value) || 0;
    const status = editStatus.value;

    const idx = allGames.findIndex(g => g.id === id);
    if (idx !== -1) {
      allGames[idx].hours_played = hours;
      allGames[idx].status = status;
      allGames[idx].updated_at = new Date().toISOString();
    }
    localStorage.setItem('kazechronik_library_cache', JSON.stringify(allGames));
    updateStatsAndRender();
    loadDashboardGoals();
    closeModal();

    if (!navigator.onLine) {
      enqueueAction('user_library', 'UPDATE', { id, hours_played: hours, status });
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Edición guardada offline (se sincronizará al conectar)', 'info');
      }
      return;
    }

    saveEditBtn.disabled = true;
    const { error } = await supabase
      .from('user_library')
      .update({ hours_played: hours, status: status, updated_at: new Date() })
      .eq('id', id);

    saveEditBtn.disabled = false;

    if (error) {
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Error al actualizar: ' + error.message, 'error');
      } else {
        alert('Error al actualizar: ' + error.message);
      }
    } else {
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Juego actualizado correctamente', 'success');
      }
    }
  });

  (window as any).promptDeleteGame = (id: string, title: string) => {
    gameToDeleteId = id;
    if (deleteModalMsg) {
      deleteModalMsg.textContent = `¿Estás seguro de que deseas eliminar "${title}" de tu colección? Esta acción no se puede deshacer.`;
    }
    deleteModal.classList.remove('hidden');
  };

  function closeDeleteModal() {
    gameToDeleteId = null;
    deleteModal.classList.add('hidden');
  }

  cancelDeleteBtn?.addEventListener('click', closeDeleteModal);

  confirmDeleteBtn?.addEventListener('click', async () => {
    if (!gameToDeleteId) return;

    const targetId = gameToDeleteId;
    allGames = allGames.filter(g => g.id !== targetId);
    localStorage.setItem('kazechronik_library_cache', JSON.stringify(allGames));
    updateStatsAndRender();
    loadDashboardGoals();
    closeDeleteModal();

    if (!navigator.onLine) {
      enqueueAction('user_library', 'DELETE', { id: targetId });
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Juego eliminado offline (se sincronizará al conectar)', 'info');
      }
      return;
    }

    confirmDeleteBtn.disabled = true;
    const { error } = await supabase
      .from('user_library')
      .delete()
      .eq('id', targetId);

    confirmDeleteBtn.disabled = false;

    if (error) {
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Error al eliminar: ' + error.message, 'error');
      } else {
        alert('Error al eliminar: ' + error.message);
      }
    } else {
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Videojuego eliminado correctamente', 'success');
      }
    }
  });

  loadLibrary();

  document.getElementById('prev-page-btn')?.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      renderGrid();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  document.getElementById('next-page-btn')?.addEventListener('click', () => {
    currentPage++;
    renderGrid();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
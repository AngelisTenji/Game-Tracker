---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import { Gamepad2, Clock, Trophy, Plus, Library, X, Filter, Search } from 'lucide-astro';
---

<Layout title="Mi Biblioteca | KazeChronik">
  <Navbar />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-8">
    <!-- Encabezado -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-bold theme-text-primary tracking-tight">Mi Biblioteca</h1>
        <p class="text-sm theme-text-secondary mt-1">Gestiona tus títulos, progreso y estadísticas</p>
      </div>

      <a
        href="/search"
        class="flex items-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl transition-all shadow-lg shadow-indigo-500/20"
      >
        <Plus class="w-4 h-4" />
        <span>Agregar Juego</span>
      </a>
    </div>

    <!-- Tarjetas de Métricas -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
      <div class="theme-card border p-5 rounded-2xl flex items-center gap-4 shadow-sm">
        <div class="p-3 bg-indigo-500/10 border border-indigo-500/20 rounded-xl text-indigo-500">
          <Library class="w-6 h-6" />
        </div>
        <div>
          <p class="text-xs font-semibold theme-text-secondary uppercase tracking-wider">Total Juegos</p>
          <p id="stat-total" class="text-2xl font-bold theme-text-primary mt-0.5">0</p>
        </div>
      </div>

      <div class="theme-card border p-5 rounded-2xl flex items-center gap-4 shadow-sm">
        <div class="p-3 bg-cyan-500/10 border border-cyan-500/20 rounded-xl text-cyan-500">
          <Clock class="w-6 h-6" />
        </div>
        <div>
          <p class="text-xs font-semibold theme-text-secondary uppercase tracking-wider">Horas Totales</p>
          <p id="stat-hours" class="text-2xl font-bold theme-text-primary mt-0.5">0.0h</p>
        </div>
      </div>

      <div class="theme-card border p-5 rounded-2xl flex items-center gap-4 shadow-sm">
        <div class="p-3 bg-emerald-500/10 border border-emerald-500/20 rounded-xl text-emerald-500">
          <Trophy class="w-6 h-6" />
        </div>
        <div>
          <p class="text-xs font-semibold theme-text-secondary uppercase tracking-wider">Completados</p>
          <p id="stat-completed" class="text-2xl font-bold theme-text-primary mt-0.5">0</p>
        </div>
      </div>
    </div>

    <!-- Buscador Interno y Pestañas de Estado -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 mb-4">
      <!-- Pestañas de Estado + Favoritos -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1">
        <button data-filter="all" class="filter-btn active px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 text-white transition-all cursor-pointer whitespace-nowrap shadow-sm">
          Todos
        </button>
        <button data-filter="playing" class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold theme-button border border-transparent transition-all cursor-pointer whitespace-nowrap">
          Jugando
        </button>
        <button data-filter="completed" class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold theme-button border border-transparent transition-all cursor-pointer whitespace-nowrap">
          Completados
        </button>
        <button data-filter="backlog" class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold theme-button border border-transparent transition-all cursor-pointer whitespace-nowrap">
          Pendientes
        </button>
        <button data-filter="on_hold" class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold theme-button border border-transparent transition-all cursor-pointer whitespace-nowrap">
          En Pausa
        </button>
        <button data-filter="dropped" class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold theme-button border border-transparent transition-all cursor-pointer whitespace-nowrap">
          Abandonados
        </button>
        <button data-filter="favorites" class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold theme-button border border-transparent transition-all cursor-pointer whitespace-nowrap flex items-center gap-1 text-amber-400">
          ⭐ Favoritos
        </button>
      </div>

      <!-- Buscador Interno -->
      <div class="relative w-full sm:w-64">
        <Search class="w-4 h-4 theme-text-secondary absolute left-3 top-1/2 -translate-y-1/2" />
        <input
          type="text"
          id="search-internal"
          placeholder="Buscar en mi colección..."
          class="w-full pl-9 pr-3 py-1.5 theme-input border rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:border-indigo-500 transition-colors shadow-sm"
        />
      </div>
    </div>

    <!-- Filtros Secundarios (Plataforma y Tienda) -->
    <div class="flex flex-wrap items-center gap-3 mb-4 pb-4 border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-1.5 text-xs theme-text-secondary font-semibold mr-2">
        <Filter class="w-3.5 h-3.5" />
        <span>Filtrar por:</span>
      </div>

      <select id="filter-platform" class="px-3 py-1.5 theme-input border rounded-lg text-xs focus:outline-none focus:border-indigo-500 cursor-pointer shadow-sm">
        <option value="all">Todas las plataformas</option>
        <option value="PC">PC</option>
        <option value="PS5">PlayStation 5</option>
        <option value="PS4">PlayStation 4</option>
        <option value="Xbox Series X/S">Xbox Series X/S</option>
        <option value="Xbox One">Xbox One</option>
        <option value="Nintendo Switch">Nintendo Switch</option>
        <option value="Android">Android</option>
        <option value="iOS">iOS</option>
      </select>

      <select id="filter-store" class="px-3 py-1.5 theme-input border rounded-lg text-xs focus:outline-none focus:border-indigo-500 cursor-pointer shadow-sm">
        <option value="all">Todas las tiendas</option>
        <option value="Steam">Steam</option>
        <option value="Epic Games">Epic Games</option>
        <option value="Microsoft Store">Microsoft Store</option>
        <option value="GOG">GOG</option>
        <option value="PlayStation Store">PlayStation Store</option>
        <option value="Nintendo eShop">Nintendo eShop</option>
        <option value="Xbox Store">Xbox Store</option>
        <option value="Google Play">Google Play</option>
        <option value="App Store">App Store</option>
        <option value="Otro">Otro / Físico</option>
      </select>
    </div>

    <!-- Filtro de Etiquetas Personalizadas (Separado) -->
    <div id="tags-filter-wrapper" class="hidden mb-6">
      <div class="flex items-center gap-2 overflow-x-auto pb-1" id="tags-filter-container">
        <!-- Inyectado dinámicamente -->
      </div>
    </div>

    <!-- Galería / Contenedor -->
    <div id="library-container" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <div class="theme-card border rounded-2xl p-4 animate-pulse h-72 flex flex-col justify-between">
        <div class="w-full h-40 bg-slate-500/20 rounded-xl mb-3"></div>
        <div class="h-4 bg-slate-500/20 rounded w-3/4 mb-2"></div>
        <div class="h-3 bg-slate-500/20 rounded w-1/2"></div>
      </div>
      <div class="theme-card border rounded-2xl p-4 animate-pulse h-72 flex flex-col justify-between">
        <div class="w-full h-40 bg-slate-500/20 rounded-xl mb-3"></div>
        <div class="h-4 bg-slate-500/20 rounded w-3/4 mb-2"></div>
        <div class="h-3 bg-slate-500/20 rounded w-1/2"></div>
      </div>
      <div class="theme-card border rounded-2xl p-4 animate-pulse h-72 flex flex-col justify-between">
        <div class="w-full h-40 bg-slate-500/20 rounded-xl mb-3"></div>
        <div class="h-4 bg-slate-500/20 rounded w-3/4 mb-2"></div>
        <div class="h-3 bg-slate-500/20 rounded w-1/2"></div>
      </div>
      <div class="theme-card border rounded-2xl p-4 animate-pulse h-72 flex flex-col justify-between">
        <div class="w-full h-40 bg-slate-500/20 rounded-xl mb-3"></div>
        <div class="h-4 bg-slate-500/20 rounded w-3/4 mb-2"></div>
        <div class="h-3 bg-slate-500/20 rounded w-1/2"></div>
      </div>
    </div>

    <!-- Controles de Paginación -->
    <div id="pagination-controls" class="flex items-center justify-between mt-8 pt-4 border-t border-slate-800 hidden">
      <p id="pagination-info" class="text-xs theme-text-secondary font-medium">
        Mostrando <span id="page-start">0</span> - <span id="page-end">0</span> de <span id="page-total">0</span> juegos
      </p>
      
      <div class="flex items-center gap-2">
        <button 
          id="prev-page-btn" 
          class="px-3.5 py-1.5 rounded-xl text-xs font-semibold theme-button border border-slate-800 hover:border-indigo-500 disabled:opacity-40 disabled:cursor-not-allowed transition-all cursor-pointer"
        >
          ← Anterior
        </button>
        <span id="current-page-badge" class="px-3 py-1 bg-indigo-600/20 text-indigo-400 border border-indigo-500/30 text-xs font-bold rounded-lg">
          1
        </span>
        <button 
          id="next-page-btn" 
          class="px-3.5 py-1.5 rounded-xl text-xs font-semibold theme-button border border-slate-800 hover:border-indigo-500 disabled:opacity-40 disabled:cursor-not-allowed transition-all cursor-pointer"
        >
          Siguiente →
        </button>
      </div>
    </div>
  </main>

  <!-- MODAL DE EDICIÓN ESTILIZADO (Con fix responsivo de overflow en móvil) -->
  <div id="edit-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="theme-card border w-[92vw] max-w-md rounded-2xl p-6 shadow-2xl relative overflow-hidden">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-200 dark:border-slate-800">
        <h3 id="modal-game-title" class="text-lg font-bold theme-text-primary truncate">Editar Juego</h3>
        <button id="close-modal-btn" class="p-1 theme-text-secondary hover:theme-text-primary rounded-lg hover:bg-slate-500/10 transition-colors">
          <X class="w-5 h-5" />
        </button>
      </div>

      <form id="edit-form" class="space-y-4">
        <input type="hidden" id="edit-game-id" />

        <div>
          <label class="block text-xs font-semibold theme-text-secondary uppercase tracking-wider mb-2">
            Estado de Juego
          </label>
          <div class="w-full overflow-x-hidden">
            <select id="edit-status" class="w-full max-w-full px-3 py-2.5 theme-input border rounded-xl theme-text-primary text-sm focus:outline-none focus:border-indigo-500 truncate cursor-pointer">
              <option value="playing">Jugando</option>
              <option value="completed">Completado</option>
              <option value="backlog">Pendiente (Backlog)</option>
              <option value="on_hold">En Pausa</option>
              <option value="dropped">Abandonado</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold theme-text-secondary uppercase tracking-wider mb-2">
            Horas Jugadas
          </label>
          <input type="number" step="0.5" min="0" id="edit-hours" class="w-full px-3 py-2.5 theme-input border rounded-xl text-sm focus:outline-none focus:border-indigo-500" />
        </div>

        <div class="flex gap-3 pt-2">
          <button type="button" id="cancel-modal-btn" class="flex-1 py-2.5 px-4 theme-button text-sm font-semibold rounded-xl transition-colors">
            Cancelar
          </button>
          <button type="submit" class="flex-1 py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl transition-all shadow-lg shadow-indigo-500/20 cursor-pointer">
            Guardar Cambios
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  let allGames: any[] = [];
  let activeStatusFilter = 'all';
  let activePlatformFilter = 'all';
  let activeStoreFilter = 'all';
  let activeTagFilter = 'all';
  let searchQuery = '';
  let currentPage = 1;

  const ITEMS_PER_PAGE = 12;
  const modal = document.getElementById('edit-modal') as HTMLDivElement;
  const closeModalBtn = document.getElementById('close-modal-btn') as HTMLButtonElement;
  const cancelModalBtn = document.getElementById('cancel-modal-btn') as HTMLButtonElement;
  const editForm = document.getElementById('edit-form') as HTMLFormElement;
  const editGameId = document.getElementById('edit-game-id') as HTMLInputElement;
  const editStatus = document.getElementById('edit-status') as HTMLSelectElement;
  const editHours = document.getElementById('edit-hours') as HTMLInputElement;
  const modalGameTitle = document.getElementById('modal-game-title') as HTMLHeadingElement;

  const platformSelect = document.getElementById('filter-platform') as HTMLSelectElement;
  const storeSelect = document.getElementById('filter-store') as HTMLSelectElement;
  const searchInput = document.getElementById('search-internal') as HTMLInputElement;

  const statusMap: Record<string, string> = {
    playing: 'Jugando',
    completed: 'Completado',
    backlog: 'Pendiente',
    on_hold: 'En Pausa',
    dropped: 'Abandonado'
  };

  const statusBadgeStyles: Record<string, string> = {
    playing: 'bg-cyan-500/10 text-cyan-500 border-cyan-500/20',
    completed: 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20',
    backlog: 'bg-amber-500/10 text-amber-500 border-amber-500/20',
    on_hold: 'bg-purple-500/10 text-purple-500 border-purple-500/20',
    dropped: 'bg-rose-500/10 text-rose-500 border-rose-500/20'
  };

  async function loadLibrary() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session) {
      window.location.href = '/login';
      return;
    }

    const { data: profile } = await supabase
      .from('profiles')
      .select('username')
      .eq('id', session.user.id)
      .maybeSingle();

    if (!profile) {
      window.location.href = '/onboarding';
      return;
    }

    const { data: games, error } = await supabase
      .from('user_library')
      .select('*')
      .eq('user_id', session.user.id)
      .order('created_at', { ascending: false });

    if (error) {
      console.error('Error al cargar la biblioteca:', error.message);
      return;
    }

    allGames = games || [];

    const totalHours = allGames.reduce((acc, curr) => acc + (Number(curr.hours_played) || 0), 0);
    const completedCount = allGames.filter(g => g.status === 'completed').length;

    const totalEl = document.getElementById('stat-total');
    const hoursEl = document.getElementById('stat-hours');
    const completedEl = document.getElementById('stat-completed');

    if (totalEl) totalEl.textContent = allGames.length.toString();
    if (hoursEl) hoursEl.textContent = `${totalHours.toFixed(1)}h`;
    if (completedEl) completedEl.textContent = completedCount.toString();

    renderTagFilters();
    renderGrid();
  }

  function renderTagFilters() {
    const wrapper = document.getElementById('tags-filter-wrapper');
    const container = document.getElementById('tags-filter-container');
    if (!wrapper || !container) return;

    const allTags = Array.from(
      new Set(allGames.flatMap(g => g.tags || []))
    ).filter(Boolean);

    if (allTags.length === 0) {
      wrapper.classList.add('hidden');
      return;
    }

    wrapper.classList.remove('hidden');

    container.innerHTML = `
      <span class="text-xs font-semibold theme-text-secondary mr-1">Etiquetas:</span>
      <button 
        data-tag="all" 
        class="tag-filter-btn px-2.5 py-1 rounded-lg text-xs font-semibold ${activeTagFilter === 'all' ? 'bg-indigo-600 text-white' : 'theme-button'} transition-all cursor-pointer whitespace-nowrap"
      >
        Todas
      </button>
      ${allTags.map(tag => `
        <button 
          data-tag="${tag}" 
          class="tag-filter-btn px-2.5 py-1 rounded-lg text-xs font-semibold ${activeTagFilter === tag ? 'bg-indigo-600 text-white' : 'theme-button'} transition-all cursor-pointer whitespace-nowrap"
        >
          #${tag}
        </button>
      `).join('')}
    `;

    container.querySelectorAll('.tag-filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        activeTagFilter = btn.getAttribute('data-tag') || 'all';
        currentPage = 1;
        renderTagFilters();
        renderGrid();
      });
    });
  }

  function renderGrid() {
    const container = document.getElementById('library-container');
    const paginationControls = document.getElementById('pagination-controls');
    if (!container) return;

    const filteredGames = allGames.filter(game => {
      const matchStatus = activeStatusFilter === 'all' 
        ? true 
        : activeStatusFilter === 'favorites' 
          ? game.is_favorite === true 
          : game.status === activeStatusFilter;

      const matchPlatform = activePlatformFilter === 'all' || game.platform === activePlatformFilter;
      const matchStore = activeStoreFilter === 'all' || game.store === activeStoreFilter;
      const matchSearch = searchQuery === '' || game.title.toLowerCase().includes(searchQuery.toLowerCase());
      const matchTag = activeTagFilter === 'all' || (game.tags && game.tags.includes(activeTagFilter));

      return matchStatus && matchPlatform && matchStore && matchSearch && matchTag;
    });

    if (filteredGames.length === 0) {
      if (paginationControls) paginationControls.classList.add('hidden');
      container.className = "theme-card border rounded-2xl p-12 text-center flex flex-col items-center justify-center min-h-[300px]";
      container.innerHTML = `
        <div class="p-4 theme-button rounded-2xl mb-4 theme-text-secondary">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 002 2h14a2 2 0 002-2V7a2 2 0 00-2-2H5z"></path></svg>
        </div>
        <h3 class="text-lg font-semibold theme-text-primary">No se encontraron juegos</h3>
        <p class="text-sm theme-text-secondary max-w-sm mt-1 mb-6">Prueba ajustando el texto o borrando los filtros aplicados.</p>
      `;
      return;
    }

    const totalPages = Math.ceil(filteredGames.length / ITEMS_PER_PAGE);
    if (currentPage > totalPages) currentPage = 1;

    const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
    const endIndex = Math.min(startIndex + ITEMS_PER_PAGE, filteredGames.length);
    const paginatedGames = filteredGames.slice(startIndex, endIndex);

    if (paginationControls) {
      if (filteredGames.length > ITEMS_PER_PAGE) {
        paginationControls.classList.remove('hidden');
        
        const startEl = document.getElementById('page-start');
        const endEl = document.getElementById('page-end');
        const totalEl = document.getElementById('page-total');
        const badgeEl = document.getElementById('current-page-badge');
        const prevBtn = document.getElementById('prev-page-btn') as HTMLButtonElement;
        const nextBtn = document.getElementById('next-page-btn') as HTMLButtonElement;

        if (startEl) startEl.textContent = (startIndex + 1).toString();
        if (endEl) endEl.textContent = endIndex.toString();
        if (totalEl) totalEl.textContent = filteredGames.length.toString();
        if (badgeEl) badgeEl.textContent = `${currentPage} / ${totalPages}`;

        if (prevBtn) prevBtn.disabled = currentPage === 1;
        if (nextBtn) nextBtn.disabled = currentPage === totalPages;
      } else {
        paginationControls.classList.add('hidden');
      }
    }

    container.className = "grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6";
    container.innerHTML = paginatedGames.map(game => {
      const badgeClass = statusBadgeStyles[game.status] || 'theme-button border-slate-500/20';
      const statusText = statusMap[game.status] || game.status;
      const safeTitle = game.title.replace(/'/g, "\\'");
      const isFav = game.is_favorite === true;

      return `
        <div class="theme-card border rounded-2xl overflow-hidden flex flex-col justify-between hover:border-indigo-500/50 transition-all shadow-md group relative">
          
          <div class="relative overflow-hidden h-44 bg-slate-800">
            <a href="/game/${game.id}" class="block w-full h-full">
              <img 
                src="${game.cover_url || '/placeholder.jpg'}" 
                alt="Portada de ${game.title}" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-3">
                <span class="text-xs font-semibold text-white bg-indigo-600/90 px-2.5 py-1 rounded-lg backdrop-blur-sm">
                  Ver Bitácora →
                </span>
              </div>
            </a>

            <button 
              type="button"
              onclick="toggleFavorite('${game.id}', ${isFav})"
              class="absolute top-2 right-2 p-1.5 rounded-xl bg-slate-950/80 backdrop-blur-md text-amber-400 hover:scale-110 transition-all z-20 cursor-pointer shadow-lg border border-white/10"
              title="${isFav ? 'Quitar de favoritos' : 'Marcar como favorito'}"
            >
              ${isFav ? '★' : '☆'}
            </button>
          </div>

          <div class="p-4 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] uppercase font-bold px-2 py-0.5 bg-indigo-500/10 text-indigo-500 border border-indigo-500/20 rounded-md">
                  ${game.platform || 'PC'}
                </span>
                <span class="text-[10px] uppercase font-bold px-2 py-0.5 border rounded-md ${badgeClass}">
                  ${statusText}
                </span>
              </div>

              <a href="/game/${game.id}" class="hover:text-indigo-400 transition-colors">
                <h3 class="font-bold theme-text-primary text-base line-clamp-1">${game.title}</h3>
              </a>

              <div class="flex items-center justify-between text-xs theme-text-secondary mt-1">
                <span>Horas: <strong class="text-indigo-500 font-bold">${game.hours_played || 0}h</strong></span>
                <span class="text-[11px] font-medium">${game.store || 'Sin tienda'}</span>
              </div>
            </div>

            <div class="flex gap-2 mt-4 pt-3 border-t border-slate-200 dark:border-slate-800">
              <button
                onclick="openEditModal('${game.id}', '${safeTitle}', ${game.hours_played || 0}, '${game.status}')"
                class="flex-1 py-1.5 px-2 theme-button hover:opacity-80 text-xs font-semibold rounded-lg transition-colors flex items-center justify-center gap-1 cursor-pointer"
              >
                <span>Editar</span>
              </button>
              
              <button
                onclick="deleteGame('${game.id}', '${safeTitle}')"
                class="py-1.5 px-2.5 bg-rose-500/10 hover:bg-rose-500/20 text-rose-500 text-xs font-semibold rounded-lg transition-colors cursor-pointer"
              >
                Eliminar
              </button>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  (window as any).toggleFavorite = async (gameId: string, currentFav: boolean) => {
    const newFavStatus = !currentFav;
    
    const game = allGames.find(g => g.id === gameId);
    if (game) game.is_favorite = newFavStatus;
    renderGrid();

    const { error } = await supabase
      .from('user_library')
      .update({ is_favorite: newFavStatus })
      .eq('id', gameId);

    if (error) {
      console.error('Error al actualizar favorito:', error);
      if (game) game.is_favorite = currentFav;
      renderGrid();
    }
  };

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim();
    currentPage = 1;
    renderGrid();
  });

  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-indigo-600', 'text-white');
        b.classList.add('theme-button');
      });

      btn.classList.remove('theme-button');
      btn.classList.add('bg-indigo-600', 'text-white');

      activeStatusFilter = btn.getAttribute('data-filter') || 'all';
      currentPage = 1;
      renderGrid();
    });
  });

  platformSelect?.addEventListener('change', (e) => {
    activePlatformFilter = (e.target as HTMLSelectElement).value;
    currentPage = 1;
    renderGrid();
  });

  storeSelect?.addEventListener('change', (e) => {
    activeStoreFilter = (e.target as HTMLSelectElement).value;
    currentPage = 1;
    renderGrid();
  });

  (window as any).openEditModal = (id: string, title: string, hours: number, status: string) => {
    editGameId.value = id;
    modalGameTitle.textContent = `Editar: ${title}`;
    editHours.value = hours.toString();
    editStatus.value = status;
    modal.classList.remove('hidden');
  };

  function closeModal() {
    modal.classList.add('hidden');
  }

  closeModalBtn?.addEventListener('click', closeModal);
  cancelModalBtn?.addEventListener('click', closeModal);

  editForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = editGameId.value;
    const hours = parseFloat(editHours.value) || 0;
    const status = editStatus.value;

    const { error } = await supabase
      .from('user_library')
      .update({ hours_played: hours, status: status, updated_at: new Date() })
      .eq('id', id);

    if (error) {
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Error al actualizar: ' + error.message, 'error');
      } else {
        alert('Error al actualizar: ' + error.message);
      }
    } else {
      closeModal();
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Juego actualizado correctamente', 'success');
      }
      loadLibrary();
    }
  });

  (window as any).deleteGame = async (id: string, title: string) => {
    if (!confirm(`¿Seguro que deseas eliminar ${title} de tu biblioteca?`)) return;

    const { error } = await supabase
      .from('user_library')
      .delete()
      .eq('id', id);

    if (error) {
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Error al eliminar: ' + error.message, 'error');
      } else {
        alert('Error al eliminar: ' + error.message);
      }
    } else {
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast(`${title} se eliminó de tu biblioteca`, 'success');
      }
      loadLibrary();
    }
  };

  loadLibrary();
  document.getElementById('prev-page-btn')?.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      renderGrid();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  document.getElementById('next-page-btn')?.addEventListener('click', () => {
    currentPage++;
    renderGrid();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
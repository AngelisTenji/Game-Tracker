---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/common/Navbar.astro';
import { Pin, Trash2, Plus, FileText, Image, MapPin, Shield, Puzzle, CheckSquare, Share2, FolderPlus, X } from 'lucide-astro';
---

<Layout title="Cargando Juego... | KazeChronik">
  <Navbar />

  <main class="min-h-screen pt-24 pb-16 px-4 max-w-6xl mx-auto theme-text-primary">
    <!-- Estado de Carga (Skeleton Adaptable) -->
    <div id="loading-skeleton" class="animate-pulse space-y-6">
      <div class="h-64 theme-card border rounded-3xl w-full"></div>
      <div class="h-10 theme-card border rounded-xl w-1/3"></div>
      <div class="h-32 theme-card border rounded-xl w-full"></div>
    </div>

    <!-- Mensaje de Error / No Encontrado -->
    <div id="error-container" class="hidden text-center py-20 space-y-4">
      <h2 class="text-2xl font-bold text-rose-500">No se pudo cargar el juego</h2>
      <p class="text-sm theme-text-secondary">Es posible que el juego no exista o no tengas permisos para verlo.</p>
      <a href="/dashboard" class="inline-block px-5 py-2.5 bg-indigo-600 text-white font-semibold text-sm rounded-xl hover:bg-indigo-500 transition-all shadow-lg shadow-indigo-600/20">
        Volver a la Biblioteca
      </a>
    </div>

    <!-- Contenido del Juego -->
    <article id="game-content" class="hidden space-y-8">
      <!-- Banner Principal -->
      <header class="relative h-72 sm:h-96 rounded-3xl overflow-hidden border border-slate-500/20 shadow-2xl theme-card">
        <img 
          id="game-cover" 
          src="" 
          alt="" 
          class="w-full h-full object-cover filter brightness-75"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
        
        <div class="absolute bottom-6 left-6 right-6 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span id="game-store" class="px-2.5 py-1 bg-indigo-500/20 border border-indigo-500/30 text-indigo-400 text-xs font-semibold rounded-lg backdrop-blur-md"></span>
              <span id="game-platform" class="px-2.5 py-1 theme-card text-xs font-semibold rounded-lg backdrop-blur-md border border-slate-500/20"></span>
            </div>
            <h1 id="game-title" class="text-3xl sm:text-5xl font-black tracking-tight text-white drop-shadow-md"></h1>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <!-- Botón de Favorito -->
            <button 
              type="button" 
              id="favorite-btn" 
              class="px-3.5 py-2 rounded-xl text-xs font-semibold border transition-all cursor-pointer flex items-center gap-1.5 backdrop-blur-md"
            >
              <span id="favorite-icon">☆</span>
              <span id="favorite-text">Añadir a Favoritos</span>
            </button>

            <!-- Botón Añadir a Lista Personalizada -->
            <button 
              type="button" 
              id="open-add-to-list-btn" 
              class="px-3.5 py-2 bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-400 border border-indigo-500/30 rounded-xl text-xs font-semibold transition-all cursor-pointer flex items-center gap-1.5 backdrop-blur-md"
            >
              <FolderPlus class="w-4 h-4" />
              <span>Añadir a Lista</span>
            </button>

            <a 
              href="/dashboard" 
              class="px-4 py-2 theme-button text-xs font-medium rounded-xl border border-slate-500/20 transition-all flex items-center gap-2 backdrop-blur-md"
            >
              ← Volver
            </a>
          </div>
        </div>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Columna Izquierda: Ajustes y Etiquetas -->
        <section class="lg:col-span-1 space-y-6">
          <div class="theme-card border p-6 rounded-2xl space-y-5 shadow-sm">
            <h2 class="font-bold text-lg border-b border-slate-500/20 pb-3 flex items-center gap-2">
              🎮 Estado & Progreso
            </h2>

            <!-- Selector de Estado -->
            <div>
              <label class="block text-xs font-semibold theme-text-secondary mb-2">Estado en la biblioteca</label>
              <select 
                id="status-select" 
                class="w-full px-4 py-2.5 theme-input border rounded-xl text-sm font-medium focus:outline-none focus:border-indigo-500 cursor-pointer"
              >
                <option value="playing">🔥 Jugando</option>
                <option value="completed">🏆 Completado</option>
                <option value="on_hold">⏸️ En Pausa</option>
                <option value="backlog">📋 Backlog (Pendiente)</option>
                <option value="dropped">❌ Abandonado</option>
              </select>
            </div>

            <!-- Horas Jugadas -->
            <div>
              <label class="block text-xs font-semibold theme-text-secondary mb-2">Horas Jugadas</label>
              <div class="flex items-center gap-2">
                <input 
                  type="number" 
                  id="hours-input" 
                  step="0.1" 
                  min="0"
                  class="flex-1 px-4 py-2.5 theme-input border rounded-xl text-sm font-medium focus:outline-none focus:border-indigo-500"
                />
                <span class="text-sm theme-text-secondary font-medium">hrs</span>
              </div>
            </div>

            <!-- Progreso de Logros -->
            <div>
              <div class="flex justify-between items-center mb-2">
                <label class="text-xs font-semibold theme-text-secondary">Logros desbloqueados</label>
                <span id="achievements-val" class="text-xs font-bold text-indigo-400">0%</span>
              </div>
              <input 
                type="range" 
                id="achievements-input" 
                min="0" 
                max="100" 
                class="w-full accent-indigo-500 cursor-pointer"
              />
            </div>

            <button 
              id="save-progress-btn" 
              class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm rounded-xl transition-all shadow-lg shadow-indigo-600/20 cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Guardar Cambios</span>
            </button>
          </div>

          <!-- Componente de Etiquetas -->
          <div class="theme-card border p-6 rounded-2xl space-y-3 shadow-sm">
            <label class="block text-xs font-semibold theme-text-secondary">Etiquetas / Categorías</label>
            <div id="tags-container" class="flex flex-wrap gap-1.5 mb-2">
              <!-- Inyectado dinámicamente -->
            </div>
            <div class="flex gap-2">
              <input 
                type="text" 
                id="new-tag-input" 
                placeholder="Añadir etiqueta (ej: Sigilo, Coop)"
                class="flex-1 px-3 py-1.5 theme-input border rounded-xl text-xs focus:outline-none focus:border-indigo-500"
              />
              <button 
                type="button" 
                id="add-tag-btn" 
                class="px-3 py-1.5 bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-400 border border-indigo-500/30 text-xs font-semibold rounded-xl transition-all cursor-pointer"
              >
                +
              </button>
            </div>
          </div>
        </section>

        <!-- Columna Derecha: Reseña y Bitácora -->
        <section class="lg:col-span-2 space-y-6">
          <div class="theme-card border p-6 rounded-2xl space-y-5 shadow-sm">
            <h2 class="font-bold text-lg border-b border-slate-500/20 pb-3 flex items-center gap-2">
              📝 Tu Bitácora y Reseña
            </h2>

            <div>
              <label class="block text-xs font-semibold theme-text-secondary mb-2">Puntuación Personal (1 al 10)</label>
              <input 
                type="number" 
                id="rating-input" 
                min="1" 
                max="10" 
                step="0.5" 
                placeholder="Ej: 9.5"
                class="w-32 px-4 py-2.5 theme-input border rounded-xl text-sm font-medium focus:outline-none focus:border-indigo-500"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold theme-text-secondary mb-2">Reseña del Juego</label>
              <textarea 
                id="review-input" 
                rows="4" 
                placeholder="¿Qué te pareció la jugabilidad, historia, banda sonora...?"
                class="w-full px-4 py-3 theme-input border rounded-xl text-sm focus:outline-none focus:border-indigo-500 resize-none"
              ></textarea>
            </div>

            <div>
              <label class="block text-xs font-semibold theme-text-secondary mb-2">Notas Rápidas / Recordatorios</label>
              <textarea 
                id="notes-input" 
                rows="3" 
                placeholder="Ej: Quedé en la misión secundaria X, conseguir el coleccionable Y..."
                class="w-full px-4 py-3 theme-input border rounded-xl text-sm focus:outline-none focus:border-indigo-500 resize-none"
              ></textarea>
            </div>

            <button 
              id="save-review-btn" 
              class="px-6 py-2.5 theme-button hover:opacity-80 font-semibold text-sm rounded-xl transition-all border border-slate-500/20 cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Guardar Bitácora</span>
            </button>
          </div>

          <!-- SECCIÓN: GAMER NOTEBOOK (NOTAS & BUILDS ESPECIALIZADAS) -->
          <div class="theme-card border p-6 rounded-2xl space-y-5 shadow-sm">
            <div class="flex items-center justify-between border-b border-slate-500/20 pb-3">
              <div>
                <h2 class="font-bold text-lg theme-text-primary flex items-center gap-2">
                  📓 Gamer Notebook
                </h2>
                <p class="text-xs theme-text-secondary mt-0.5">
                  Guarda builds, infografías, ubicaciones de mapa y puzles para este juego.
                </p>
              </div>

              <button
                type="button"
                id="toggle-note-form-btn"
                class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs rounded-xl transition-all shadow-lg shadow-indigo-600/20 cursor-pointer flex items-center gap-1.5"
              >
                <Plus class="w-4 h-4" />
                <span>Nueva Nota</span>
              </button>
            </div>

            <!-- Formulario de Creación de Nota (Colapsable) -->
            <form id="create-note-form" class="hidden theme-input border p-4 rounded-xl space-y-3">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="block text-[11px] font-semibold theme-text-secondary mb-1">Título de la Nota</label>
                  <input 
                    type="text" 
                    id="note-title" 
                    required 
                    placeholder="ej: Build Raiden Shogun (Sub-DPS)"
                    class="w-full px-3 py-2 theme-card border rounded-lg text-xs focus:outline-none focus:border-indigo-500"
                  />
                </div>

                <div>
                  <label class="block text-[11px] font-semibold theme-text-secondary mb-1">Categoría</label>
                  <select 
                    id="note-category" 
                    class="w-full px-3 py-2 theme-card border rounded-lg text-xs focus:outline-none focus:border-indigo-500 cursor-pointer"
                  >
                    <option value="builds">🛡️ Build / Equipamiento</option>
                    <option value="map">🗺️ Mapa / Misión / Coleccionable</option>
                    <option value="puzzle">🧩 Puzle / Código</option>
                    <option value="general">📝 General / Pendientes</option>
                  </select>
                </div>
              </div>

              <div>
                <label class="block text-[11px] font-semibold theme-text-secondary mb-1">Contenido / Detalles (Usa [ ] y [x] para checklists)</label>
                <textarea 
                  id="note-content" 
                  rows="3" 
                  placeholder="Escribe artefactos, atributos, armas, secuencias de puzle o notas directas..."
                  class="w-full px-3 py-2 theme-card border rounded-lg text-xs focus:outline-none focus:border-indigo-500 resize-none font-mono"
                ></textarea>
              </div>

              <div>
                <label class="block text-[11px] font-semibold theme-text-secondary mb-1">URL de Imagen / Infografía (Opcional)</label>
                <input 
                  type="url" 
                  id="note-image-url" 
                  placeholder="https://i.imgur.com/... o enlace de captura"
                  class="w-full px-3 py-2 theme-card border rounded-lg text-xs focus:outline-none focus:border-indigo-500"
                />
              </div>

              <div class="flex items-center justify-between pt-1">
                <label class="flex items-center gap-2 cursor-pointer text-xs theme-text-secondary">
                  <input type="checkbox" id="note-pinned" class="rounded accent-indigo-600" />
                  <span>Fijar nota al inicio (Pin)</span>
                </label>

                <div class="flex gap-2">
                  <button type="button" id="cancel-note-btn" class="px-3 py-1.5 theme-button text-xs font-semibold rounded-lg cursor-pointer">
                    Cancelar
                  </button>
                  <button type="submit" id="save-note-btn" class="px-4 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs rounded-lg transition-all shadow-md cursor-pointer">
                    Guardar
                  </button>
                </div>
              </div>
            </form>

            <!-- Lista de Notas Guardadas -->
            <div id="notes-list-container" class="grid grid-cols-1 gap-4 pt-2">
              <div class="p-6 text-center theme-button rounded-xl text-xs theme-text-secondary italic">
                Cargando notas de la bitácora...
              </div>
            </div>
          </div>
        </section>
      </div>
    </article>
  </main>

  <!-- MODAL PARA AÑADIR A LISTA PERSONALIZADA -->
  <div id="add-to-list-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="theme-card border w-[92vw] max-w-md rounded-2xl p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between border-b border-slate-500/20 pb-3">
        <h3 class="text-base font-bold theme-text-primary">Añadir a una Lista</h3>
        <button id="close-add-list-modal-btn" class="p-1 theme-text-secondary hover:theme-text-primary rounded-lg cursor-pointer">
          <X class="w-5 h-5" />
        </button>
      </div>

      <p class="text-xs theme-text-secondary">Selecciona las listas donde deseas incluir este videojuego:</p>

      <div id="user-lists-selection-container" class="space-y-2 max-h-60 overflow-y-auto py-2">
        <p class="text-xs theme-text-secondary italic text-center">Cargando tus listas...</p>
      </div>

      <div class="flex justify-end pt-2 border-t border-slate-500/20">
        <button type="button" id="cancel-add-list-modal-btn" class="px-4 py-2 theme-button border border-slate-500/20 text-xs font-semibold rounded-xl cursor-pointer">
          Cerrar
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';
  import { enqueueAction, processSyncQueue } from '../../lib/syncQueue';

  async function initGameDetail() {
    const cleanPath = window.location.pathname.replace(/\/$/, '');
    const pathParts = cleanPath.split('/');
    const gameId = pathParts[pathParts.length - 1];

    const skeleton = document.getElementById('loading-skeleton');
    const content = document.getElementById('game-content');
    const errorBox = document.getElementById('error-container');

    const coverEl = document.getElementById('game-cover') as HTMLImageElement;
    const titleEl = document.getElementById('game-title');
    const storeEl = document.getElementById('game-store');
    const platformEl = document.getElementById('game-platform');

    const statusSelect = document.getElementById('status-select') as HTMLSelectElement;
    const hoursInput = document.getElementById('hours-input') as HTMLInputElement;
    const achievementsInput = document.getElementById('achievements-input') as HTMLInputElement;
    const achievementsVal = document.getElementById('achievements-val');

    const ratingInput = document.getElementById('rating-input') as HTMLInputElement;
    const reviewInput = document.getElementById('review-input') as HTMLTextAreaElement;
    const notesInput = document.getElementById('notes-input') as HTMLTextAreaElement;

    const saveProgressBtn = document.getElementById('save-progress-btn') as HTMLButtonElement;
    const saveReviewBtn = document.getElementById('save-review-btn') as HTMLButtonElement;

    const tagsContainer = document.getElementById('tags-container');
    const newTagInput = document.getElementById('new-tag-input') as HTMLInputElement;
    const addTagBtn = document.getElementById('add-tag-btn');

    // Gamer Notebook
    const toggleNoteFormBtn = document.getElementById('toggle-note-form-btn');
    const createNoteForm = document.getElementById('create-note-form') as HTMLFormElement;
    const cancelNoteBtn = document.getElementById('cancel-note-btn');
    const noteTitleInput = document.getElementById('note-title') as HTMLInputElement;
    const noteCategorySelect = document.getElementById('note-category') as HTMLSelectElement;
    const noteContentInput = document.getElementById('note-content') as HTMLTextAreaElement;
    const noteImageUrlInput = document.getElementById('note-image-url') as HTMLInputElement;
    const notePinnedCheckbox = document.getElementById('note-pinned') as HTMLInputElement;
    const notesListContainer = document.getElementById('notes-list-container');

    // Modal Listas
    const addToListModal = document.getElementById('add-to-list-modal');
    const openAddToListBtn = document.getElementById('open-add-to-list-btn');
    const closeAddListModalBtn = document.getElementById('close-add-list-modal-btn');
    const cancelAddListModalBtn = document.getElementById('cancel-add-list-modal-btn');
    const userListsContainer = document.getElementById('user-lists-selection-container');

    let currentTags: string[] = [];
    let isFavorite = false;
    let loadedNotes: any[] = [];
    let editingNoteId: string | null = null;

    if (!gameId || gameId === 'game') {
      if (skeleton) skeleton.classList.add('hidden');
      if (errorBox) errorBox.classList.remove('hidden');
      return;
    }

    achievementsInput?.addEventListener('input', (e: any) => {
      if (achievementsVal) achievementsVal.textContent = `${e.target.value}%`;
    });

    // 1. Cargar Registro (Online con Fallback Offline)
    let data: any = null;
    const cacheKey = `kazechronik_game_${gameId}`;
    const notesCacheKey = `kazechronik_notes_${gameId}`;

    if (!navigator.onLine) {
      const cachedGame = localStorage.getItem(cacheKey);
      if (cachedGame) {
        try {
          data = JSON.parse(cachedGame);
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast('Bitácora cargada en Modo Offline', 'info');
          }
        } catch (e) {
          console.error('Error al leer caché del juego:', e);
        }
      }
    } else {
      processSyncQueue();
    }

    if (!data) {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) {
          window.location.href = '/login';
          return;
        }

        const res = await supabase
          .from('user_library')
          .select('*')
          .eq('id', gameId)
          .eq('user_id', session.user.id)
          .maybeSingle();

        if (res.error || !res.data) {
          throw new Error('Juego no encontrado');
        }

        data = res.data;
        localStorage.setItem(cacheKey, JSON.stringify(data));
      } catch (err) {
        const cachedGame = localStorage.getItem(cacheKey);
        if (cachedGame) {
          data = JSON.parse(cachedGame);
        } else {
          if (skeleton) skeleton.classList.add('hidden');
          if (errorBox) errorBox.classList.remove('hidden');
          return;
        }
      }
    }

    // 2. Poblar Datos y UI
    isFavorite = Boolean(data.is_favorite);
    
    function updateFavoriteUI() {
      const btn = document.getElementById('favorite-btn');
      const icon = document.getElementById('favorite-icon');
      const text = document.getElementById('favorite-text');
      
      if (!btn || !icon || !text) return;

      if (isFavorite) {
        btn.className = "px-3.5 py-2 rounded-xl text-xs font-semibold bg-amber-500/10 border border-amber-500/30 text-amber-400 transition-all cursor-pointer flex items-center gap-1.5 backdrop-blur-md";
        icon.textContent = "★";
        text.textContent = "Favorito";
      } else {
        btn.className = "px-3.5 py-2 rounded-xl text-xs font-semibold theme-button text-slate-200 border border-slate-500/20 transition-all cursor-pointer flex items-center gap-1.5 backdrop-blur-md";
        icon.textContent = "☆";
        text.textContent = "Añadir a Favoritos";
      }
    }

    updateFavoriteUI();

    document.getElementById('favorite-btn')?.addEventListener('click', () => {
      isFavorite = !isFavorite;
      updateFavoriteUI();
    });

    if (coverEl) coverEl.src = data.cover_url || '/placeholder.jpg';
    if (titleEl) titleEl.textContent = data.title;
    if (storeEl) storeEl.textContent = data.store || 'Biblioteca';
    if (platformEl) platformEl.textContent = data.platform || 'PC';

    if (statusSelect) statusSelect.value = data.status || 'backlog';
    if (hoursInput) hoursInput.value = data.hours_played || 0;
    if (achievementsInput) achievementsInput.value = data.achievements_progress || 0;
    if (achievementsVal) achievementsVal.textContent = `${data.achievements_progress || 0}%`;

    if (ratingInput) ratingInput.value = data.rating !== null && data.rating !== undefined ? data.rating : '';
    if (reviewInput) reviewInput.value = data.review || '';
    if (notesInput) notesInput.value = data.notes || '';

    currentTags = Array.isArray(data.tags) ? data.tags : [];
    
    function renderTags() {
      if (!tagsContainer) return;
      
      if (currentTags.length === 0) {
        tagsContainer.innerHTML = `<span class="text-[11px] theme-text-secondary italic">Sin etiquetas asignadas.</span>`;
        return;
      }

      tagsContainer.innerHTML = currentTags.map((tag, idx) => `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold rounded-lg">
          #${tag}
          <button type="button" onclick="removeTag(${idx})" class="hover:text-rose-400 cursor-pointer ml-1">×</button>
        </span>
      `).join('');
    }

    renderTags();

    (window as any).removeTag = (index: number) => {
      currentTags.splice(index, 1);
      renderTags();
    };

    addTagBtn?.addEventListener('click', () => {
      const val = newTagInput?.value.trim().replace(/^#/, '');
      if (val && !currentTags.includes(val)) {
        currentTags.push(val);
        newTagInput.value = '';
        renderTags();
      }
    });

    // --- MODAL DE LISTAS ---
    openAddToListBtn?.addEventListener('click', async () => {
      addToListModal?.classList.remove('hidden');
      await loadUserListsForSelection();
    });

    closeAddListModalBtn?.addEventListener('click', () => addToListModal?.classList.add('hidden'));
    cancelAddListModalBtn?.addEventListener('click', () => addToListModal?.classList.add('hidden'));

    async function loadUserListsForSelection() {
      if (!userListsContainer) return;

      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return;

      const { data: lists } = await supabase
        .from('custom_lists')
        .select('id, title')
        .eq('user_id', session.user.id);

      if (!lists || lists.length === 0) {
        userListsContainer.innerHTML = `
          <div class="text-center py-4 space-y-2">
            <p class="text-xs theme-text-secondary">No tienes listas creadas aún.</p>
            <a href="/lists" class="inline-block text-xs font-bold text-indigo-400 hover:underline">Crear mi primera lista →</a>
          </div>
        `;
        return;
      }

      const { data: existingItems } = await supabase
        .from('custom_list_items')
        .select('list_id')
        .eq('game_id', gameId);

      const existingListIds = (existingItems || []).map(i => i.list_id);

      userListsContainer.innerHTML = lists.map(list => {
        const isAdded = existingListIds.includes(list.id);
        return `
          <div class="flex items-center justify-between p-3 theme-card border rounded-xl">
            <span class="text-xs font-bold theme-text-primary truncate pr-2">${list.title}</span>
            <button 
              type="button"
              onclick="toggleGameInList('${list.id}', ${isAdded})"
              class="px-3 py-1 rounded-lg text-xs font-bold transition-all cursor-pointer ${isAdded ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20 hover:bg-rose-500/20' : 'bg-indigo-600 hover:bg-indigo-500 text-white'}"
            >
              ${isAdded ? 'Quitar' : '+ Añadir'}
            </button>
          </div>
        `;
      }).join('');
    }

    (window as any).toggleGameInList = async (listId: string, isCurrentlyAdded: boolean) => {
      if (!navigator.onLine) {
        if (isCurrentlyAdded) {
          enqueueAction('custom_list_items', 'DELETE', { list_id: listId, game_id: gameId });
        } else {
          enqueueAction('custom_list_items', 'INSERT', { list_id: listId, game_id: gameId });
        }
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Lista actualizada localmente (Modo Offline)', 'info');
        }
        addToListModal?.classList.add('hidden');
        return;
      }

      if (isCurrentlyAdded) {
        await supabase
          .from('custom_list_items')
          .delete()
          .eq('list_id', listId)
          .eq('game_id', gameId);

        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Juego removido de la lista', 'info');
        }
      } else {
        await supabase
          .from('custom_list_items')
          .insert([{ list_id: listId, game_id: gameId }]);

        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('¡Juego añadido a la lista!', 'success');
        }
      }

      await loadUserListsForSelection();
    };

    // --- GAMER NOTEBOOK (CON ENCOLE OFFLINE Y CHECKLISTS INTERACTIVAS) ---
    async function loadGameNotes() {
      if (!notesListContainer) return;

      if (!navigator.onLine) {
        const cachedNotes = localStorage.getItem(notesCacheKey);
        if (cachedNotes) {
          try {
            loadedNotes = JSON.parse(cachedNotes);
            renderNotesList();
            return;
          } catch (e) {
            console.error('Error al parsear notas en caché:', e);
          }
        }
      }

      try {
        const { data: notes, error } = await supabase
          .from('game_notes')
          .select('*')
          .eq('game_id', gameId)
          .order('is_pinned', { ascending: false })
          .order('created_at', { ascending: false });

        if (error) throw error;

        loadedNotes = notes || [];
        localStorage.setItem(notesCacheKey, JSON.stringify(loadedNotes));
        renderNotesList();
      } catch (err: any) {
        const cachedNotes = localStorage.getItem(notesCacheKey);
        if (cachedNotes) {
          loadedNotes = JSON.parse(cachedNotes);
          renderNotesList();
        } else {
          notesListContainer.innerHTML = `<div class="p-4 theme-button rounded-xl text-xs text-rose-400">Sin conexión y sin notas almacenadas en caché.</div>`;
        }
      }
    }

    function renderNotesList() {
      if (!notesListContainer) return;

      if (loadedNotes.length === 0) {
        notesListContainer.innerHTML = `
          <div class="p-6 text-center theme-button border border-dashed border-slate-500/20 rounded-xl">
            <p class="text-xs font-semibold theme-text-primary">No hay notas creadas aún</p>
            <p class="text-[11px] theme-text-secondary mt-1">Crea tu primera nota para guardar builds o ubicaciones de mapa.</p>
          </div>
        `;
        return;
      }

      const catBadges: Record<string, { label: string, color: string }> = {
        builds: { label: '🛡️ Build / Craft', color: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' },
        map: { label: '🗺️ Mapa', color: 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20' },
        puzzle: { label: '🧩 Puzle', color: 'bg-purple-500/10 text-purple-400 border-purple-500/20' },
        general: { label: '📝 General', color: 'bg-slate-500/10 text-slate-300 border-slate-500/20' }
      };

      notesListContainer.innerHTML = loadedNotes.map(n => {
        const cat = catBadges[n.category] || catBadges.general;
        
        const formattedContent = (n.content || '').split('\n').map((line: string) => {
          if (line.startsWith('[x]') || line.startsWith('[X]')) {
            return `<span class="line-through opacity-60 text-emerald-400 font-medium flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> ${line.replace(/^\[[xX]\]/, '').trim()}</span>`;
          }
          if (line.startsWith('[ ]')) {
            return `<span class="font-medium flex items-center gap-1.5"><span class="text-amber-400 font-bold">☐</span> ${line.replace(/^\[ \]/, '').trim()}</span>`;
          }
          return line;
        }).join('<br/>');

        return `
          <div class="theme-input border border-slate-500/20 rounded-2xl p-4 space-y-2 relative transition-all ${n.is_pinned ? 'border-amber-500/40 bg-amber-500/5 shadow-md' : 'shadow-sm'}">
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2 overflow-hidden">
                <span class="text-[10px] font-bold px-2 py-0.5 border rounded-md shrink-0 ${cat.color}">
                  ${cat.label}
                </span>
                <h4 class="text-sm font-bold theme-text-primary truncate">${n.title}</h4>
                ${n.is_pinned ? `<span class="text-amber-400 text-xs shrink-0" title="Nota fijada">📌</span>` : ''}
              </div>

              <div class="flex items-center gap-1 shrink-0">
                <button type="button" onclick="editNote('${n.id}')" class="p-1 hover:text-indigo-400 cursor-pointer text-xs theme-text-secondary" title="Editar Nota">
                  ✏️
                </button>
                <button type="button" onclick="togglePinNote('${n.id}', ${n.is_pinned})" class="p-1 hover:text-amber-400 cursor-pointer text-xs theme-text-secondary" title="Fijar/Desfijar">
                  ${n.is_pinned ? '📌' : '📍'}
                </button>
                <button type="button" onclick="deleteNote('${n.id}')" class="p-1 hover:text-rose-400 cursor-pointer text-xs text-rose-500/80" title="Eliminar">
                  🗑️
                </button>
              </div>
            </div>

            ${n.content ? `<div class="text-xs theme-text-secondary leading-relaxed theme-card p-3 rounded-xl border border-slate-500/20">${formattedContent}</div>` : ''}

            ${n.image_url ? `
              <div class="mt-2 rounded-xl overflow-hidden border border-slate-500/20 max-h-60 bg-slate-500/10">
                <img src="${n.image_url}" alt="Guía / Build" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300 cursor-pointer" onclick="window.open('${n.image_url}', '_blank')" />
              </div>
            ` : ''}
          </div>
        `;
      }).join('');
    }

    toggleNoteFormBtn?.addEventListener('click', () => {
      editingNoteId = null;
      createNoteForm.reset();
      const saveBtn = document.getElementById('save-note-btn');
      if (saveBtn) saveBtn.textContent = 'Guardar';
      createNoteForm.classList.toggle('hidden');
    });

    (window as any).editNote = (noteId: string) => {
      const note = loadedNotes.find(n => n.id === noteId);
      if (!note) return;

      editingNoteId = noteId;
      noteTitleInput.value = note.title || '';
      noteCategorySelect.value = note.category || 'general';
      noteContentInput.value = note.content || '';
      noteImageUrlInput.value = note.image_url || '';
      notePinnedCheckbox.checked = Boolean(note.is_pinned);

      const saveBtn = document.getElementById('save-note-btn');
      if (saveBtn) saveBtn.textContent = 'Actualizar Nota';

      createNoteForm.classList.remove('hidden');
      createNoteForm.scrollIntoView({ behavior: 'smooth' });
    };

    cancelNoteBtn?.addEventListener('click', () => {
      editingNoteId = null;
      createNoteForm.reset();
      createNoteForm.classList.add('hidden');
    });

    createNoteForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const title = noteTitleInput.value.trim();
      if (!title) return;

      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return;

      const noteData = {
        user_id: session.user.id,
        game_id: gameId,
        title: title,
        category: noteCategorySelect.value,
        content: noteContentInput.value.trim() || null,
        image_url: noteImageUrlInput.value.trim() || null,
        is_pinned: notePinnedCheckbox.checked,
        updated_at: new Date().toISOString()
      };

      if (!navigator.onLine) {
        if (editingNoteId) {
          const idx = loadedNotes.findIndex(n => n.id === editingNoteId);
          if (idx !== -1) loadedNotes[idx] = { ...loadedNotes[idx], ...noteData };
          enqueueAction('game_notes', 'UPDATE', { id: editingNoteId, ...noteData });
        } else {
          const tempId = `offline_${Date.now()}`;
          loadedNotes.unshift({ id: tempId, ...noteData });
          enqueueAction('game_notes', 'INSERT', noteData);
        }

        localStorage.setItem(notesCacheKey, JSON.stringify(loadedNotes));
        renderNotesList();
        createNoteForm.reset();
        createNoteForm.classList.add('hidden');
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Nota guardada localmente (se sincronizará al conectar)', 'info');
        }
        return;
      }

      let error;
      if (editingNoteId) {
        const res = await supabase.from('game_notes').update(noteData).eq('id', editingNoteId);
        error = res.error;
      } else {
        const res = await supabase.from('game_notes').insert([noteData]);
        error = res.error;
      }

      if (!error) {
        editingNoteId = null;
        createNoteForm.reset();
        createNoteForm.classList.add('hidden');
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Nota guardada en tu Gamer Notebook', 'success');
        }
        loadGameNotes();
      } else {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Error al guardar: ' + error.message, 'error');
        } else {
          alert('Error al guardar la nota: ' + error.message);
        }
      }
    });

    (window as any).togglePinNote = async (noteId: string, currentPinned: boolean) => {
      const note = loadedNotes.find(n => n.id === noteId);
      if (note) note.is_pinned = !currentPinned;
      localStorage.setItem(notesCacheKey, JSON.stringify(loadedNotes));
      renderNotesList();

      if (!navigator.onLine) {
        enqueueAction('game_notes', 'UPDATE', { id: noteId, is_pinned: !currentPinned });
        return;
      }

      await supabase
        .from('game_notes')
        .update({ is_pinned: !currentPinned })
        .eq('id', noteId);

      loadGameNotes();
    };

    (window as any).deleteNote = async (noteId: string) => {
      if (!confirm('¿Seguro que deseas eliminar esta nota?')) return;

      loadedNotes = loadedNotes.filter(n => n.id !== noteId);
      localStorage.setItem(notesCacheKey, JSON.stringify(loadedNotes));
      renderNotesList();

      if (!navigator.onLine) {
        enqueueAction('game_notes', 'DELETE', { id: noteId });
        return;
      }

      await supabase
        .from('game_notes')
        .delete()
        .eq('id', noteId);

      loadGameNotes();
    };

    document.title = `${data.title} | KazeChronik`;

    if (skeleton) skeleton.classList.add('hidden');
    if (content) content.classList.remove('hidden');

    loadGameNotes();

    // 3. LISTENERS DE GUARDADO PROGRESO Y RESEÑA (CON ENCOLE OFFLINE)
    saveProgressBtn?.addEventListener('click', async () => {
      saveProgressBtn.disabled = true;
      saveProgressBtn.innerHTML = `
        <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Guardando...</span>
      `;

      const updatedProgress = {
        status: statusSelect.value,
        hours_played: parseFloat(hoursInput.value) || 0,
        achievements_progress: parseInt(achievementsInput.value) || 0,
        tags: currentTags,
        is_favorite: isFavorite,
        updated_at: new Date().toISOString()
      };

      data = { ...data, ...updatedProgress };
      localStorage.setItem(cacheKey, JSON.stringify(data));

      if (!navigator.onLine) {
        enqueueAction('user_library', 'UPDATE', { id: gameId, ...updatedProgress });
        saveProgressBtn.disabled = false;
        saveProgressBtn.innerHTML = `<span>Guardar Cambios</span>`;
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Progreso guardado localmente (se sincronizará al conectar)', 'info');
        }
        return;
      }

      const { error } = await supabase
        .from('user_library')
        .update(updatedProgress)
        .eq('id', gameId);

      saveProgressBtn.disabled = false;
      saveProgressBtn.innerHTML = `<span>Guardar Cambios</span>`;

      if (!error) {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('¡Progreso guardado con éxito!', 'success');
        } else {
          alert('¡Progreso guardado!');
        }
      } else {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Error al guardar: ' + error.message, 'error');
        } else {
          alert('Error al guardar: ' + error.message);
        }
      }
    });

    saveReviewBtn?.addEventListener('click', async () => {
      saveReviewBtn.disabled = true;
      saveReviewBtn.innerHTML = `
        <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Guardando Bitácora...</span>
      `;

      const updatedReview = {
        rating: ratingInput.value ? parseFloat(ratingInput.value) : null,
        review: reviewInput.value.trim() || null,
        notes: notesInput.value.trim() || null,
        tags: currentTags,
        is_favorite: isFavorite,
        updated_at: new Date().toISOString()
      };

      data = { ...data, ...updatedReview };
      localStorage.setItem(cacheKey, JSON.stringify(data));

      if (!navigator.onLine) {
        enqueueAction('user_library', 'UPDATE', { id: gameId, ...updatedReview });
        saveReviewBtn.disabled = false;
        saveReviewBtn.innerHTML = `<span>Guardar Bitácora</span>`;
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Bitácora guardada localmente (se sincronizará al conectar)', 'info');
        }
        return;
      }

      const { error } = await supabase
        .from('user_library')
        .update(updatedReview)
        .eq('id', gameId);

      saveReviewBtn.disabled = false;
      saveReviewBtn.innerHTML = `<span>Guardar Bitácora</span>`;

      if (!error) {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('¡Bitácora guardada con éxito!', 'success');
        } else {
          alert('¡Bitácora guardada con éxito!');
        }
      } else {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Error al guardar: ' + error.message, 'error');
        } else {
          alert('Error al guardar bitácora: ' + error.message);
        }
      }
    });
  }

  initGameDetail();
  document.addEventListener('astro:page-load', initGameDetail);
</script>
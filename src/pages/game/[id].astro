    // --- LOGROS Y TROFEOS ---
    async function loadAchievements() {
      const isSteam = data.store === 'Steam' || data.rawg_id < 0;

      if (achievementsSubtitle) {
        achievementsSubtitle.textContent = isSteam 
          ? 'Sincronizado automáticamente desde la API de Steam.' 
          : 'Sugerencias de RAWG y checklist manual interactiva.';
      }

      const cached = localStorage.getItem(achievementsCacheKey);
      if (cached) {
        try {
          gameAchievements = JSON.parse(cached);
          renderAchievementsList();
        } catch (e) {}
      }

      if (!navigator.onLine) return;

      try {
        if (isSteam && data.rawg_id) {
          const appId = Math.abs(data.rawg_id);
          const userSteamId = localStorage.getItem('kazechronik_steam_id') || '';

          const res = await fetch(`/api/steam/achievements?appId=${appId}&steamId=${encodeURIComponent(userSteamId)}`);
          const resData = await res.json();

          if (resData.achievements && resData.achievements.length > 0) {
            gameAchievements = resData.achievements;
            localStorage.setItem(achievementsCacheKey, JSON.stringify(gameAchievements));
            renderAchievementsList();
            return;
          }
        }

        if (data.rawg_id && data.rawg_id > 0) {
          const rawgKey = 'c53a703142404772979238f656999353';
          const rawgRes = await fetch(`https://api.rawg.io/api/games/${data.rawg_id}/achievements?key=${rawgKey}`);
          const rawgData = await rawgRes.json();

          if (rawgData.results && rawgData.results.length > 0) {
            gameAchievements = rawgData.results.map((a: any) => ({
              id: a.id,
              title: a.name,
              description: a.description || 'Trofeo de la comunidad RAWG',
              icon: a.image,
              unlocked: false
            }));
            localStorage.setItem(achievementsCacheKey, JSON.stringify(gameAchievements));
            renderAchievementsList();
          }
        }
      } catch (err) {
        console.warn('Error obteniendo logros:', err);
      }
    }

    function renderAchievementsList() {
      if (!achievementsListContainer) return;

      if (gameAchievements.length === 0) {
        achievementsListContainer.innerHTML = `
          <div class="sm:col-span-2 p-6 text-center theme-button border border-dashed border-slate-500/20 rounded-xl text-xs theme-text-secondary">
            No hay trofeos o logros registrados para este título.
          </div>
        `;
        return;
      }

      const unlockedCount = gameAchievements.filter(a => a.unlocked).length;
      const totalCount = gameAchievements.length;
      const pct = Math.round((unlockedCount / totalCount) * 100);

      if (achievementsCountLabel) achievementsCountLabel.textContent = `${unlockedCount} / ${totalCount} Logros desbloqueados`;
      if (achievementsPctLabel) achievementsPctLabel.textContent = `${pct}%`;
      if (achievementsProgressBar) achievementsProgressBar.style.width = `${pct}%`;

      if (achievementsInput) achievementsInput.value = pct.toString();
      if (achievementsVal) achievementsVal.textContent = `${pct}%`;

      if (pct === 100) {
        platinumBadge?.classList.remove('hidden');
        platinumBadge?.classList.add('flex');
      } else {
        platinumBadge?.classList.add('hidden');
        platinumBadge?.classList.remove('flex');
      }

      achievementsListContainer.innerHTML = gameAchievements.map((ach, idx) => {
        const displayTitle = ach.title ? ach.title.replace(/_/g, ' ') : `Logro ${idx + 1}`;
        const iconSrc = ach.icon || defaultSvgFallback;

        return `
          <div 
            onclick="toggleAchievementUnlocked(${idx})"
            class="p-3 theme-input border rounded-xl flex items-center gap-3 transition-all cursor-pointer ${
              ach.unlocked 
                ? 'border-amber-500/40 bg-amber-500/5' 
                : 'border-slate-500/20 opacity-70 hover:opacity-100'
            }"
          >
            <img 
              src="${iconSrc}" 
              alt="${displayTitle}" 
              onerror="this.src='/placeholder.svg';"
              class="w-10 h-10 rounded-lg object-cover shrink-0 ${!ach.unlocked ? 'grayscale' : ''}"
              loading="lazy"
            />
            <div class="flex-1 min-w-0">
              <h4 class="text-xs font-bold theme-text-primary truncate flex items-center justify-between">
                <span>${displayTitle}</span>
                ${ach.unlocked ? '<span class="text-amber-400 text-xs">✓</span>' : ''}
              </h4>
              <p class="text-[10px] theme-text-secondary line-clamp-2 mt-0.5">${ach.description || 'Logro de jugador'}</p>
            </div>
          </div>
        `;
      }).join('');
    }

    (window as any).toggleAchievementUnlocked = (index: number) => {
      if (gameAchievements[index]) {
        gameAchievements[index].unlocked = !gameAchievements[index].unlocked;
        localStorage.setItem(achievementsCacheKey, JSON.stringify(gameAchievements));
        renderAchievementsList();
      }
    };

    syncAchievementsBtn?.addEventListener('click', () => {
      syncAchievementsBtn.classList.add('animate-spin');
      loadAchievements().finally(() => {
        syncAchievementsBtn.classList.remove('animate-spin');
      });
    });

    loadAchievements();

    // --- MODAL DE LISTAS ---
    openAddToListBtn?.addEventListener('click', async () => {
      addToListModal?.classList.remove('hidden');
      await loadUserListsForSelection();
    });

    closeAddListModalBtn?.addEventListener('click', () => addToListModal?.classList.add('hidden'));
    cancelAddListModalBtn?.addEventListener('click', () => addToListModal?.classList.add('hidden'));

    async function loadUserListsForSelection() {
      if (!userListsContainer) return;

      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return;

      const { data: lists } = await supabase
        .from('custom_lists')
        .select('id, title')
        .eq('user_id', session.user.id);

      if (!lists || lists.length === 0) {
        userListsContainer.innerHTML = `
          <div class="text-center py-4 space-y-2">
            <p class="text-xs theme-text-secondary">No tienes listas creadas aún.</p>
            <a href="/lists" class="inline-block text-xs font-bold text-indigo-400 hover:underline">Crear mi primera lista →</a>
          </div>
        `;
        return;
      }

      const { data: existingItems } = await supabase
        .from('custom_list_items')
        .select('list_id')
        .eq('game_id', gameId);

      const existingListIds = (existingItems || []).map(i => i.list_id);

      userListsContainer.innerHTML = lists.map(list => {
        const isAdded = existingListIds.includes(list.id);
        return `
          <div class="flex items-center justify-between p-3 theme-card border border-slate-500/20 rounded-xl">
            <span class="text-xs font-bold theme-text-primary truncate pr-2">${list.title}</span>
            <button 
              type="button"
              onclick="toggleGameInList('${list.id}', ${isAdded})"
              class="px-3 py-1 rounded-lg text-xs font-bold transition-all cursor-pointer ${isAdded ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20 hover:bg-rose-500/20' : 'bg-indigo-600 hover:bg-indigo-500 text-white'}"
            >
              ${isAdded ? 'Quitar' : '+ Añadir'}
            </button>
          </div>
        `;
      }).join('');
    }

    (window as any).toggleGameInList = async (listId: string, isCurrentlyAdded: boolean) => {
      if (!navigator.onLine) {
        if (isCurrentlyAdded) {
          enqueueAction('custom_list_items', 'DELETE', { list_id: listId, game_id: gameId });
        } else {
          enqueueAction('custom_list_items', 'INSERT', { list_id: listId, game_id: gameId });
        }
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Lista actualizada localmente (Modo Offline)', 'info');
        }
        addToListModal?.classList.add('hidden');
        return;
      }

      if (isCurrentlyAdded) {
        await supabase
          .from('custom_list_items')
          .delete()
          .eq('list_id', listId)
          .eq('game_id', gameId);

        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Juego removido de la lista', 'info');
        }
      } else {
        await supabase
          .from('custom_list_items')
          .insert([{ list_id: listId, game_id: gameId }]);

        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('¡Juego añadido a la lista!', 'success');
        }
      }

      await loadUserListsForSelection();
    };

    // --- GAMER NOTEBOOK (SUBIDA DE FOTOS, ENLACES ACTIVOS Y CHECKLISTS) ---
    noteImageFileInput?.addEventListener('change', (e: any) => {
      const file = e.target.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (event) => {
        currentNoteImageData = event.target?.result as string;
        if (noteImagePreview && noteImagePreviewContainer) {
          noteImagePreview.src = currentNoteImageData;
          noteImagePreviewContainer.classList.remove('hidden');
        }
        if (fileUploadLabel) fileUploadLabel.textContent = file.name;
      };
      reader.readAsDataURL(file);

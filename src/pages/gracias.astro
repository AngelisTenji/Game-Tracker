---
import Layout from '../layouts/Layout.astro';
---

<Layout title="¡Gracias! | KazeChronik">
  <main class="min-h-[70vh] flex flex-col items-center justify-center text-center px-6">
    <div class="w-16 h-16 bg-emerald-500/10 text-emerald-400 rounded-full flex items-center justify-center mb-6 text-3xl">
      ✓
    </div>
    <h1 class="text-3xl font-bold text-white mb-3">¡Muchas gracias!</h1>
    <p class="text-slate-400 max-w-md mb-8">
      Hemos recibido tu solicitud o acción correctamente. Tu experiencia en KazeChronik sigue mejorando cada día.
    </p>
    <a href="/" class="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg transition-colors">
      Volver al Inicio
    </a>
  </main>
</Layout>
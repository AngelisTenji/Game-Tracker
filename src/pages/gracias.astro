---
import Layout from '../layouts/Layout.astro';
import { Heart, Code2, Bot, Database, Sparkles, ArrowLeft } from 'lucide-astro';
---

<Layout title="¡Gracias! & Créditos | KazeChronik">
  <main class="min-h-[80vh] flex flex-col items-center justify-center text-center px-6 py-12 max-w-3xl mx-auto theme-text-primary">
    <!-- Icono de Éxito -->
    <div class="w-16 h-16 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 rounded-2xl flex items-center justify-center mb-6 text-3xl shadow-lg">
      ✓
    </div>

    <h1 class="text-3xl font-black tracking-tight mb-3">¡Muchas gracias!</h1>
    <p class="text-xs sm:text-sm theme-text-secondary max-w-md mb-8 leading-relaxed">
      Hemos recibido tu solicitud correctamente. Tu apoyo impulsa a KazeChronik a seguir creciendo como la mejor bitácora gamer.
    </p>

    <!-- TARJETA DE RECONOCIMIENTOS Y CRÉDITOS DEL PROYECTO -->
    <section class="w-full theme-card border border-slate-500/20 p-6 rounded-3xl text-left space-y-4 mb-8 shadow-sm">
      <div class="flex items-center gap-2 border-b border-slate-500/20 pb-3">
        <Sparkles class="w-5 h-5 text-indigo-400" />
        <h2 class="text-base font-bold theme-text-primary">Desarrollo & Créditos de KazeChronik</h2>
      </div>

      <p class="text-xs theme-text-secondary leading-relaxed">
        KazeChronik es un proyecto independiente enfocado en la transparencia, el rendimiento y la privacidad del usuario. Para hacer posible esta plataforma, se combinaron las siguientes tecnologías e inteligencias:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
        <div class="p-3 theme-input border border-slate-500/20 rounded-2xl flex items-center gap-3">
          <div class="p-2 bg-indigo-500/10 border border-indigo-500/20 rounded-xl text-indigo-400 shrink-0">
            <Code2 class="w-4 h-4" />
          </div>
          <div>
            <span class="block text-xs font-bold theme-text-primary">Desarrollador Principal</span>
            <span class="block text-[11px] theme-text-secondary">Ángel González (@AngelisTenji)</span>
          </div>
        </div>

        <div class="p-3 theme-input border border-slate-500/20 rounded-2xl flex items-center gap-3">
          <div class="p-2 bg-sky-500/10 border border-sky-500/20 rounded-xl text-sky-400 shrink-0">
            <Bot class="w-4 h-4" />
          </div>
          <div>
            <span class="block text-xs font-bold theme-text-primary">Co-Piloto & Asistencia IA</span>
            <span class="block text-[11px] theme-text-secondary">Gemini (Google DeepMind)</span>
          </div>
        </div>

        <div class="p-3 theme-input border border-slate-500/20 rounded-2xl flex items-center gap-3">
          <div class="p-2 bg-emerald-500/10 border border-emerald-500/20 rounded-xl text-emerald-400 shrink-0">
            <Database class="w-4 h-4" />
          </div>
          <div>
            <span class="block text-xs font-bold theme-text-primary">Servicios de Datos & APIs</span>
            <span class="block text-[11px] theme-text-secondary">Supabase, Steam API & RAWG</span>
          </div>
        </div>

        <div class="p-3 theme-input border border-slate-500/20 rounded-2xl flex items-center gap-3">
          <div class="p-2 bg-purple-500/10 border border-purple-500/20 rounded-xl text-purple-400 shrink-0">
            <Heart class="w-4 h-4" />
          </div>
          <div>
            <span class="block text-xs font-bold theme-text-primary">Comunidad Gamer</span>
            <span class="block text-[11px] theme-text-secondary">A todos los jugadores beta testers</span>
          </div>
        </div>
      </div>
    </section>

    <a 
      href="/" 
      class="px-6 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl transition-all shadow-lg shadow-indigo-600/20 flex items-center gap-2"
    >
      <ArrowLeft class="w-4 h-4" />
      <span>Volver al Inicio</span>
    </a>
  </main>
</Layout>
---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import { Gamepad2, Mail, Lock, LogIn } from 'lucide-astro';
---

<Layout title="Iniciar Sesión">
  <Navbar />

  <main class="flex-1 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md bg-slate-900/90 border border-slate-800 p-8 rounded-2xl shadow-xl backdrop-blur-sm">
      <div class="flex flex-col items-center mb-6">
        <div class="p-3 bg-indigo-600/10 border border-indigo-500/20 rounded-xl mb-3">
          <Gamepad2 class="w-8 h-8 text-indigo-400" />
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Bienvenido de nuevo</h2>
        <p class="text-sm text-slate-400 mt-1">Ingresa tus credenciales para acceder a tu biblioteca</p>
      </div>

      <form id="auth-form" class="space-y-4">
        <div>
          <label for="email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Correo Electrónico
          </label>
          <div class="relative">
            <Mail class="w-5 h-5 text-slate-500 absolute left-3 top-1/2 -translate-y-1/2" />
            <input
              type="email"
              id="email"
              required
              placeholder="tu@email.com"
              class="w-full pl-10 pr-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors text-sm"
            />
          </div>
        </div>

        <div>
          <label for="password" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Contraseña
          </label>
          <div class="relative">
            <Lock class="w-5 h-5 text-slate-500 absolute left-3 top-1/2 -translate-y-1/2" />
            <input
              type="password"
              id="password"
              required
              placeholder="••••••••"
              class="w-full pl-10 pr-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors text-sm"
            />
          </div>
        </div>

        <div id="error-message" class="hidden p-3 bg-red-500/10 border border-red-500/20 text-red-400 text-xs rounded-xl"></div>

        <div class="flex gap-3 pt-2">
          <button
            type="submit"
            id="btn-login"
            class="flex-1 flex items-center justify-center gap-2 py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm rounded-xl transition-all shadow-lg shadow-indigo-500/20 cursor-pointer"
          >
            <LogIn class="w-4 h-4" />
            <span>Iniciar Sesión</span>
          </button>
          
          <button
            type="button"
            id="btn-register"
            class="py-2.5 px-4 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-sm rounded-xl transition-colors cursor-pointer"
          >
            Registrarse
          </button>
        </div>
      </form>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('auth-form') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const btnRegister = document.getElementById('btn-register') as HTMLButtonElement;
  const errorMessage = document.getElementById('error-message') as HTMLDivElement;

  function showError(msg: string) {
    errorMessage.textContent = msg;
    errorMessage.classList.remove('hidden');
  }

  // Manejar Iniciar Sesión
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMessage.classList.add('hidden');

    const { data, error } = await supabase.auth.signInWithPassword({
      email: emailInput.value,
      password: passwordInput.value,
    });

    if (error) {
      showError(error.message);
    } else {
      window.location.href = '/dashboard';
    }
  });

  // Manejar Registro
  btnRegister?.addEventListener('click', async () => {
    errorMessage.classList.add('hidden');

    if (!emailInput.value || !passwordInput.value) {
      showError('Por favor, ingresa correo y contraseña.');
      return;
    }

    const { data, error } = await supabase.auth.signUp({
      email: emailInput.value,
      password: passwordInput.value,
    });

    if (error) {
      showError(error.message);
    } else {
      alert('¡Registro exitoso! Revisa tu correo o inicia sesión.');
    }
  });
</script>
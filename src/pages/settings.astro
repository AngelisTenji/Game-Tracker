---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import { 
  Palette, 
  Check, 
  Sun, 
  Moon, 
  Monitor, 
  Share2, 
  FileSpreadsheet, 
  HardDrive, 
  RefreshCw, 
  Trash2,
  Image,
  Lock,
  Download,
  Upload,
  UserCheck,
  Gamepad2,
  ExternalLink,
  Smartphone
} from 'lucide-astro';
---

<Layout title="Ajustes | KazeChronik">
  <Navbar />

  <main class="flex-1 max-w-xl w-full mx-auto px-4 py-8 space-y-6 theme-text-primary">
    <div class="mb-2">
      <h1 class="text-2xl font-bold tracking-tight">Ajustes</h1>
      <p class="text-xs theme-text-secondary mt-0.5">Personaliza la apariencia, perfil público, respaldos e integraciones</p>
    </div>

    <!-- SECCIÓN DE APARIENCIA -->
    <div class="theme-card border border-slate-500/20 rounded-2xl p-5 shadow-xl">
      <div class="flex items-center gap-3 mb-4 pb-3 border-b border-slate-500/20">
        <div class="p-2 bg-indigo-500/10 border border-indigo-500/20 rounded-xl text-indigo-500">
          <Palette class="w-4 h-4" />
        </div>
        <div>
          <h2 class="text-sm font-bold theme-text-primary">Tema Visual</h2>
          <p class="text-[11px] theme-text-secondary">Selecciona el esquema de colores de la interfaz</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <!-- Legacy Dark -->
        <button
          type="button"
          data-theme="legacy"
          class="theme-opt p-3 rounded-xl border border-slate-500/20 theme-card text-left transition-all relative flex flex-col justify-between h-24 cursor-pointer hover:border-indigo-500/50"
        >
          <div class="flex items-center justify-between">
            <Moon class="w-4 h-4 theme-text-secondary" />
            <span class="check-icon hidden text-indigo-500"><Check class="w-3.5 h-3.5" /></span>
          </div>
          <div>
            <span class="block text-xs font-bold theme-text-primary">Legacy Dark</span>
            <span class="block text-[10px] theme-text-secondary">Azul oscuro</span>
          </div>
        </button>

        <!-- Midnight Black -->
        <button
          type="button"
          data-theme="dark"
          class="theme-opt p-3 rounded-xl border border-slate-500/20 theme-card text-left transition-all relative flex flex-col justify-between h-24 cursor-pointer hover:border-indigo-500/50"
        >
          <div class="flex items-center justify-between">
            <Monitor class="w-4 h-4 theme-text-secondary" />
            <span class="check-icon hidden text-indigo-500"><Check class="w-3.5 h-3.5" /></span>
          </div>
          <div>
            <span class="block text-xs font-bold theme-text-primary">Midnight</span>
            <span class="block text-[10px] theme-text-secondary">Oscuro puro</span>
          </div>
        </button>

        <!-- Modo Claro -->
        <button
          type="button"
          data-theme="light"
          class="theme-opt p-3 rounded-xl border border-slate-500/20 theme-card text-left transition-all relative flex flex-col justify-between h-24 cursor-pointer hover:border-indigo-500/50"
        >
          <div class="flex items-center justify-between">
            <Sun class="w-4 h-4 theme-text-secondary" />
            <span class="check-icon hidden text-indigo-500"><Check class="w-3.5 h-3.5" /></span>
          </div>
          <div>
            <span class="block text-xs font-bold theme-text-primary">Modo Claro</span>
            <span class="block text-[10px] theme-text-secondary">Luminoso</span>
          </div>
        </button>
      </div>
    </div>

    <!-- SECCIÓN INSTALACIÓN PWA -->
    <section id="pwa-install-section" class="theme-card border border-slate-500/20 p-6 rounded-2xl space-y-4 shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-500/20 pb-3">
        <h2 class="font-bold text-base theme-text-primary flex items-center gap-2">
          <Smartphone class="w-4 h-4 text-indigo-400" />
          <span>Aplicación Nativa (PWA)</span>
        </h2>
        <span id="pwa-status-badge" class="px-2 py-0.5 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[10px] font-bold rounded-lg uppercase">
          Disponible
        </span>
      </div>

      <p class="text-xs theme-text-secondary leading-relaxed">
        Instala KazeChronik en tu escritorio o dispositivo móvil para acceder más rápido, usar pantalla completa y disfrutar de una experiencia fluida sin barras de navegador.
      </p>

      <div class="pt-1">
        <button 
          id="pwa-install-btn"
          type="button"
          class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl transition-all shadow-lg shadow-indigo-600/20 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <Download class="w-4 h-4" />
          <span>Instalar KazeChronik como App</span>
        </button>
      </div>
    </section>

    <!-- SECCIÓN IMPORTAR DESDE STEAM -->
    <section class="theme-card border border-slate-500/20 p-6 rounded-2xl space-y-4 shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-500/20 pb-3">
        <h2 class="font-bold text-base theme-text-primary flex items-center gap-2">
          <Gamepad2 class="w-4 h-4 text-sky-400" />
          <span>Sincronización con Steam</span>
        </h2>
        <span id="steam-status-badge" class="px-2 py-0.5 bg-slate-500/10 border border-slate-500/20 text-slate-400 text-[10px] font-bold rounded-lg uppercase">
          No Vinculado
        </span>
      </div>

      <p class="text-xs theme-text-secondary leading-relaxed">
        Ingresa tu **Steam Custom URL** o **SteamID64** para vincular tu cuenta y sincronizar juegos, horas jugadas y logros oficiales.
      </p>

      <div class="space-y-3">
        <div class="flex gap-2">
          <input 
            type="text" 
            id="steam-id-input" 
            placeholder="Ej: 76561198000000000 o tu alias de Steam" 
            class="flex-1 px-4 py-2.5 theme-input border rounded-xl text-xs focus:outline-none focus:border-indigo-500"
          />
          <button 
            type="button" 
            id="fetch-steam-btn" 
            class="px-4 py-2.5 bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs rounded-xl transition-all shadow-md shadow-sky-600/20 cursor-pointer flex items-center gap-1.5 shrink-0"
          >
            <span>Consultar Steam</span>
          </button>
        </div>

        <!-- Resultados de Consulta Steam -->
        <div id="steam-preview-box" class="hidden p-4 theme-input border border-slate-500/20 rounded-xl space-y-3">
          <div class="flex items-center justify-between text-xs font-bold border-b border-slate-500/20 pb-2">
            <span id="steam-count-text" class="text-sky-400">0 juegos encontrados</span>
            <button id="import-steam-confirmed-btn" type="button" class="px-3 py-1 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-lg shadow-sm cursor-pointer">
              Importar Todo a la Biblioteca
            </button>
          </div>
          <div id="steam-games-preview-list" class="max-h-40 overflow-y-auto space-y-1.5 text-xs text-slate-300">
            <!-- Inyectado dinámicamente -->
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN PERFIL PÚBLICO -->
    <section class="theme-card border border-slate-500/20 p-6 rounded-2xl space-y-4 shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-500/20 pb-3">
        <h2 class="font-bold text-base theme-text-primary flex items-center gap-2">
          <UserCheck class="w-4 h-4 text-indigo-400" />
          <span>Perfil Público</span>
        </h2>
        <button
          id="copy-profile-link-btn"
          type="button"
          class="px-3 py-1.5 bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/30 text-indigo-400 font-semibold text-xs rounded-xl transition-all flex items-center gap-1.5 cursor-pointer"
          title="Copiar enlace a tu perfil público"
        >
          <Share2 class="w-3.5 h-3.5" />
          <span id="copy-btn-text">Copiar Perfil</span>
        </button>
      </div>
      
      <form id="profile-form" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold theme-text-secondary mb-1">Nombre de Usuario (@username)</label>
          <input 
            type="text" 
            id="profile-username" 
            readonly 
            disabled
            class="w-full px-4 py-2.5 theme-input border rounded-xl text-sm font-bold theme-text-secondary opacity-60 cursor-not-allowed"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold theme-text-secondary mb-1">Nombre Visible</label>
          <input 
            type="text" 
            id="profile-display-name" 
            placeholder="ej: Ángel González"
            class="w-full px-4 py-2.5 theme-input border rounded-xl text-sm focus:outline-none focus:border-indigo-500"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold theme-text-secondary mb-1">Foto de Perfil (URL de imagen)</label>
          <input 
            type="url" 
            id="profile-avatar-url" 
            placeholder="https://ejemplo.com/mi-avatar.png"
            class="w-full px-4 py-2.5 theme-input border rounded-xl text-sm focus:outline-none focus:border-indigo-500"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold theme-text-secondary mb-1">Biografía</label>
          <textarea 
            id="profile-bio" 
            rows="3" 
            placeholder="Escribe algo sobre tus gustos en videojuegos..."
            class="w-full px-4 py-2.5 theme-input border rounded-xl text-sm focus:outline-none focus:border-indigo-500 resize-none"
          ></textarea>
        </div>

        <button 
          type="submit" 
          id="save-profile-btn"
          class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm rounded-xl transition-all shadow-lg shadow-indigo-600/20 cursor-pointer flex items-center justify-center gap-2"
        >
          <span>Guardar Perfil</span>
        </button>
      </form>
    </section>

    <!-- SECCIÓN ALMACENAMIENTO OFFLINE -->
    <section class="theme-card border border-slate-500/20 p-6 rounded-2xl space-y-4 shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-500/20 pb-3">
        <h2 class="font-bold text-base theme-text-primary flex items-center gap-2">
          <HardDrive class="w-4 h-4 text-emerald-400" />
          <span>Gestión Offline & Caché Local</span>
        </h2>
        <span id="cache-size-badge" class="px-2.5 py-0.5 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[10px] font-mono font-bold rounded-lg">
          Calculando...
        </span>
      </div>

      <p class="text-xs theme-text-secondary leading-relaxed">
        KazeChronik guarda tus juegos y bitácoras en tu dispositivo para que puedas consultarlos sin conexión a internet.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <button 
          id="sync-offline-btn"
          type="button"
          class="flex-1 py-2 px-3 theme-button hover:border-indigo-500/50 text-xs font-semibold rounded-xl border border-slate-500/20 transition-all flex items-center justify-center gap-1.5 cursor-pointer"
        >
          <RefreshCw class="w-3.5 h-3.5 text-indigo-400" />
          <span>Refrescar Caché</span>
        </button>

        <button 
          id="clear-cache-btn"
          type="button"
          class="py-2 px-3 bg-rose-500/10 hover:bg-rose-500/20 text-rose-500 border border-rose-500/20 text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-1.5 cursor-pointer"
        >
          <Trash2 class="w-3.5 h-3.5" />
          <span>Limpiar Caché</span>
        </button>
      </div>
    </section>

    <!-- SECCIÓN RESPALDOS & EXPORTACIÓN -->
    <section class="theme-card border border-slate-500/20 p-6 rounded-2xl space-y-4 shadow-sm">
      <h2 class="font-bold text-base border-b border-slate-500/20 pb-3 flex items-center gap-2 theme-text-primary">
        <Download class="w-4 h-4 text-sky-400" />
        <span>Copia de Seguridad & Exportación</span>
      </h2>
      <p class="text-xs theme-text-secondary">
        Respalda tu colección completa en JSON o expórtala en formato CSV compatible con Excel.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
        <button 
          id="export-backup-btn"
          type="button"
          class="px-3 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs rounded-xl transition-all shadow-lg shadow-indigo-600/20 cursor-pointer flex items-center justify-center gap-1.5"
        >
          <Download class="w-3.5 h-3.5 shrink-0" />
          <span>JSON</span>
        </button>

        <button 
          id="export-csv-btn"
          type="button"
          class="px-3 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs rounded-xl transition-all shadow-lg shadow-emerald-600/20 cursor-pointer flex items-center justify-center gap-1.5"
        >
          <FileSpreadsheet class="w-3.5 h-3.5 shrink-0" />
          <span>CSV (Excel)</span>
        </button>

        <label class="px-3 py-2.5 theme-button hover:border-indigo-500/50 theme-text-primary font-semibold text-xs rounded-xl transition-all cursor-pointer flex items-center justify-center gap-1.5 border border-slate-500/20 text-center">
          <Upload class="w-3.5 h-3.5 text-indigo-400 shrink-0" />
          <span>Restaurar</span>
          <input type="file" id="import-backup-input" accept=".json" class="hidden" />
        </label>
      </div>
    </section>

    <!-- SECCIÓN SEGURIDAD & CONTRASEÑA -->
    <section class="theme-card border border-slate-500/20 p-6 rounded-2xl space-y-4 shadow-sm">
      <h2 class="font-bold text-base border-b border-slate-500/20 pb-3 flex items-center gap-2 theme-text-primary">
        <Lock class="w-4 h-4 text-purple-400" />
        <span>Seguridad & Contraseña</span>
      </h2>
      
      <form id="password-form" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold theme-text-secondary mb-1">Nueva Contraseña</label>
          <input 
            type="password" 
            id="new-password" 
            required
            minlength="6"
            placeholder="••••••••"
            class="w-full px-4 py-2.5 theme-input border rounded-xl text-sm focus:outline-none focus:border-indigo-500"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold theme-text-secondary mb-1">Confirmar Nueva Contraseña</label>
          <input 
            type="password" 
            id="confirm-password" 
            required
            minlength="6"
            placeholder="••••••••"
            class="w-full px-4 py-2.5 theme-input border rounded-xl text-sm focus:outline-none focus:border-indigo-500"
          />
        </div>

        <button 
          type="submit" 
          id="change-password-btn"
          class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm rounded-xl transition-all shadow-lg shadow-indigo-600/20 cursor-pointer flex items-center justify-center gap-2"
        >
          <span>Actualizar Contraseña</span>
        </button>
      </form>
    </section>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { enqueueAction, processSyncQueue } from '../lib/syncQueue';

  let fetchedSteamGames: any[] = [];

  function initThemeSelector() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-opt');
    const currentTheme = localStorage.getItem('theme') || 'legacy';

    function applyActiveStyles(selectedBtn: HTMLButtonElement) {
      buttons.forEach(b => {
        b.classList.remove('border-2', 'border-indigo-500', 'ring-2', 'ring-indigo-500/20');
        b.classList.add('border');
        b.querySelector('.check-icon')?.classList.add('hidden');
      });

      selectedBtn.classList.remove('border');
      selectedBtn.classList.add('border-2', 'border-indigo-500', 'ring-2', 'ring-indigo-500/20');
      selectedBtn.querySelector('.check-icon')?.classList.remove('hidden');
    }

    const initialBtn = document.querySelector<HTMLButtonElement>(`.theme-opt[data-theme="${currentTheme}"]`);
    if (initialBtn) applyActiveStyles(initialBtn);

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        applyActiveStyles(btn);
        const selectedTheme = btn.getAttribute('data-theme') || 'legacy';
        localStorage.setItem('theme', selectedTheme);
        document.documentElement.setAttribute('data-theme', selectedTheme);
      });
    });
  }

  function calculateCacheSize() {
    let totalBytes = 0;
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (key && key.startsWith('kazechronik_')) {
        const val = localStorage.getItem(key) || '';
        totalBytes += key.length + val.length;
      }
    }
    const kb = (totalBytes / 1024).toFixed(1);
    const badge = document.getElementById('cache-size-badge');
    if (badge) badge.textContent = `${kb} KB almacenados`;
  }

  async function initSettingsPage() {
    initThemeSelector();
    calculateCacheSize();

    const usernameInput = document.getElementById('profile-username') as HTMLInputElement;
    const nameInput = document.getElementById('profile-display-name') as HTMLInputElement;
    const avatarUrlInput = document.getElementById('profile-avatar-url') as HTMLInputElement;
    const bioInput = document.getElementById('profile-bio') as HTMLTextAreaElement;
    const profileForm = document.getElementById('profile-form') as HTMLFormElement;
    const saveProfileBtn = document.getElementById('save-profile-btn') as HTMLButtonElement;

    const passwordForm = document.getElementById('password-form');
    const newPasswordInput = document.getElementById('new-password') as HTMLInputElement;
    const confirmPasswordInput = document.getElementById('confirm-password') as HTMLInputElement;
    const changePasswordBtn = document.getElementById('change-password-btn') as HTMLButtonElement;
    const copyProfileBtn = document.getElementById('copy-profile-link-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    // LÓGICA DE INSTALACIÓN PWA
    const pwaInstallBtn = document.getElementById('pwa-install-btn') as HTMLButtonElement;
    const pwaStatusBadge = document.getElementById('pwa-status-badge');

    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;

    if (isStandalone) {
      if (pwaStatusBadge) {
        pwaStatusBadge.textContent = 'App Instalada';
        pwaStatusBadge.className = 'px-2 py-0.5 bg-sky-500/10 border border-sky-500/20 text-sky-400 text-[10px] font-bold rounded-lg uppercase';
      }
      if (pwaInstallBtn) {
        pwaInstallBtn.disabled = true;
        pwaInstallBtn.innerHTML = `<span>✓ Estás utilizando KazeChronik App</span>`;
      }
    } else {
      function checkPwaPrompt() {
        if ((window as any).deferredPwaPrompt) {
          if (pwaInstallBtn) {
            pwaInstallBtn.disabled = false;
            pwaInstallBtn.innerHTML = `
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              <span>Instalar KazeChronik como App</span>
            `;
          }
        } else {
          if (pwaInstallBtn) {
            pwaInstallBtn.disabled = true;
            pwaInstallBtn.innerHTML = `<span>Instalación disponible desde el menú de tu navegador</span>`;
          }
        }
      }

      checkPwaPrompt();
      window.addEventListener('pwa-install-ready', checkPwaPrompt);

      pwaInstallBtn?.addEventListener('click', async () => {
        const promptEvent = (window as any).deferredPwaPrompt;
        if (!promptEvent) return;

        promptEvent.prompt();
        const { outcome } = await promptEvent.userChoice;

        if (outcome === 'accepted') {
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast('¡KazeChronik se está instalando en tu dispositivo!', 'success');
          }
          (window as any).deferredPwaPrompt = null;
          if (pwaInstallBtn) {
            pwaInstallBtn.disabled = true;
            pwaInstallBtn.innerHTML = `<span>✓ Instalación completada</span>`;
          }
        }
      });
    }

    // LÓGICA DE IMPORTACIÓN Y PERSISTENCIA DE STEAM
    const steamIdInput = document.getElementById('steam-id-input') as HTMLInputElement;
    const fetchSteamBtn = document.getElementById('fetch-steam-btn') as HTMLButtonElement;
    const steamPreviewBox = document.getElementById('steam-preview-box');
    const steamCountText = document.getElementById('steam-count-text');
    const steamGamesList = document.getElementById('steam-games-preview-list');
    const importSteamConfirmedBtn = document.getElementById('import-steam-confirmed-btn');
    const steamStatusBadge = document.getElementById('steam-status-badge');

    // Cargar Steam ID previo si existe
    const savedSteamId = localStorage.getItem('kazechronik_steam_id');
    if (savedSteamId) {
      if (steamIdInput) steamIdInput.value = savedSteamId;
      if (steamStatusBadge) {
        steamStatusBadge.textContent = 'Vinculado';
        steamStatusBadge.className = 'px-2 py-0.5 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[10px] font-bold rounded-lg uppercase';
      }
    }

    fetchSteamBtn?.addEventListener('click', async () => {
      const steamId = steamIdInput?.value.trim();
      if (!steamId) {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Ingresa tu SteamID o Custom URL de Steam', 'error');
        }
        return;
      }

      if (!navigator.onLine) {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('La consulta a la API de Steam requiere conexión a internet', 'error');
        }
        return;
      }

      fetchSteamBtn.disabled = true;
      fetchSteamBtn.innerHTML = `<span>Consultando...</span>`;

      try {
        const res = await fetch(`/api/steam/library?steamId=${encodeURIComponent(steamId)}`);
        const data = await res.json();
        
        // Guardar Steam ID en LocalStorage
        localStorage.setItem('kazechronik_steam_id', steamId);
        if (steamStatusBadge) {
          steamStatusBadge.textContent = 'Vinculado';
          steamStatusBadge.className = 'px-2 py-0.5 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[10px] font-bold rounded-lg uppercase';
        }

        fetchSteamBtn.disabled = false;
        fetchSteamBtn.innerHTML = `<span>Consultar Steam</span>`;

        if (!data || !data.games || data.games.length === 0) {
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast('No se encontraron juegos. Asegúrate de que tu perfil de Steam sea público.', 'error');
          }
          return;
        }

        fetchedSteamGames = data.games;
        if (steamCountText) steamCountText.textContent = `${fetchedSteamGames.length} juegos encontrados en Steam`;

        if (steamGamesList) {
          steamGamesList.innerHTML = fetchedSteamGames.slice(0, 15).map(g => `
            <div class="flex justify-between items-center py-1 border-b border-slate-500/10">
              <span class="truncate pr-2 font-semibold theme-text-primary">${g.name}</span>
              <span class="text-[10px] font-mono text-indigo-400 font-bold shrink-0">${g.hours_played} hrs</span>
            </div>
          `).join('');

          if (fetchedSteamGames.length > 15) {
            steamGamesList.innerHTML += `<p class="text-[10px] theme-text-secondary italic pt-1">...y ${fetchedSteamGames.length - 15} títulos más.</p>`;
          }
        }

        steamPreviewBox?.classList.remove('hidden');

      } catch (err) {
        console.error(err);
        fetchSteamBtn.disabled = false;
        fetchSteamBtn.innerHTML = `<span>Consultar Steam</span>`;
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Error al conectar con la API de Steam', 'error');
        }
      }
    });

    importSteamConfirmedBtn?.addEventListener('click', async () => {
      if (fetchedSteamGames.length === 0) return;

      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return;

      importSteamConfirmedBtn.setAttribute('disabled', 'true');
      importSteamConfirmedBtn.textContent = 'Importando...';

      const normalizeTitle = (str: string) => 
        str.toLowerCase().replace(/[^a-z0-9]/g, '').trim();

      let existingRawgIds = new Set<number>();
      let existingTitles = new Set<string>();

      if (navigator.onLine) {
        const { data: existingGames } = await supabase
          .from('user_library')
          .select('rawg_id, title')
          .eq('user_id', session.user.id);

        if (existingGames) {
          existingGames.forEach(g => {
            if (g.rawg_id) existingRawgIds.add(g.rawg_id);
            if (g.title) existingTitles.add(normalizeTitle(g.title));
          });
        }
      } else {
        const cached = localStorage.getItem('kazechronik_library_cache');
        if (cached) {
          const localGames = JSON.parse(cached);
          localGames.forEach((g: any) => {
            if (g.rawg_id) existingRawgIds.add(g.rawg_id);
            if (g.title) existingTitles.add(normalizeTitle(g.title));
          });
        }
      }

      const newGamesToInsert = fetchedSteamGames
        .filter(g => {
          const syntheticId = -Math.abs(Number(g.app_id));
          const normalizedSteamTitle = normalizeTitle(g.name);

          const isDuplicateId = existingRawgIds.has(syntheticId);
          const isDuplicateTitle = existingTitles.has(normalizedSteamTitle);

          return !isDuplicateId && !isDuplicateTitle;
        })
        .map(g => ({
          user_id: session.user.id,
          rawg_id: -Math.abs(Number(g.app_id)),
          title: g.name,
          cover_url: g.cover_url || g.fallback_cover_url || '/placeholder.jpg',
          platform: 'PC',
          store: 'Steam',
          status: g.hours_played > 0 ? 'playing' : 'backlog',
          hours_played: Number(g.hours_played) || 0,
          achievements_progress: 0,
          created_at: new Date().toISOString()
        }));

      if (newGamesToInsert.length === 0) {
        importSteamConfirmedBtn.removeAttribute('disabled');
        importSteamConfirmedBtn.textContent = 'Importar Todo a la Biblioteca';
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Todos tus juegos de Steam ya existen en tu biblioteca (RAWG o Manuales).', 'info');
        }
        return;
      }

      if (!navigator.onLine) {
        newGamesToInsert.forEach(gamePayload => {
          enqueueAction('user_library', 'INSERT', gamePayload);
        });

        const cached = localStorage.getItem('kazechronik_library_cache');
        let localGames = cached ? JSON.parse(cached) : [];
        localGames = [...newGamesToInsert, ...localGames];
        localStorage.setItem('kazechronik_library_cache', JSON.stringify(localGames));

        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast(`¡${newGamesToInsert.length} juegos nuevos importados localmente!`, 'info');
        }
        window.location.href = '/dashboard';
        return;
      }

      const { error } = await supabase
        .from('user_library')
        .insert(newGamesToInsert);

      importSteamConfirmedBtn.removeAttribute('disabled');
      importSteamConfirmedBtn.textContent = 'Importar Todo a la Biblioteca';

      if (!error) {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast(`¡${newGamesToInsert.length} juegos nuevos de Steam agregados sin duplicar!`, 'success');
        }
        window.location.href = '/dashboard';
      } else {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Error al importar desde Steam: ' + error.message, 'error');
        }
      }
    });

    // Cargar en Modo Offline si no hay red
    if (!navigator.onLine) {
      const cachedProfile = localStorage.getItem('kazechronik_profile_cache');
      if (cachedProfile) {
        try {
          const p = JSON.parse(cachedProfile);
          if (usernameInput) usernameInput.value = p.username || '';
          if (nameInput) nameInput.value = p.display_name || '';
          if (avatarUrlInput) avatarUrlInput.value = p.avatar_url || '';
          if (bioInput) bioInput.value = p.bio || '';
        } catch (e) { console.error(e); }
      }
      return;
    } else {
      processSyncQueue();
    }

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.location.href = '/login';
      return;
    }

    // Obtener perfil
    const { data: profile } = await supabase
      .from('profiles')
      .select('*')
      .eq('id', session.user.id)
      .maybeSingle();

    if (profile) {
      if (usernameInput) usernameInput.value = profile.username || '';
      if (nameInput) nameInput.value = profile.display_name || '';
      if (avatarUrlInput) avatarUrlInput.value = profile.avatar_url || '';
      if (bioInput) bioInput.value = profile.bio || '';

      localStorage.setItem('kazechronik_profile_cache', JSON.stringify(profile));
    }

    // Copiar Enlace
    copyProfileBtn?.addEventListener('click', () => {
      const username = usernameInput.value;
      if (!username) return;

      const profileUrl = `${window.location.origin}/u/${username}`;
      navigator.clipboard.writeText(profileUrl).then(() => {
        if (copyBtnText) copyBtnText.textContent = '¡Copiado!';
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Enlace de perfil copiado al portapapeles', 'success');
        }
        setTimeout(() => { if (copyBtnText) copyBtnText.textContent = 'Copiar Perfil'; }, 2000);
      });
    });

    // Guardar Perfil
    profileForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const updateData = {
        display_name: nameInput.value.trim() || usernameInput.value,
        avatar_url: avatarUrlInput.value.trim() || null,
        bio: bioInput.value.trim() || null,
        updated_at: new Date().toISOString()
      };

      if (!navigator.onLine) {
        localStorage.setItem('kazechronik_profile_cache', JSON.stringify({ ...profile, ...updateData }));
        enqueueAction('profiles', 'UPDATE', { id: session.user.id, ...updateData });
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Perfil guardado localmente (se sincronizará al conectar)', 'info');
        }
        return;
      }

      saveProfileBtn.disabled = true;
      saveProfileBtn.innerHTML = `<span>Guardando...</span>`;

      const { error } = await supabase
        .from('profiles')
        .update(updateData)
        .eq('id', session.user.id);

      saveProfileBtn.disabled = false;
      saveProfileBtn.innerHTML = `<span>Guardar Perfil</span>`;

      if (error) {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Error al actualizar: ' + error.message, 'error');
        } else {
          alert('Error al actualizar: ' + error.message);
        }
      } else {
        localStorage.setItem('kazechronik_profile_cache', JSON.stringify({ ...profile, ...updateData }));
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('¡Perfil actualizado con éxito!', 'success');
        } else {
          alert('¡Perfil actualizado con éxito!');
        }
      }
    });

    // Cambiar Contraseña
    passwordForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (newPasswordInput.value !== confirmPasswordInput.value) {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Las contraseñas no coinciden.', 'error');
        } else {
          alert('Las contraseñas no coinciden.');
        }
        return;
      }

      changePasswordBtn.disabled = true;
      changePasswordBtn.innerHTML = `<span>Actualizando...</span>`;

      const { error } = await supabase.auth.updateUser({ password: newPasswordInput.value });

      changePasswordBtn.disabled = false;
      changePasswordBtn.innerHTML = `<span>Actualizar Contraseña</span>`;

      if (error) {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Error: ' + error.message, 'error');
        } else {
          alert('Error: ' + error.message);
        }
      } else {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('¡Contraseña actualizada correctamente!', 'success');
        } else {
          alert('¡Contraseña actualizada correctamente!');
        }
        newPasswordInput.value = '';
        confirmPasswordInput.value = '';
      }
    });

    // Refrescar Caché
    document.getElementById('sync-offline-btn')?.addEventListener('click', async () => {
      const { data: games } = await supabase
        .from('user_library')
        .select('*')
        .eq('user_id', session.user.id);

      if (games) {
        localStorage.setItem('kazechronik_library_cache', JSON.stringify(games));
        calculateCacheSize();
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Caché local sincronizada con la base de datos', 'success');
        }
      }
    });

    // Limpiar Caché Local
    document.getElementById('clear-cache-btn')?.addEventListener('click', () => {
      Object.keys(localStorage).forEach(key => {
        if (key.startsWith('kazechronik_')) {
          localStorage.removeItem(key);
        }
      });
      calculateCacheSize();
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Caché local eliminada correctamente', 'info');
      }
    });

    // Exportar Backup JSON
    document.getElementById('export-backup-btn')?.addEventListener('click', async () => {
      const { data: games } = await supabase
        .from('user_library')
        .select('*')
        .eq('user_id', session.user.id);

      if (!games) return;

      const backupData = {
        app: 'KazeChronik',
        version: '1.0',
        exported_at: new Date().toISOString(),
        total_games: games.length,
        library: games
      };

      const jsonStr = JSON.stringify(backupData, null, 2);
      const blob = new Blob([jsonStr], { type: 'application/json' });
      const url = URL.createObjectURL(blob);

      const a = document.createElement('a');
      a.href = url;
      a.download = `kazechronik-backup-${new Date().toISOString().slice(0, 10)}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    // Exportar CSV
    document.getElementById('export-csv-btn')?.addEventListener('click', async () => {
      const { data: games } = await supabase
        .from('user_library')
        .select('*')
        .eq('user_id', session.user.id);

      if (!games || games.length === 0) return;

      const headers = ['Título', 'Plataforma', 'Tienda', 'Estado', 'Horas Jugadas', 'Calificación', 'Favorito', 'Reseña'];
      const rows = games.map(g => [
        `"${(g.title || '').replace(/"/g, '""')}"`,
        `"${(g.platform || 'PC').replace(/"/g, '""')}"`,
        `"${(g.store || 'Otra').replace(/"/g, '""')}"`,
        `"${g.status || 'backlog'}"`,
        g.hours_played || 0,
        g.rating || 'N/A',
        g.is_favorite ? 'Sí' : 'No',
        `"${(g.review || '').replace(/"/g, '""')}"`
      ]);

      const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);

      const a = document.createElement('a');
      a.href = url;
      a.download = `kazechronik-biblioteca-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    // Importar Backup JSON (Soporte Offline con Queue)
    const importInput = document.getElementById('import-backup-input') as HTMLInputElement;
    importInput?.addEventListener('change', async (e: any) => {
      const file = e.target.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = async (event) => {
        try {
          const content = JSON.parse(event.target?.result as string);
          const gamesToImport = content.library || content;

          if (!Array.isArray(gamesToImport)) return;

          if (!confirm(`Se van a importar ${gamesToImport.length} juegos a tu cuenta. ¿Deseas continuar?`)) return;

          const preparedGames = gamesToImport.map(g => ({
            user_id: session.user.id,
            title: g.title,
            cover_url: g.cover_url || null,
            platform: g.platform || 'PC',
            store: g.store || 'Otra',
            status: g.status || 'backlog',
            hours_played: Number(g.hours_played) || 0,
            rating: g.rating ? Number(g.rating) : null,
            review: g.review || null,
            notes: g.notes || null,
            tags: Array.isArray(g.tags) ? g.tags : [],
            is_favorite: Boolean(g.is_favorite),
            updated_at: new Date().toISOString()
          }));

          if (!navigator.onLine) {
            preparedGames.forEach(gamePayload => {
              enqueueAction('user_library', 'INSERT', gamePayload);
            });
            if (typeof (window as any).showToast === 'function') {
              (window as any).showToast('¡Respaldo importado localmente! Se sincronizará al conectar.', 'info');
            }
            window.location.href = '/dashboard';
            return;
          }

          const { error } = await supabase.from('user_library').insert(preparedGames);

          if (!error) {
            if (typeof (window as any).showToast === 'function') {
              (window as any).showToast('¡Copia de seguridad restaurada con éxito!', 'success');
            }
            window.location.href = '/dashboard';
          }
        } catch (err) {
          console.error(err);
        }
      };
      reader.readAsText(file);
    });
  }

  initSettingsPage();
  document.addEventListener('astro:page-load', initSettingsPage);
</script>
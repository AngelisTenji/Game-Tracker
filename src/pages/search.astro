---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import { Search as SearchIcon, Loader2, X, Star, Filter, Gamepad2, Users, User, ExternalLink } from 'lucide-astro';
---

<Layout title="Búsqueda Unificada | KazeChronik">
  <Navbar />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-8">
    
    <!-- Encabezado y Selector de Pestañas (Juegos vs Perfiles) -->
    <div class="max-w-2xl mx-auto text-center mb-8 space-y-4">
      <h1 class="text-3xl font-bold theme-text-primary tracking-tight">Centro de Búsqueda</h1>
      <p class="text-sm theme-text-secondary">Encuentra videojuegos para tu colección o descubre perfiles de la comunidad</p>

      <!-- Botones de Pestaña -->
      <div class="inline-flex p-1 theme-card border rounded-2xl gap-1 shadow-sm">
        <button
          id="tab-btn-games"
          class="flex items-center gap-2 px-5 py-2 rounded-xl text-xs font-bold transition-all bg-indigo-600 text-white shadow-md cursor-pointer"
        >
          <Gamepad2 class="w-4 h-4" />
          <span>Videojuegos</span>
        </button>

        <button
          id="tab-btn-users"
          class="flex items-center gap-2 px-5 py-2 rounded-xl text-xs font-bold transition-all theme-button theme-text-secondary hover:theme-text-primary cursor-pointer"
        >
          <Users class="w-4 h-4" />
          <span>Perfiles Comunidad</span>
        </button>
      </div>
    </div>

    <!-- SECCIÓN 1: BÚSQUEDA DE JUEGOS (RAWG) -->
    <section id="section-games" class="space-y-8">
      <form id="search-form" class="max-w-2xl mx-auto space-y-4">
        <div class="relative">
          <SearchIcon class="w-5 h-5 theme-text-secondary absolute left-4 top-1/2 -translate-y-1/2" />
          <input
            type="text"
            id="search-input"
            placeholder="Ej: Genshin Impact, Assassin's Creed, Minecraft..."
            class="w-full pl-11 pr-24 py-3 theme-card border theme-text-primary placeholder:theme-text-secondary rounded-2xl text-sm focus:outline-none focus:border-indigo-500 transition-colors shadow-sm"
          />
          <button
            type="submit"
            class="absolute right-2 top-1/2 -translate-y-1/2 px-4 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-xl transition-all cursor-pointer shadow-md hover:scale-[1.02] active:scale-[0.98]"
          >
            Buscar
          </button>
        </div>

        <!-- Filtros Secundarios de RAWG -->
        <div class="flex flex-wrap items-center justify-center gap-2.5 pt-2">
          <div class="flex items-center gap-1 text-xs theme-text-secondary font-semibold mr-1">
            <Filter class="w-3.5 h-3.5 text-indigo-400" />
            <span>Filtros:</span>
          </div>

          <select id="rawg-genre" class="px-3 py-1.5 theme-card border rounded-xl text-xs theme-text-primary focus:outline-none focus:border-indigo-500 cursor-pointer shadow-sm">
            <option value="">Todos los géneros</option>
            <option value="action">Acción</option>
            <option value="role-playing-games-rpg">RPG</option>
            <option value="shooter">Shooter</option>
            <option value="adventure">Aventura</option>
            <option value="strategy">Estrategia</option>
            <option value="indie">Indie</option>
            <option value="puzzle">Puzle</option>
            <option value="simulation">Simulación</option>
            <option value="sports">Deportes</option>
          </select>

          <select id="rawg-platform" class="px-3 py-1.5 theme-card border rounded-xl text-xs theme-text-primary focus:outline-none focus:border-indigo-500 cursor-pointer shadow-sm">
            <option value="">Todas las plataformas</option>
            <option value="4">PC</option>
            <option value="187">PlayStation 5</option>
            <option value="18">PlayStation 4</option>
            <option value="186">Xbox Series X/S</option>
            <option value="1">Xbox One</option>
            <option value="7">Nintendo Switch</option>
            <option value="21">Android</option>
            <option value="3">iOS</option>
          </select>

          <select id="rawg-ordering" class="px-3 py-1.5 theme-card border rounded-xl text-xs theme-text-primary focus:outline-none focus:border-indigo-500 cursor-pointer shadow-sm">
            <option value="-relevance">Relevancia</option>
            <option value="-added">Más Populares</option>
            <option value="-rating">Mejor Valorados</option>
            <option value="-released">Lanzamientos Recientes</option>
          </select>
        </div>
      </form>

      <div id="results-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"></div>
    </section>

    <!-- SECCIÓN 2: BÚSQUEDA DE PERFILES (SUPABASE PROFILES) -->
    <section id="section-users" class="space-y-8 hidden">
      <div class="max-w-2xl mx-auto relative">
        <Users class="w-5 h-5 theme-text-secondary absolute left-4 top-1/2 -translate-y-1/2" />
        <input
          type="text"
          id="search-users-input"
          placeholder="Buscar por nombre de usuario o gamer tag..."
          class="w-full pl-11 pr-4 py-3 theme-card border theme-text-primary placeholder:theme-text-secondary rounded-2xl text-sm focus:outline-none focus:border-indigo-500 transition-colors shadow-sm"
        />
      </div>

      <div id="users-results-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6"></div>
    </section>

  </main>

  <!-- MODAL PARA AGREGAR JUEGO -->
  <div id="add-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="theme-card border w-[92vw] max-w-md rounded-2xl p-6 shadow-2xl relative overflow-hidden">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-500/20">
        <h3 id="modal-title" class="text-lg font-bold theme-text-primary truncate">Agregar a la Biblioteca</h3>
        <button id="close-modal-btn" class="p-1 theme-text-secondary hover:theme-text-primary rounded-lg hover:bg-slate-500/10 transition-colors">
          <X class="w-5 h-5" />
        </button>
      </div>

      <form id="add-form" class="space-y-4">
        <input type="hidden" id="modal-rawg-id" />
        <input type="hidden" id="modal-game-name" />
        <input type="hidden" id="modal-cover-url" />

        <div>
          <label class="block text-xs font-semibold theme-text-secondary uppercase tracking-wider mb-2">Plataforma</label>
          <div class="w-full overflow-x-hidden">
            <select id="modal-platform" class="w-full max-w-full px-3 py-2.5 theme-input border rounded-xl theme-text-primary text-sm focus:outline-none focus:border-indigo-500 truncate cursor-pointer">
              <option value="PC">PC</option>
              <option value="PS5">PlayStation 5</option>
              <option value="PS4">PlayStation 4</option>
              <option value="Xbox Series X/S">Xbox Series X/S</option>
              <option value="Xbox One">Xbox One</option>
              <option value="Nintendo Switch">Nintendo Switch</option>
              <option value="Android">Android</option>
              <option value="iOS">iOS</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold theme-text-secondary uppercase tracking-wider mb-2">Tienda / Distribución</label>
          <div class="w-full overflow-x-hidden">
            <select id="modal-store" class="w-full max-w-full px-3 py-2.5 theme-input border rounded-xl theme-text-primary text-sm focus:outline-none focus:border-indigo-500 truncate cursor-pointer">
              <option value="Steam">Steam</option>
              <option value="Epic Games">Epic Games</option>
              <option value="Microsoft Store">Microsoft Store</option>
              <option value="GOG">GOG</option>
              <option value="PlayStation Store">PlayStation Store</option>
              <option value="Nintendo eShop">Nintendo eShop</option>
              <option value="Xbox Store">Xbox Store</option>
              <option value="Google Play">Google Play</option>
              <option value="App Store">App Store</option>
              <option value="Otro">Otro / Físico</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold theme-text-secondary uppercase tracking-wider mb-2">Estado Inicial</label>
          <div class="w-full overflow-x-hidden">
            <select id="modal-status" class="w-full max-w-full px-3 py-2.5 theme-input border rounded-xl theme-text-primary text-sm focus:outline-none focus:border-indigo-500 truncate cursor-pointer">
              <option value="backlog">Pendiente (Backlog)</option>
              <option value="playing">Jugando</option>
              <option value="completed">Completado</option>
              <option value="on_hold">En Pausa</option>
              <option value="dropped">Abandonado</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold theme-text-secondary uppercase tracking-wider mb-2">Horas Iniciales</label>
            <input 
              type="number" 
              id="modal-hours" 
              min="0" 
              step="0.5" 
              placeholder="0" 
              class="w-full px-3 py-2.5 theme-input border rounded-xl theme-text-primary text-sm focus:outline-none focus:border-indigo-500" 
            />
          </div>

          <div class="flex items-end pb-2">
            <label class="flex items-center gap-2 cursor-pointer select-none">
              <input type="checkbox" id="modal-favorite" class="rounded accent-amber-400 w-4 h-4 cursor-pointer" />
              <span class="text-xs font-semibold theme-text-primary flex items-center gap-1">
                <Star class="w-3.5 h-3.5 text-amber-400 fill-amber-400" /> Favorito
              </span>
            </label>
          </div>
        </div>

        <div class="flex gap-3 pt-2">
          <button type="button" id="cancel-modal-btn" class="flex-1 py-2.5 px-4 theme-button border hover:bg-slate-500/10 theme-text-secondary text-sm font-semibold rounded-xl transition-colors">
            Cancelar
          </button>
          <button type="submit" id="save-add-btn" class="flex-1 py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl transition-all shadow-lg shadow-indigo-500/20 cursor-pointer flex items-center justify-center gap-2">
            <span>Guardar</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  // CONTROL DE PESTAÑAS
  const tabBtnGames = document.getElementById('tab-btn-games') as HTMLButtonElement;
  const tabBtnUsers = document.getElementById('tab-btn-users') as HTMLButtonElement;
  const sectionGames = document.getElementById('section-games') as HTMLElement;
  const sectionUsers = document.getElementById('section-users') as HTMLElement;

  tabBtnGames?.addEventListener('click', () => {
    tabBtnGames.className = "flex items-center gap-2 px-5 py-2 rounded-xl text-xs font-bold transition-all bg-indigo-600 text-white shadow-md cursor-pointer";
    tabBtnUsers.className = "flex items-center gap-2 px-5 py-2 rounded-xl text-xs font-bold transition-all theme-button theme-text-secondary hover:theme-text-primary cursor-pointer";
    sectionGames.classList.remove('hidden');
    sectionUsers.classList.add('hidden');
  });

  tabBtnUsers?.addEventListener('click', () => {
    tabBtnUsers.className = "flex items-center gap-2 px-5 py-2 rounded-xl text-xs font-bold transition-all bg-indigo-600 text-white shadow-md cursor-pointer";
    tabBtnGames.className = "flex items-center gap-2 px-5 py-2 rounded-xl text-xs font-bold transition-all theme-button theme-text-secondary hover:theme-text-primary cursor-pointer";
    sectionUsers.classList.remove('hidden');
    sectionGames.classList.add('hidden');
    executeUsersSearch();
  });

  // BÚSQUEDA DE JUEGOS (RAWG)
  const form = document.getElementById('search-form') as HTMLFormElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsGrid = document.getElementById('results-grid') as HTMLDivElement;

  const genreSelect = document.getElementById('rawg-genre') as HTMLSelectElement;
  const platformFilterSelect = document.getElementById('rawg-platform') as HTMLSelectElement;
  const orderingSelect = document.getElementById('rawg-ordering') as HTMLSelectElement;

  const modal = document.getElementById('add-modal') as HTMLDivElement;
  const closeModalBtn = document.getElementById('close-modal-btn') as HTMLButtonElement;
  const cancelModalBtn = document.getElementById('cancel-modal-btn') as HTMLButtonElement;
  const addForm = document.getElementById('add-form') as HTMLFormElement;
  const saveAddBtn = document.getElementById('save-add-btn') as HTMLButtonElement;

  const platformSelect = document.getElementById('modal-platform') as HTMLSelectElement;
  const storeSelect = document.getElementById('modal-store') as HTMLSelectElement;
  const hoursInput = document.getElementById('modal-hours') as HTMLInputElement;
  const favoriteCheckbox = document.getElementById('modal-favorite') as HTMLInputElement;

  let debounceTimer: ReturnType<typeof setTimeout>;

  const platformStoresMap: Record<string, { label: string; value: string }[]> = {
    'PC': [
      { label: 'Steam', value: 'Steam' },
      { label: 'Epic Games', value: 'Epic Games' },
      { label: 'Microsoft Store', value: 'Microsoft Store' },
      { label: 'GOG', value: 'GOG' },
      { label: 'Otro / Físico', value: 'Otro' }
    ],
    'PS5': [
      { label: 'PlayStation Store', value: 'PlayStation Store' },
      { label: 'Físico / Disco', value: 'Otro' }
    ],
    'PS4': [
      { label: 'PlayStation Store', value: 'PlayStation Store' },
      { label: 'Físico / Disco', value: 'Otro' }
    ],
    'Xbox Series X/S': [
      { label: 'Xbox Store', value: 'Xbox Store' },
      { label: 'Microsoft Store', value: 'Microsoft Store' },
      { label: 'Físico / Disco', value: 'Otro' }
    ],
    'Xbox One': [
      { label: 'Xbox Store', value: 'Xbox Store' },
      { label: 'Microsoft Store', value: 'Microsoft Store' },
      { label: 'Físico / Disco', value: 'Otro' }
    ],
    'Nintendo Switch': [
      { label: 'Nintendo eShop', value: 'Nintendo eShop' },
      { label: 'Cartucho / Físico', value: 'Otro' }
    ],
    'Android': [
      { label: 'Google Play', value: 'Google Play' },
      { label: 'APK / Otro', value: 'Otro' }
    ],
    'iOS': [
      { label: 'App Store', value: 'App Store' }
    ]
  };

  function updateStoreOptions(selectedPlatform: string) {
    if (!storeSelect) return;

    const availableStores = platformStoresMap[selectedPlatform] || [
      { label: 'Otro / Físico', value: 'Otro' }
    ];

    storeSelect.innerHTML = availableStores
      .map(store => `<option value="${store.value}">${store.label}</option>`)
      .join('');
  }

  platformSelect?.addEventListener('change', (e) => {
    const selectedPlatform = (e.target as HTMLSelectElement).value;
    updateStoreOptions(selectedPlatform);
  });

  function renderSkeletons() {
    if (!resultsGrid) return;
    resultsGrid.innerHTML = Array(8).fill(0).map(() => `
      <div class="theme-card border rounded-2xl overflow-hidden p-0 animate-pulse flex flex-col justify-between h-[280px]">
        <div class="w-full h-40 bg-slate-500/20"></div>
        <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
          <div class="h-4 bg-slate-500/20 rounded w-3/4"></div>
          <div class="h-8 bg-slate-500/20 rounded-xl w-full mt-2"></div>
        </div>
      </div>
    `).join('');
  }

  async function executeSearch() {
    const query = input.value.trim();
    const genre = genreSelect?.value || '';
    const platform = platformFilterSelect?.value || '';
    const ordering = orderingSelect?.value || '-relevance';

    if (!query && !genre && !platform) {
      resultsGrid.innerHTML = '';
      return;
    }

    renderSkeletons();

    try {
      let endpoint = `/api/search?q=${encodeURIComponent(query)}&ordering=${ordering}`;
      if (genre) endpoint += `&genres=${genre}`;
      if (platform) endpoint += `&platforms=${platform}`;

      const res = await fetch(endpoint);
      const games = await res.json();

      if (!games || games.length === 0) {
        resultsGrid.innerHTML = `<p class="col-span-full text-center theme-text-secondary py-12 theme-card border rounded-2xl border-dashed border-slate-500/20">No se encontraron videojuegos con los filtros seleccionados.</p>`;
        return;
      }

      resultsGrid.innerHTML = '';
      games.forEach((game: any) => {
        const card = document.createElement('div');
        card.className = 'theme-card border rounded-2xl overflow-hidden flex flex-col justify-between hover:border-indigo-500/50 transition-all duration-300 hover:-translate-y-1 shadow-md hover:shadow-xl group';
        card.innerHTML = `
          <div class="relative overflow-hidden h-40 bg-slate-800">
            <img 
              src="${game.background_image || '/placeholder.jpg'}" 
              alt="Portada de ${game.name}" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
            />
          </div>
          <div class="p-4 flex-1 flex flex-col justify-between">
            <h3 class="font-bold theme-text-primary text-sm line-clamp-1 mb-2" title="${game.name}">${game.name}</h3>
            <button 
              onclick="openAddModal(${game.id}, '${game.name.replace(/'/g, "\\'")}', '${game.background_image || ''}')"
              class="w-full mt-3 py-2 px-3 bg-indigo-600/20 hover:bg-indigo-600 border border-indigo-500/30 text-indigo-400 hover:text-white text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-sm active:scale-95"
            >
              + Agregar a Mi Biblioteca
            </button>
          </div>
        `;
        resultsGrid.appendChild(card);
      });
    } catch (err) {
      console.error(err);
      resultsGrid.innerHTML = `<p class="col-span-full text-center text-rose-400 py-8 theme-card border rounded-2xl">Error al realizar la búsqueda. Comprueba tu conexión a internet.</p>`;
    }
  }

  input?.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      executeSearch();
    }, 800);
  });

  genreSelect?.addEventListener('change', executeSearch);
  platformFilterSelect?.addEventListener('change', executeSearch);
  orderingSelect?.addEventListener('change', executeSearch);

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    clearTimeout(debounceTimer);
    executeSearch();
  });

  // BÚSQUEDA DE PERFILES (SUPABASE)
  const searchUsersInput = document.getElementById('search-users-input') as HTMLInputElement;
  const usersResultsGrid = document.getElementById('users-results-grid') as HTMLDivElement;
  let userDebounceTimer: ReturnType<typeof setTimeout>;

  async function executeUsersSearch() {
    if (!usersResultsGrid) return;
    const query = searchUsersInput?.value.trim() || '';

    usersResultsGrid.innerHTML = Array(6).fill(0).map(() => `
      <div class="theme-card border rounded-2xl p-5 animate-pulse space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-slate-500/20 rounded-full"></div>
          <div class="space-y-1.5 flex-1">
            <div class="h-3.5 bg-slate-500/20 rounded w-1/2"></div>
            <div class="h-3 bg-slate-500/20 rounded w-1/3"></div>
          </div>
        </div>
      </div>
    `).join('');

    try {
      let supabaseQuery = supabase
        .from('profiles')
        .select('id, username, display_name, avatar_url, bio')
        .limit(12);

      if (query) {
        supabaseQuery = supabaseQuery.or(`username.ilike.%${query}%,display_name.ilike.%${query}%`);
      }

      const { data: users, error } = await supabaseQuery;

      if (error) throw error;

      if (!users || users.length === 0) {
        usersResultsGrid.innerHTML = `<p class="col-span-full text-center theme-text-secondary py-12 theme-card border rounded-2xl border-dashed border-slate-500/20">No se encontraron usuarios en la comunidad.</p>`;
        return;
      }

      usersResultsGrid.innerHTML = users.map(user => `
        <div class="theme-card border rounded-2xl p-5 flex flex-col justify-between hover:border-indigo-500/40 transition-all shadow-md group">
          <div class="flex items-start gap-3.5 mb-3">
            <div class="w-12 h-12 rounded-full overflow-hidden bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center shrink-0">
              ${user.avatar_url ? `
                <img src="${user.avatar_url}" alt="${user.username}" class="w-full h-full object-cover" />
              ` : `
                <span class="text-indigo-400 font-bold text-lg">${(user.username || 'U')[0].toUpperCase()}</span>
              `}
            </div>
            <div class="overflow-hidden">
              <h3 class="font-bold theme-text-primary text-sm truncate">${user.display_name || user.username}</h3>
              <p class="text-xs theme-text-secondary truncate">@${user.username}</p>
            </div>
          </div>

          <p class="text-xs theme-text-secondary line-clamp-2 mb-4 h-8">${user.bio || 'Sin biografía disponible.'}</p>

          <a 
            href="/user/${user.username}" 
            class="w-full py-2 px-3 theme-button border hover:border-indigo-500/40 text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-1.5 theme-text-primary group-hover:text-indigo-400 cursor-pointer"
          >
            <span>Ver Perfil Público</span>
            <span class="text-indigo-400">→</span>
          </a>
        </div>
      `).join('');

    } catch (err) {
      console.error(err);
      usersResultsGrid.innerHTML = `<p class="col-span-full text-center text-rose-400 py-8 theme-card border rounded-2xl">Error al buscar perfiles.</p>`;
    }
  }

  searchUsersInput?.addEventListener('input', () => {
    clearTimeout(userDebounceTimer);
    userDebounceTimer = setTimeout(() => {
      executeUsersSearch();
    }, 500);
  });

  // MODAL LOGIC
  (window as any).openAddModal = async (rawgId: number, title: string, coverUrl: string) => {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Debes iniciar sesión para guardar juegos.', 'error');
      }
      window.location.href = '/login';
      return;
    }

    const { data: existingGame } = await supabase
      .from('user_library')
      .select('id')
      .eq('user_id', session.user.id)
      .eq('rawg_id', rawgId)
      .maybeSingle();

    const modalTitle = document.getElementById('modal-title') as HTMLHeadingElement;

    (document.getElementById('modal-rawg-id') as HTMLInputElement).value = rawgId.toString();
    (document.getElementById('modal-game-name') as HTMLInputElement).value = title;
    (document.getElementById('modal-cover-url') as HTMLInputElement).value = coverUrl;
    hoursInput.value = '';
    favoriteCheckbox.checked = false;

    if (existingGame) {
      modalTitle.textContent = `⚠️ ${title} (Ya en biblioteca)`;
      saveAddBtn.disabled = true;
      saveAddBtn.classList.add('opacity-50', 'cursor-not-allowed');
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Este juego ya forma parte de tu colección.', 'error');
      }
    } else {
      modalTitle.textContent = `Agregar: ${title}`;
      saveAddBtn.disabled = false;
      saveAddBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    }

    const currentPlatform = platformSelect.value || 'PC';
    updateStoreOptions(currentPlatform);

    modal.classList.remove('hidden');
  };

  function closeModal() {
    modal.classList.add('hidden');
  }

  closeModalBtn?.addEventListener('click', closeModal);
  cancelModalBtn?.addEventListener('click', closeModal);

  addForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;

    const rawgId = parseInt((document.getElementById('modal-rawg-id') as HTMLInputElement).value);
    const title = (document.getElementById('modal-game-name') as HTMLInputElement).value;
    const coverUrl = (document.getElementById('modal-cover-url') as HTMLInputElement).value;
    const platform = platformSelect.value;
    const store = storeSelect.value;
    const status = (document.getElementById('modal-status') as HTMLSelectElement).value;
    const hours = parseFloat(hoursInput.value) || 0;
    const isFavorite = favoriteCheckbox.checked;

    saveAddBtn.disabled = true;
    saveAddBtn.innerHTML = `
      <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span>Guardando...</span>
    `;

    const { error } = await supabase.from('user_library').insert({
      user_id: session.user.id,
      rawg_id: rawgId,
      title: title,
      cover_url: coverUrl,
      platform: platform,
      store: store,
      status: status,
      hours_played: hours,
      is_favorite: isFavorite,
      achievements_progress: 0
    });

    saveAddBtn.disabled = false;
    saveAddBtn.innerHTML = `<span>Guardar</span>`;

    if (error) {
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Error al agregar: ' + error.message, 'error');
      } else {
        alert('Error al agregar: ' + error.message);
      }
    } else {
      closeModal();
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast(`¡${title} se agregó a tu biblioteca!`, 'success');
      } else {
        alert(`¡${title} se agregó a tu biblioteca!`);
      }
    }
  });
</script>
---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import { Search as SearchIcon, Plus, Loader2 } from 'lucide-astro';
---

<Layout title="Buscar Juegos">
  <Navbar />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-8">
    <div class="max-w-xl mx-auto text-center mb-8">
      <h1 class="text-3xl font-bold text-white tracking-tight">Buscar Videojuegos</h1>
      <p class="text-sm text-slate-400 mt-1">Encuentra tus títulos favoritos para agregarlos a tu colección</p>
      
      <!-- Input de búsqueda -->
      <form id="search-form" class="mt-6 relative">
        <SearchIcon class="w-5 h-5 text-slate-500 absolute left-4 top-1/2 -translate-y-1/2" />
        <input
          type="text"
          id="search-input"
          placeholder="Ej: Genshin Impact, Assassin's Creed, Rocket League..."
          class="w-full pl-11 pr-24 py-3 bg-slate-900 border border-slate-800 rounded-2xl text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors text-sm"
        />
        <button
          type="submit"
          class="absolute right-2 top-1/2 -translate-y-1/2 px-4 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-xl transition-colors cursor-pointer"
        >
          Buscar
        </button>
      </form>
    </div>

    <!-- Indicador de Carga -->
    <div id="loading" class="hidden flex justify-center py-12">
      <Loader2 class="w-8 h-8 text-indigo-500 animate-spin" />
    </div>

    <!-- Grid de Resultados -->
    <div id="results-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"></div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('search-form') as HTMLFormElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsGrid = document.getElementById('results-grid') as HTMLDivElement;
  const loading = document.getElementById('loading') as HTMLDivElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const query = input.value.trim();
    if (!query) return;

    loading.classList.remove('hidden');
    resultsGrid.innerHTML = '';

    try {
      // Endpoint proxy de API si RAWG no se expone directo
      const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
      const games = await res.json();
      
      loading.classList.add('hidden');

      if (!games || games.length === 0) {
        resultsGrid.innerHTML = `<p class="col-span-full text-center text-slate-400 py-8">No se encontraron videojuegos.</p>`;
        return;
      }

      games.forEach((game: any) => {
        const card = document.createElement('div');
        card.className = 'bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden flex flex-col justify-between hover:border-slate-700 transition-all';
        card.innerHTML = `
          <img src="${game.background_image || '/placeholder.jpg'}" alt="${game.name}" class="w-full h-40 object-cover" />
          <div class="p-4 flex-1 flex flex-col justify-between">
            <h3 class="font-bold text-white text-sm line-clamp-1 mb-2">${game.name}</h3>
            <button 
              onclick="addGameToLibrary(${game.id}, '${game.name.replace(/'/g, "\\'")}', '${game.background_image}')"
              class="w-full mt-3 py-2 px-3 bg-indigo-600/20 hover:bg-indigo-600 border border-indigo-500/30 text-indigo-300 hover:text-white text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-1.5 cursor-pointer"
            >
              + Agregar a Mi Biblioteca
            </button>
          </div>
        `;
        resultsGrid.appendChild(card);
      });
    } catch (err) {
      loading.classList.add('hidden');
      console.error(err);
    }
  });

  // Función global para guardar en Supabase
  (window as any).addGameToLibrary = async (rawgId: number, title: string, coverUrl: string) => {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      alert('Debes iniciar sesión para guardar juegos.');
      window.location.href = '/login';
      return;
    }

    const platform = prompt('¿En qué plataforma lo juegas? (ej. PC, PS5, Switch, Android):', 'PC') || 'PC';
    const store = prompt('¿En qué tienda lo tienes? (ej. Steam, Epic Games, Play Store, PS Store):', 'Steam') || 'Steam';

    const { error } = await supabase.from('user_library').insert({
      user_id: session.user.id,
      rawg_id: rawgId,
      title: title,
      cover_url: coverUrl,
      platform: platform,
      store: store,
      status: 'backlog',
      hours_played: 0,
      achievements_progress: 0
    });

    if (error) {
      alert('Error al agregar el juego: ' + error.message);
    } else {
      alert(`¡${title} se agregó a tu biblioteca!`);
    }
  };
</script>
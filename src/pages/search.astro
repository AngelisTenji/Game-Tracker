---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import { Search as SearchIcon, Loader2, X } from 'lucide-astro';
---

<Layout title="Buscar Juegos | KazeChronik">
  <Navbar />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-8">
    <div class="max-w-xl mx-auto text-center mb-8">
      <h1 class="text-3xl font-bold theme-text-primary tracking-tight">Buscar Videojuegos</h1>
      <p class="text-sm theme-text-secondary mt-1">Encuentra tus títulos favoritos para agregarlos a tu colección</p>
      
      <form id="search-form" class="mt-6 relative">
        <SearchIcon class="w-5 h-5 theme-text-secondary absolute left-4 top-1/2 -translate-y-1/2" />
        <input
          type="text"
          id="search-input"
          placeholder="Ej: Genshin Impact, Assassin's Creed, Minecraft..."
          class="w-full pl-11 pr-24 py-3 theme-card border theme-text-primary placeholder:theme-text-secondary rounded-2xl text-sm focus:outline-none focus:border-indigo-500 transition-colors shadow-sm"
        />
        <button
          type="submit"
          class="absolute right-2 top-1/2 -translate-y-1/2 px-4 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-xl transition-colors cursor-pointer shadow-md"
        >
          Buscar
        </button>
      </form>
    </div>

    <div id="loading" class="hidden flex justify-center py-12">
      <Loader2 class="w-8 h-8 text-indigo-500 animate-spin" />
    </div>

    <div id="results-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"></div>
  </main>

  <!-- MODAL PARA AGREGAR JUEGO (Con fix responsivo de overflow) -->
  <div id="add-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="theme-card border w-[92vw] max-w-md rounded-2xl p-6 shadow-2xl relative overflow-hidden">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-800">
        <h3 id="modal-title" class="text-lg font-bold theme-text-primary truncate">Agregar a la Biblioteca</h3>
        <button id="close-modal-btn" class="p-1 theme-text-secondary hover:theme-text-primary rounded-lg hover:bg-slate-500/10 transition-colors">
          <X class="w-5 h-5" />
        </button>
      </div>

      <form id="add-form" class="space-y-4">
        <input type="hidden" id="modal-rawg-id" />
        <input type="hidden" id="modal-game-name" />
        <input type="hidden" id="modal-cover-url" />

        <div>
          <label class="block text-xs font-semibold theme-text-secondary uppercase tracking-wider mb-2">Plataforma</label>
          <div class="w-full overflow-x-hidden">
            <select id="modal-platform" class="w-full max-w-full px-3 py-2.5 theme-input border rounded-xl theme-text-primary text-sm focus:outline-none focus:border-indigo-500 truncate cursor-pointer">
              <option value="PC">PC</option>
              <option value="PS5">PlayStation 5</option>
              <option value="PS4">PlayStation 4</option>
              <option value="Xbox Series X/S">Xbox Series X/S</option>
              <option value="Xbox One">Xbox One</option>
              <option value="Nintendo Switch">Nintendo Switch</option>
              <option value="Android">Android</option>
              <option value="iOS">iOS</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold theme-text-secondary uppercase tracking-wider mb-2">Tienda / Distribución</label>
          <div class="w-full overflow-x-hidden">
            <select id="modal-store" class="w-full max-w-full px-3 py-2.5 theme-input border rounded-xl theme-text-primary text-sm focus:outline-none focus:border-indigo-500 truncate cursor-pointer">
              <option value="Steam">Steam</option>
              <option value="Epic Games">Epic Games</option>
              <option value="Microsoft Store">Microsoft Store</option>
              <option value="GOG">GOG</option>
              <option value="PlayStation Store">PlayStation Store</option>
              <option value="Nintendo eShop">Nintendo eShop</option>
              <option value="Xbox Store">Xbox Store</option>
              <option value="Google Play">Google Play</option>
              <option value="App Store">App Store</option>
              <option value="Otro">Otro / Físico</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold theme-text-secondary uppercase tracking-wider mb-2">Estado Inicial</label>
          <div class="w-full overflow-x-hidden">
            <select id="modal-status" class="w-full max-w-full px-3 py-2.5 theme-input border rounded-xl theme-text-primary text-sm focus:outline-none focus:border-indigo-500 truncate cursor-pointer">
              <option value="backlog">Pendiente (Backlog)</option>
              <option value="playing">Jugando</option>
              <option value="completed">Completado</option>
              <option value="on_hold">En Pausa</option>
            </select>
          </div>
        </div>

        <div class="flex gap-3 pt-2">
          <button type="button" id="cancel-modal-btn" class="flex-1 py-2.5 px-4 theme-button border hover:bg-slate-500/10 theme-text-secondary text-sm font-semibold rounded-xl transition-colors">
            Cancelar
          </button>
          <button type="submit" class="flex-1 py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl transition-all shadow-lg shadow-indigo-500/20 cursor-pointer">
            Guardar
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('search-form') as HTMLFormElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsGrid = document.getElementById('results-grid') as HTMLDivElement;
  const loading = document.getElementById('loading') as HTMLDivElement;

  const modal = document.getElementById('add-modal') as HTMLDivElement;
  const closeModalBtn = document.getElementById('close-modal-btn') as HTMLButtonElement;
  const cancelModalBtn = document.getElementById('cancel-modal-btn') as HTMLButtonElement;
  const addForm = document.getElementById('add-form') as HTMLFormElement;

  const platformSelect = document.getElementById('modal-platform') as HTMLSelectElement;
  const storeSelect = document.getElementById('modal-store') as HTMLSelectElement;

  let debounceTimer: ReturnType<typeof setTimeout>;
  let lastSearchQuery = '';

  const platformStoresMap: Record<string, { label: string; value: string }[]> = {
    'PC': [
      { label: 'Steam', value: 'Steam' },
      { label: 'Epic Games', value: 'Epic Games' },
      { label: 'Microsoft Store', value: 'Microsoft Store' },
      { label: 'GOG', value: 'GOG' },
      { label: 'Otro / Físico', value: 'Otro' }
    ],
    'PS5': [
      { label: 'PlayStation Store', value: 'PlayStation Store' },
      { label: 'Físico / Disco', value: 'Otro' }
    ],
    'PS4': [
      { label: 'PlayStation Store', value: 'PlayStation Store' },
      { label: 'Físico / Disco', value: 'Otro' }
    ],
    'Xbox Series X/S': [
      { label: 'Xbox Store', value: 'Xbox Store' },
      { label: 'Microsoft Store', value: 'Microsoft Store' },
      { label: 'Físico / Disco', value: 'Otro' }
    ],
    'Xbox One': [
      { label: 'Xbox Store', value: 'Xbox Store' },
      { label: 'Microsoft Store', value: 'Microsoft Store' },
      { label: 'Físico / Disco', value: 'Otro' }
    ],
    'Nintendo Switch': [
      { label: 'Nintendo eShop', value: 'Nintendo eShop' },
      { label: 'Cartucho / Físico', value: 'Otro' }
    ],
    'Android': [
      { label: 'Google Play', value: 'Google Play' },
      { label: 'APK / Otro', value: 'Otro' }
    ],
    'iOS': [
      { label: 'App Store', value: 'App Store' }
    ]
  };

  function updateStoreOptions(selectedPlatform: string) {
    if (!storeSelect) return;

    const availableStores = platformStoresMap[selectedPlatform] || [
      { label: 'Otro / Físico', value: 'Otro' }
    ];

    storeSelect.innerHTML = availableStores
      .map(store => `<option value="${store.value}">${store.label}</option>`)
      .join('');
  }

  platformSelect?.addEventListener('change', (e) => {
    const selectedPlatform = (e.target as HTMLSelectElement).value;
    updateStoreOptions(selectedPlatform);
  });

  async function executeSearch(query: string) {
    if (!query) {
      resultsGrid.innerHTML = '';
      loading.classList.add('hidden');
      return;
    }

    if (query === lastSearchQuery) return;
    lastSearchQuery = query;

    loading.classList.remove('hidden');
    resultsGrid.innerHTML = '';

    try {
      const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
      const games = await res.json();
      loading.classList.add('hidden');

      if (!games || games.length === 0) {
        resultsGrid.innerHTML = `<p class="col-span-full text-center theme-text-secondary py-8">No se encontraron videojuegos.</p>`;
        return;
      }

      games.forEach((game: any) => {
        const card = document.createElement('div');
        card.className = 'theme-card border rounded-2xl overflow-hidden flex flex-col justify-between hover:border-indigo-500/50 transition-all shadow-md';
        card.innerHTML = `
          <img src="${game.background_image || '/placeholder.jpg'}" alt="Portada de ${game.name}" class="w-full h-40 object-cover" />
          <div class="p-4 flex-1 flex flex-col justify-between">
            <h3 class="font-bold theme-text-primary text-sm line-clamp-1 mb-2">${game.name}</h3>
            <button 
              onclick="openAddModal(${game.id}, '${game.name.replace(/'/g, "\\'")}', '${game.background_image || ''}')"
              class="w-full mt-3 py-2 px-3 bg-indigo-600/20 hover:bg-indigo-600 border border-indigo-500/30 text-indigo-400 hover:text-white text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-1.5 cursor-pointer"
            >
              + Agregar a Mi Biblioteca
            </button>
          </div>
        `;
        resultsGrid.appendChild(card);
      });
    } catch (err) {
      loading.classList.add('hidden');
      console.error(err);
    }
  }

  input?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.trim();
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      executeSearch(query);
    }, 800);
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    clearTimeout(debounceTimer);
    executeSearch(input.value.trim());
  });

  (window as any).openAddModal = async (rawgId: number, title: string, coverUrl: string) => {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Debes iniciar sesión para guardar juegos.', 'error');
      }
      window.location.href = '/login';
      return;
    }

    const { data: existingGame } = await supabase
      .from('user_library')
      .select('id')
      .eq('user_id', session.user.id)
      .eq('rawg_id', rawgId)
      .maybeSingle();

    const submitBtn = addForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    const modalTitle = document.getElementById('modal-title') as HTMLHeadingElement;

    (document.getElementById('modal-rawg-id') as HTMLInputElement).value = rawgId.toString();
    (document.getElementById('modal-game-name') as HTMLInputElement).value = title;
    (document.getElementById('modal-cover-url') as HTMLInputElement).value = coverUrl;

    if (existingGame) {
      modalTitle.textContent = `⚠️ ${title} (Ya en biblioteca)`;
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Este juego ya forma parte de tu colección.', 'error');
      }
    } else {
      modalTitle.textContent = `Agregar: ${title}`;
      submitBtn.disabled = false;
      submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    }

    const currentPlatform = platformSelect.value || 'PC';
    updateStoreOptions(currentPlatform);

    modal.classList.remove('hidden');
  };

  function closeModal() {
    modal.classList.add('hidden');
  }

  closeModalBtn?.addEventListener('click', closeModal);
  cancelModalBtn?.addEventListener('click', closeModal);

  addForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;

    const rawgId = parseInt((document.getElementById('modal-rawg-id') as HTMLInputElement).value);
    const title = (document.getElementById('modal-game-name') as HTMLInputElement).value;
    const coverUrl = (document.getElementById('modal-cover-url') as HTMLInputElement).value;
    const platform = platformSelect.value;
    const store = storeSelect.value;
    const status = (document.getElementById('modal-status') as HTMLSelectElement).value;

    const { error } = await supabase.from('user_library').insert({
      user_id: session.user.id,
      rawg_id: rawgId,
      title: title,
      cover_url: coverUrl,
      platform: platform,
      store: store,
      status: status,
      hours_played: 0,
      achievements_progress: 0
    });

    if (error) {
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Error al agregar: ' + error.message, 'error');
      } else {
        alert('Error al agregar: ' + error.message);
      }
    } else {
      closeModal();
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast(`¡${title} se agregó a tu biblioteca!`, 'success');
      } else {
        alert(`¡${title} se agregó a tu biblioteca!`);
      }
    }
  });
</script>
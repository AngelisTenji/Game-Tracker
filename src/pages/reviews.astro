---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import { BookOpen, Star, Clock, Calendar, MessageSquare, ExternalLink } from 'lucide-astro';
---

<Layout title="Mi Feed de Bitácoras | KazeChronik">
  <Navbar />

  <main class="flex-1 max-w-5xl w-full mx-auto px-4 py-8 theme-text-primary">
    <!-- Encabezado -->
    <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight flex items-center gap-3">
          <BookOpen class="w-8 h-8 text-indigo-400" />
          <span>Mis Bitácoras & Reseñas</span>
        </h1>
        <p class="text-sm theme-text-secondary mt-1">
          Historial de impresiones, críticas y opiniones escritas sobre tus juegos.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span id="reviews-count-badge" class="px-3 py-1 bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 font-bold text-xs rounded-xl">
          0 Reseñas
        </span>
      </div>
    </div>

    <!-- Skeleton de Carga -->
    <div id="reviews-skeleton" class="space-y-4 animate-pulse">
      <div class="h-44 bg-slate-800/40 rounded-2xl w-full border border-slate-800"></div>
      <div class="h-44 bg-slate-800/40 rounded-2xl w-full border border-slate-800"></div>
    </div>

    <!-- Empty State -->
    <div id="reviews-empty" class="hidden theme-card border rounded-2xl p-12 text-center flex flex-col items-center justify-center min-h-[300px]">
      <div class="p-4 theme-button rounded-2xl mb-4 theme-text-secondary">
        <MessageSquare class="w-10 h-10 text-slate-500" />
      </div>
      <h3 class="text-lg font-semibold theme-text-primary">Aún no has escrito reseñas</h3>
      <p class="text-sm theme-text-secondary max-w-sm mt-1 mb-6">
        Ingresa a cualquier juego de tu biblioteca para agregar tu puntuación personal y redactar tu bitácora.
      </p>
      <a href="/dashboard" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm rounded-xl transition-all shadow-lg shadow-indigo-600/20">
        Ir a la Biblioteca
      </a>
    </div>

    <!-- Lista de Reseñas / Bitácora Feed -->
    <div id="reviews-feed" class="space-y-6 hidden">
      <!-- Inyectado dinámicamente -->
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  async function loadUserReviews() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session) {
      window.location.href = '/login';
      return;
    }

    const skeleton = document.getElementById('reviews-skeleton');
    const emptyState = document.getElementById('reviews-empty');
    const feed = document.getElementById('reviews-feed');
    const countBadge = document.getElementById('reviews-count-badge');

    // Consultar juegos con reseña o puntuación redactada
    const { data: reviews, error } = await supabase
      .from('user_library')
      .select('*')
      .eq('user_id', session.user.id)
      .not('review', 'is', null)
      .order('updated_at', { ascending: false });

    if (skeleton) skeleton.classList.add('hidden');

    if (error || !reviews || reviews.length === 0) {
      if (emptyState) emptyState.classList.remove('hidden');
      if (countBadge) countBadge.textContent = '0 Reseñas';
      return;
    }

    if (countBadge) countBadge.textContent = `${reviews.length} ${reviews.length === 1 ? 'Reseña' : 'Reseñas'}`;
    if (feed) feed.classList.remove('hidden');

    if (feed) {
      feed.innerHTML = reviews.map(item => {
        const rating = item.rating ? Number(item.rating).toFixed(1) : null;
        const formattedDate = new Date(item.updated_at || item.created_at).toLocaleDateString('es-ES', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        });

        return `
          <article class="theme-card border rounded-2xl p-6 shadow-md hover:border-indigo-500/40 transition-all flex flex-col md:flex-row gap-6">
            <!-- Portada e Info del Juego -->
            <a href="/game/${item.id}" class="w-full md:w-36 h-48 md:h-auto rounded-xl overflow-hidden bg-slate-800 flex-shrink-0 relative group">
              <img 
                src="${item.cover_url || '/placeholder.jpg'}" 
                alt="${item.title}" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="text-xs font-bold text-white bg-indigo-600/90 px-2.5 py-1 rounded-lg backdrop-blur-md">
                  Editar →
                </span>
              </div>
            </a>

            <!-- Contenido de la Bitácora -->
            <div class="flex-1 flex flex-col justify-between space-y-4">
              <div>
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                  <a href="/game/${item.id}" class="hover:text-indigo-400 transition-colors">
                    <h2 class="text-xl font-bold theme-text-primary tracking-tight">${item.title}</h2>
                  </a>

                  ${rating ? `
                    <div class="flex items-center gap-1.5 px-3 py-1 bg-amber-500/10 border border-amber-500/20 text-amber-400 font-black text-sm rounded-xl">
                      <span>★</span>
                      <span>${rating} / 10</span>
                    </div>
                  ` : ''}
                </div>

                <div class="flex items-center gap-4 text-xs theme-text-secondary mb-3">
                  <span class="flex items-center gap-1">
                    <span class="text-indigo-400 font-semibold">${item.platform || 'PC'}</span>
                  </span>
                  •
                  <span class="flex items-center gap-1">
                    <span>${item.hours_played || 0}h jugadas</span>
                  </span>
                  •
                  <span class="flex items-center gap-1">
                    <span>${formattedDate}</span>
                  </span>
                </div>

                <!-- Texto de Reseña -->
                <p class="text-sm theme-text-primary leading-relaxed whitespace-pre-line bg-slate-900/40 p-4 rounded-xl border border-slate-800/60">
                  "${item.review}"
                </p>

                ${item.notes ? `
                  <div class="mt-3 p-3 bg-indigo-950/20 border border-indigo-500/10 rounded-xl">
                    <p class="text-xs text-indigo-300 font-semibold mb-0.5">📌 Notas Privadas:</p>
                    <p class="text-xs theme-text-secondary italic">${item.notes}</p>
                  </div>
                ` : ''}
              </div>

              <!-- Enlaces directos y etiquetas -->
              <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-slate-800/60">
                <div class="flex flex-wrap gap-1">
                  ${(item.tags || []).map((t: string) => `
                    <span class="text-[10px] font-semibold px-2 py-0.5 bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 rounded-md">
                      #${t}
                    </span>
                  `).join('')}
                </div>

                <a 
                  href="/game/${item.id}" 
                  class="text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition-colors flex items-center gap-1"
                >
                  <span>Ver Bitácora Completa</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </article>
        `;
      }).join('');
    }
  }

  loadUserReviews();
  document.addEventListener('astro:page-load', loadUserReviews);
</script>
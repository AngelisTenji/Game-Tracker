---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import { 
  Gamepad2, 
  BookOpen, 
  WifiOff, 
  Sparkles, 
  CheckSquare, 
  Code2, 
  Database, 
  Zap, 
  Github, 
  Linkedin, 
  Mail, 
  ExternalLink,
  ShieldCheck,
  MapPin,
  GraduationCap
} from 'lucide-astro';
---

<Layout title="KazeChronik | Tu Bitácora Gamer & Cuaderno Personal">
  <Navbar />
  
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-12 space-y-20">
    
    <!-- HERO SECTION -->
    <section class="flex flex-col items-center justify-center text-center space-y-6 pt-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold backdrop-blur-md">
        <Sparkles class="w-3.5 h-3.5" />
        <span>Tu Bitácora Gamer & Cuaderno de Builds</span>
      </div>

      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black theme-text-primary tracking-tight max-w-4xl leading-tight sm:leading-none">
        Lleva el control de tus <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-indigo-400 to-purple-400">juegos, builds y notas</span> sin conexión.
      </h1>

      <p class="text-base sm:text-lg theme-text-secondary max-w-2xl leading-relaxed">
        Organiza tu colección por plataformas y tiendas, gestiona tus guías de crafting con listas interactivas y consulta tus apuntes siempre, con resiliencia PWA offline.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a 
          href="/dashboard" 
          class="px-7 py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm transition-all shadow-xl shadow-indigo-600/25 hover:scale-[1.02] active:scale-[0.98] flex items-center gap-2"
        >
          <Gamepad2 class="w-4 h-4" />
          <span>Explorar mi Biblioteca</span>
        </a>

        <a 
          href="/search" 
          class="px-7 py-3.5 rounded-2xl theme-button border hover:border-indigo-500/40 text-sm font-semibold transition-all hover:scale-[1.02] active:scale-[0.98]"
        >
          Buscar Juegos en RAWG
        </a>
      </div>
    </section>

    <!-- SHOWCASE DE CARACTERÍSTICAS -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="theme-card border p-6 rounded-3xl space-y-3 shadow-md hover:border-indigo-500/40 transition-all">
        <div class="p-3 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 rounded-2xl w-fit">
          <BookOpen class="w-6 h-6" />
        </div>
        <h3 class="text-lg font-bold theme-text-primary">📓 Gamer Notebook</h3>
        <p class="text-xs theme-text-secondary leading-relaxed">
          Crea notas dedicadas por juego para guardar builds, mapas y códigos de puzles. Incluye listas de tareas interactivas con sintaxis <code class="bg-indigo-500/10 text-indigo-400 px-1 py-0.5 rounded text-[10px]">[x]</code> para tachar materiales.
        </p>
      </div>

      <div class="theme-card border p-6 rounded-3xl space-y-3 shadow-md hover:border-indigo-500/40 transition-all">
        <div class="p-3 bg-amber-500/10 border border-amber-500/20 text-amber-400 rounded-2xl w-fit">
          <WifiOff class="w-6 h-6" />
        </div>
        <h3 class="text-lg font-bold theme-text-primary">📴 Resiliencia Offline (PWA)</h3>
        <p class="text-xs theme-text-secondary leading-relaxed">
          Accede a tu biblioteca y consulta tus notas en modo lectura sin importar si pierdes conexión a internet. Los datos se guardan en caché local de forma transparente.
        </p>
      </div>

      <div class="theme-card border p-6 rounded-3xl space-y-3 shadow-md hover:border-indigo-500/40 transition-all">
        <div class="p-3 bg-sky-500/10 border border-sky-500/20 text-sky-400 rounded-2xl w-fit">
          <Zap class="w-6 h-6" />
        </div>
        <h3 class="text-lg font-bold theme-text-primary">🔍 Búsqueda Enriquecida</h3>
        <p class="text-xs theme-text-secondary leading-relaxed">
          Conexión directa con la API pública de RAWG. Encuentra miles de videojuegos filtrando por género, consola y criterio de ordenamiento de forma instantánea.
        </p>
      </div>
    </section>

    <!-- TECH STACK -->
    <section class="theme-card border p-8 rounded-3xl shadow-lg space-y-6">
      <div class="text-center max-w-xl mx-auto space-y-2">
        <h2 class="text-2xl font-black theme-text-primary">Arquitectura & Tech Stack</h2>
        <p class="text-xs theme-text-secondary">Construido con un enfoque modular, veloz y moderno enfocado en la experiencia de usuario.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 text-center">
        <div class="p-4 theme-button border rounded-2xl space-y-1">
          <Code2 class="w-5 h-5 text-sky-400 mx-auto" />
          <p class="text-xs font-bold theme-text-primary">Astro 5</p>
          <p class="text-[10px] theme-text-secondary">Framework de Renderizado</p>
        </div>

        <div class="p-4 theme-button border rounded-2xl space-y-1">
          <Database class="w-5 h-5 text-emerald-400 mx-auto" />
          <p class="text-xs font-bold theme-text-primary">Supabase</p>
          <p class="text-[10px] theme-text-secondary">Auth, RLS & PostgreSQL</p>
        </div>

        <div class="p-4 theme-button border rounded-2xl space-y-1">
          <Zap class="w-5 h-5 text-indigo-400 mx-auto" />
          <p class="text-xs font-bold theme-text-primary">Tailwind CSS</p>
          <p class="text-[10px] theme-text-secondary">Estilos Adaptativos</p>
        </div>

        <div class="p-4 theme-button border rounded-2xl space-y-1">
          <Gamepad2 class="w-5 h-5 text-purple-400 mx-auto" />
          <p class="text-xs font-bold theme-text-primary">RAWG API</p>
          <p class="text-[10px] theme-text-secondary">Catálogo de Juegos</p>
        </div>

        <div class="p-4 theme-button border rounded-2xl space-y-1">
          <ShieldCheck class="w-5 h-5 text-amber-400 mx-auto" />
          <p class="text-xs font-bold theme-text-primary">TypeScript</p>
          <p class="text-[10px] theme-text-secondary">Tipado Seguro</p>
        </div>
      </div>
    </section>

    <!-- SECCIÓN DE CONTACTO Y DESARROLLADOR -->
    <section class="theme-card border p-8 rounded-3xl shadow-xl relative overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
        
        <div class="lg:col-span-2 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Desarrollador Full-Stack</span>
          </div>

          <h2 class="text-3xl font-black theme-text-primary">Creado por Angel González</h2>
          
          <div class="flex flex-wrap items-center gap-4 text-xs theme-text-secondary">
            <span class="flex items-center gap-1.5">
              <GraduationCap class="w-4 h-4 text-indigo-400" />
              Estudiante de Ingeniería de Sistemas (UNERG)
            </span>
            <span class="flex items-center gap-1.5">
              <MapPin class="w-4 h-4 text-rose-400" />
              San Juan de los Morros, Venezuela
            </span>
          </div>

          <p class="text-xs theme-text-secondary leading-relaxed max-w-2xl">
            KazeChronik fue concebido como un ecosistema integral para gamers que buscan registrar su progreso de forma ágil, personalizar notas avanzadas de equipamiento y consultar información incluso sin conectividad a internet.
          </p>
        </div>

        <!-- Enlaces directos de contacto -->
        <div class="flex flex-col gap-3 justify-center">
          <a 
            href="https://github.com/AngelisTenji" 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-4 py-3 theme-button border hover:border-indigo-500/40 rounded-2xl text-xs font-semibold theme-text-primary transition-all flex items-center justify-between group"
          >
            <span class="flex items-center gap-2">
              <Github class="w-4 h-4 text-slate-300" />
              <span>GitHub</span>
            </span>
            <ExternalLink class="w-3.5 h-3.5 text-slate-400 group-hover:text-indigo-400 transition-colors" />
          </a>

          <a 
            href="https://www.linkedin.com/in/angel-80207-gonzalez/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-4 py-3 theme-button border hover:border-indigo-500/40 rounded-2xl text-xs font-semibold theme-text-primary transition-all flex items-center justify-between group"
          >
            <span class="flex items-center gap-2">
              <Linkedin class="w-4 h-4 text-sky-400" />
              <span>LinkedIn</span>
            </span>
            <ExternalLink class="w-3.5 h-3.5 text-slate-400 group-hover:text-sky-400 transition-colors" />
          </a>

          <a 
            href="mailto:angelisgr168@gmail.com" 
            class="px-4 py-3 theme-button border hover:border-indigo-500/40 rounded-2xl text-xs font-semibold theme-text-primary transition-all flex items-center justify-between group"
          >
            <span class="flex items-center gap-2">
              <Mail class="w-4 h-4 text-emerald-400" />
              <span>Contacto por Correo</span>
            </span>
            <ExternalLink class="w-3.5 h-3.5 text-slate-400 group-hover:text-emerald-400 transition-colors" />
          </a>
        </div>

      </div>
    </section>

  </main>
</Layout>
---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Página no encontrada | KazeChronik">
  <main class="min-h-screen flex flex-col items-center justify-center text-center p-6 bg-slate-950 text-white">
    <h1 class="text-9xl font-extrabold text-indigo-500 tracking-widest">404</h1>
    <div class="bg-indigo-600 px-2 text-sm rounded rotate-12 absolute font-bold">
      Game Over / Ruta No Encontrada
    </div>
    <p class="text-slate-400 mt-5 text-lg">
      La página que estás buscando se ha perdido en el limbo de los videojuegos.
    </p>
    <a href="/" class="mt-8 px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg shadow-lg transition-all duration-200">
      Volver al Inicio
    </a>
  </main>
</Layout>